diff --git a/src/main/java/org/springframework/samples/petclinic/util/Sha256Hex.java b/src/main/java/org/springframework/samples/petclinic/util/Sha256Hex.java
new file mode 100644
index 000000000..44d3589b3
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/util/Sha256Hex.java
@@ -0,0 +1,53 @@
+/*
