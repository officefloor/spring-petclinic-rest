+    /**
+     * Roll a registration date that falls on a weekend forward to the next Monday, so the
+     * effective registration date always lands on a business day. Weekday dates are returned
+     * unchanged.
+     */
+    private static LocalDate toBusinessDay(LocalDate date) {
+        return switch (date.getDayOfWeek()) {
+            case SATURDAY -> date.plusDays(2);
+            case SUNDAY -> date.plusDays(1);
+            default -> date;
+        };
+    }
