+        version tag, so no value produced under version 1 is produced again.
+      type: object
+      properties:
+        memberId:
+          title: Member ID
+          description: >-
+            Unified member identifier formatted '<REGION><FY><HASH8><CHK>', where REGION is the
+            version-2 region code (the region prefixed with the 'V2' tag), FY is the 2-digit fiscal
+            year of the registration date, HASH8 is the first 8 upper-case hex characters of SHA-256
+            over (normalized telephone + last name), and CHK is a single Luhn check digit over the
+            digits of '<REGION><FY><HASH8>'.
+          type: string
+          readOnly: true
+          example: 'V2NSW26A1B2C3D49'
+        identityKey:
+          title: Identity key
+          description: >-
