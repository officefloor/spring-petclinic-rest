diff --git a/src/main/java/org/springframework/samples/petclinic/model/OwnerIdentityVersion.java b/src/main/java/org/springframework/samples/petclinic/model/OwnerIdentityVersion.java
new file mode 100644
index 000000000..11f1cd940
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/model/OwnerIdentityVersion.java
@@ -0,0 +1,58 @@
+/*
