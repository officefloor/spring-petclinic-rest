@@ -0,0 +1,13 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by the create pipeline when 100 or more owners have already been created today
+ * (by registration date). Handled globally by
+ * {@link DailyOwnerLimitExceededExceptionHandler}, which responds 429.
+ */
+public class DailyOwnerLimitExceededException extends Exception {
+
+    public DailyOwnerLimitExceededException(String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyOwnerLimitExceededExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyOwnerLimitExceededExceptionHandler.java
new file mode 100644
index 000000000..913feb65d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyOwnerLimitExceededExceptionHandler.java
@@ -0,0 +1,16 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class DailyOwnerLimitExceededExceptionHandler {
+
+    public void handle(@Parameter DailyOwnerLimitExceededException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.TOO_MANY_REQUESTS, ex.getMessage());
+        response.send(ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectOverDailyLimit.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectOverDailyLimit.java
