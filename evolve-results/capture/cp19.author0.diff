+/**
+ * Thrown when an owner is created after 100 or more owners have already been
+ * created today (by {@code registrationDate}). Handled by the REST
+ * {@code ExceptionControllerAdvice}, which translates it into a
+ * {@code 429 Too Many Requests} response.
+ */
+public class DailyOwnerLimitExceededException extends RuntimeException {
+
+    public DailyOwnerLimitExceededException(String message) {
+        super(message);
+    }
