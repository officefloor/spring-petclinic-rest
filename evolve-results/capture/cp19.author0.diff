@@ -0,0 +1,20 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@code RequireDailyOwnerLimit} when a create-owner request would exceed the maximum number
+ * of owners allowed to be created in a single day (100), counted by {@code registrationDate}.
+ * {@link DailyOwnerLimitExceededExceptionHandler} reports a 429 (Too Many Requests).
+ */
+public class DailyOwnerLimitExceededException extends Exception {
+
+    private final int limit;
+
+    public DailyOwnerLimitExceededException(int limit) {
+        super("The daily owner creation limit has been reached: " + limit);
+        this.limit = limit;
+    }
+
+    public int getLimit() {
+        return this.limit;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyOwnerLimitExceededExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyOwnerLimitExceededExceptionHandler.java
new file mode 100644
index 000000000..ce891efa0
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyOwnerLimitExceededExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 429 (Too Many Requests) when a create-owner request would exceed the daily owner creation
+ * limit, mirroring {@link CityAtCapacityExceptionHandler}'s {@code errors} array shape.
+ */
+public class DailyOwnerLimitExceededExceptionHandler {
+
+    public void handle(@Parameter DailyOwnerLimitExceededException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS)
+                .body(Map.of("errors", List.of("registrationDate"))));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireDailyOwnerLimit.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireDailyOwnerLimit.java
