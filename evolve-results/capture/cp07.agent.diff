diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DefaultRegistrationDate.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DefaultRegistrationDate.java
new file mode 100644
index 000000000..ffc2299c8
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DefaultRegistrationDate.java
@@ -0,0 +1,19 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+
+import java.time.LocalDate;
+
+/**
+ * Defaults a new owner's registration date to the current server date when none was
+ * supplied on the request.
+ */
+public class DefaultRegistrationDate {
+
+    public void service(@Val Owner owner) {
+        if (owner.getRegistrationDate() == null) {
+            owner.setRegistrationDate(LocalDate.now());
+        }
+    }
+}
