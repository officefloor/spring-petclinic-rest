{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TG3dsvGvwLyE2VY6UyeNCp","type":"tool_result","content":"1\tpackage org.springframework.samples.petclinic.util;\n2\t\n3\timport java.util.Map;\n4\t\n5\t/**\n6\t * Validates an owner's 'postcode' against the owner's city.\n7\t *\n8\t * <p>A postcode is validated ONLY when present; a {@code null} postcode is always accepted,\n9\t * keeping the request contract backward-compatible. When present it is expected to be four\n10\t * digits (enforced by the request schema) and must fall within the inclusive range reserved\n11\t * for the city's region per the fixed table:\n12\t * <ul>\n13\t *   <li>NSW: 2000-2099</li>\n14\t *   <li>VIC: 3000-3099</li>\n15\t *   <li>QLD: 4000-4099</li>\n16\t * </ul>\n17\t * The region is derived from the city via {@link LocalityResolver}. A city with no known\n18\t * region (locality {@code 'UNKNOWN'}) accepts any 4-digit postcode.\n19\t */\n20\tpublic final class PostcodeValidator {\n21\t\n22\t    /** Region -> inclusive 4-digit postcode range {low, high}. Regions not listed accept any postcode. */\n23\t    private static final Map<String, int[]> REGION_POSTCODES = Map.of(\n24\t        \"NSW\", new int[] {2000, 2099},\n25\t        \"VIC\", new int[] {3000, 3099},\n26\t        \"QLD\", new int[] {4000, 4099});\n27\t\n28\t    private PostcodeValidator() {\n29\t    }\n30\t\n31\t    /**\n32\t     * Validate a postcode for a city, throwing when the postcode is out of range for the\n33\t     * city's region.\n34\t     *\n35\t     * @param city     the owner's city (used to derive the region)\n36\t     * @param postcode the supplied postcode, or {@code null} when none was given\n37\t     * @throws InvalidPostcodeException if a 4-digit postcode is present but falls outside the\n38\t     *         inclusive range reserved for the city's region.\n39\t     */\n40\t    public static void validate(String city, String postcode) {\n41\t        if (postcode == null) {\n42\t            return;\n43\t        }\n44\t        int[] range = REGION_POSTCODES.get(LocalityResolver.resolve(city));\n45\t        if (range == null) {\n46\t            return;\n47\t        }\n48\t        int value = Integer.parseInt(postcode);\n49\t        if (value < range[0] || value > range[1]) {\n50\t            throw new InvalidPostcodeException(postcode, city);\n51\t        }\n52\t    }\n53\t}\n54\t"}]},"parent_tool_use_id":null,"session_id":"8f8cd188-148b-48f0-b94e-e8d617b0e56b","uuid":"5e0c869a-b394-488c-b670-1a9c76cc353d","timestamp":"2026-10-01T23:36:45.538Z","tool_use_result":{"type":"text","file":{"filePath":"/home/daniel/sandbox/src/main/java/org/springframework/samples/petclinic/util/PostcodeValidator.java","content":"package org.springframework.samples.petclinic.util;\n\nimport java.util.Map;\n\n/**\n * Validates an owner's 'postcode' against the owner's city.\n *\n * <p>A postcode is validated ONLY when present; a {@code null} postcode is always accepted,\n * keeping the request contract backward-compatible. When present it is expected to be four\n * digits (enforced by the request schema) and must fall within the inclusive range reserved\n * for the city's region per the fixed table:\n * <ul>\n *   <li>NSW: 2000-2099</li>\n *   <li>VIC: 3000-3099</li>\n *   <li>QLD: 4000-4099</li>\n * </ul>\n * The region is derived from the city via {@link LocalityResolver}. A city with no known\n * region (locality {@code 'UNKNOWN'}) accepts any 4-digit postcode.\n */\npublic final class PostcodeValidator {\n\n    /** Region -> inclusive 4-digit postcode range {low, high}. Regions not listed accept any postcode. */\n    private static final Map<String, int[]> REGION_POSTCODES = Map.of(\n        \"NSW\", new int[] {2000, 2099},\n        \"VIC\", new int[] {3000, 3099},\n        \"QLD\", new int[] {4000, 4099});\n\n    private PostcodeValidator() {\n    }\n\n    /**\n     * Validate a postcode for a city, throwing when the postcode is out of range for the\n     * city's region.\n     *\n     * @param city     the owner's city (used to derive the region)\n     * @param postcode the supplied postcode, or {@code null} when none was given\n     * @throws InvalidPostcodeException if a 4-digit postcode is present but falls outside the\n     *         inclusive range reserved for the city's region.\n     */\n    public static void validate(String city, String postcode) {\n        if (postcode == null) {\n            return;\n        }\n        int[] range = REGION_POSTCODES.get(LocalityResolver.resolve(city));\n        if (range == null) {\n            return;\n        }\n        int value = Integer.parseInt(postcode);\n        if (value < range[0] || value > range[1]) {\n            throw new InvalidPostcodeException(postcode, city);\n        }\n    }\n}\n","numLines":54,"startLine":1,"totalLines":54}}}
