 /**
  * Normalizes the owner's postal address in place (trim and collapse whitespace,
- * upper-case, expand common abbreviations) and rejects an address that is blank once
- * normalized. Runs before the household steps so duplicate detection and the shared
- * household id compare the normalized form.
+ * upper-case, expand common abbreviations) and rejects an owner that supplies no
+ * address in either form. Runs before the household steps so duplicate detection and
+ * the shared household id compare the normalized form.
+ *
+ * <p>The structured fields are preferred: when {@code addressLine1} is non-blank it (and
+ * the optional {@code addressLine2}) are normalized and stored, and the flat
+ * {@code address} is set to the composed value — the normalized {@code addressLine1}
+ * with a single space and the normalized {@code addressLine2} appended when the second
+ * line is present. Otherwise the flat {@code address} is normalized and stored on its
+ * own (backward compatible). An owner with neither a non-blank {@code addressLine1} nor
+ * a non-blank flat {@code address} is rejected with 400.
  */
 public class NormalizeOwnerAddress {
 
     public void service(@Val Owner owner) throws InvalidAddressException {
-        String normalized = OwnerAddresses.normalize(owner.getAddress());
-        if (normalized.isBlank()) {
+        String line1 = OwnerAddresses.normalize(owner.getAddressLine1());
+        if (!line1.isBlank()) {
+            String line2 = OwnerAddresses.normalize(owner.getAddressLine2());
+            owner.setAddressLine1(line1);
+            owner.setAddressLine2(line2.isBlank() ? null : line2);
+            owner.setAddress(line2.isBlank() ? line1 : line1 + " " + line2);
+            return;
+        }
+        String flat = OwnerAddresses.normalize(owner.getAddress());
+        if (flat.isBlank()) {
             throw new InvalidAddressException("Address must not be blank");
         }
-        owner.setAddress(normalized);
+        owner.setAddressLine1(null);
+        owner.setAddressLine2(null);
+        owner.setAddress(flat);
     }
 }
