+    /**
+     * Compose the flat address returned to callers from the already-normalized structured
+     * lines: {@code line1}, with a single space and {@code line2} appended when {@code line2}
+     * is non-blank. A blank {@code line2} yields {@code line1} alone.
+     */
+    static String compose(String line1, String line2) {
+        if (line2 == null || line2.isEmpty()) {
