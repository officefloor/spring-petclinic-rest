--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressPresenceValidation.java
@@ -0,0 +1,24 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Class-level constraint asserting that an owner supplies a postal address in EITHER form:
+ * a non-blank structured {@code addressLine1}, or the flat {@code address} (see
+ * {@link AddressPresenceValidator}). It is a class-level constraint because the check spans
+ * the two alternative address inputs.
+ */
+@Target({ ElementType.TYPE })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = AddressPresenceValidator.class)
+@Documented
+public @interface AddressPresenceValidation {
+
+    String message() default "An address must be supplied as either 'addressLine1' or 'address'";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressPresenceValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressPresenceValidator.java
new file mode 100644
index 000000000..822d6396c
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressPresenceValidator.java
@@ -0,0 +1,26 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Validates that an owner supplies a postal address in EITHER form: a non-blank structured
+ * {@code addressLine1}, or the flat {@code address}. This keeps the request contract
+ * backward-compatible (earlier owners carrying only the flat {@code address} stay valid) while
+ * also accepting owners that provide the structured address fields instead.
+ */
+public class AddressPresenceValidator implements ConstraintValidator<AddressPresenceValidation, OwnerFieldsDto> {
+
+    @Override
+    public boolean isValid(OwnerFieldsDto owner, ConstraintValidatorContext context) {
+        if (owner == null) {
+            return true;
+        }
+        return isPresent(owner.getAddressLine1()) || isPresent(owner.getAddress());
+    }
+
+    private boolean isPresent(String value) {
+        return value != null && !value.trim().isEmpty();
+    }
+}
