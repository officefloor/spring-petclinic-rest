@@ -0,0 +1,25 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Class-level constraint asserting that an owner supplies a postal address in at least one of the
+ * two accepted forms: a non-blank structured {@code addressLine1}, or the flat {@code address} kept
+ * for backward compatibility. It is a cross-field check (either source field satisfies it), so it is
+ * applied to the whole owner payload rather than a single field. The actual rule is owned by
+ * {@link org.springframework.samples.petclinic.model.Owner#hasAddress(String, String)}.
+ */
+@Target({ ElementType.TYPE })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = AddressValidator.class)
+@Documented
+public @interface AddressValidation {
+
+    String message() default "An address must be supplied, either as addressLine1 or as address";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressValidator.java
new file mode 100644
index 000000000..dabb5eabd
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressValidator.java
@@ -0,0 +1,32 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Validates that an owner supplies a postal address in at least one accepted form. The check
+ * delegates to {@link Owner#hasAddress(String, String)}, the single source of truth, so an owner
+ * with a non-blank structured {@code addressLine1} or a non-blank flat {@code address} is accepted
+ * while one with neither is rejected. On failure the violation is reported against the
+ * {@code addressLine1} field so the error response names a concrete field.
+ */
+public class AddressValidator implements ConstraintValidator<AddressValidation, OwnerFieldsDto> {
+
+    @Override
+    public boolean isValid(OwnerFieldsDto owner, ConstraintValidatorContext context) {
+        if (owner == null) {
+            return true;
+        }
+        if (Owner.hasAddress(owner.getAddressLine1(), owner.getAddress())) {
+            return true;
+        }
+        context.disableDefaultConstraintViolation();
+        context.buildConstraintViolationWithTemplate(context.getDefaultConstraintMessageTemplate())
+            .addPropertyNode("addressLine1")
+            .addConstraintViolation();
+        return false;
+    }
+}
