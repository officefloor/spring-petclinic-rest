         }
-        String hash8 = HexFormat.of().withUpperCase().formatHex(digest).substring(0, 8);
-        return region + "-" + hash8;
+        return HexFormat.of().withUpperCase().formatHex(digest).substring(0, 8);
+    }
+
+    private static int luhn(String s) {
+        int sum = 0;
+        boolean dbl = true;
+        for (int i = s.length() - 1; i >= 0; i--) {
+            char c = s.charAt(i);
+            if (c < '0' || c > '9') {
