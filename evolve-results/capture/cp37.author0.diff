diff --git a/src/main/java/org/springframework/samples/petclinic/model/Owner.java b/src/main/java/org/springframework/samples/petclinic/model/Owner.java
index 8a5e871ab..1b09f5920 100644
--- a/src/main/java/org/springframework/samples/petclinic/model/Owner.java
+++ b/src/main/java/org/springframework/samples/petclinic/model/Owner.java
@@ -116,6 +116,51 @@ public class Owner extends Person {
         this.telephone = telephone;
     }
 
+    /**
+     * Country code (without the leading {@code '+'}) to its national-number length, used to split the
+     * stored E.164 {@link #getTelephone() telephone} into country code and national digits when
+     * formatting {@link #getTelephoneDisplay()}. Mirrors the country codes recognized at creation
+     * (see the telephone normalizer): {@code +61} has 9 national digits, {@code +1} has 10. Iterated
+     * longest-code-first (hence {@link LinkedHashMap}) so a longer code wins over a shorter one that is
+     * a prefix of the number.
+     */
+    private static final Map<String, Integer> TELEPHONE_NATIONAL_LENGTHS;
+    static {
+        Map<String, Integer> lengths = new LinkedHashMap<>();
+        lengths.put("61", 9); // Australia
+        lengths.put("1", 10); // North American Numbering Plan
+        TELEPHONE_NATIONAL_LENGTHS = lengths;
+    }
+
+    /**
+     * The stored {@link #getTelephone() telephone} formatted for humans: the country code (with its
+     * leading {@code '+'}), a space, then the national digits grouped in threes (e.g.
+     * {@code +61412345678} -> {@code +61 412 345 678}). The raw stored value is returned unchanged when
+     * it is {@code null} or not a recognized E.164 number (a {@code '+'} and a known country code whose
+     * national-number length matches). The raw {@link #getTelephone() telephone} stays in E.164 form.
+     */
+    public String getTelephoneDisplay() {
+        if (this.telephone == null || !this.telephone.startsWith("+")) {
+            return this.telephone;
+        }
+        String digits = this.telephone.substring(1);
+        for (Map.Entry<String, Integer> entry : TELEPHONE_NATIONAL_LENGTHS.entrySet()) {
+            String code = entry.getKey();
+            if (digits.startsWith(code) && digits.length() - code.length() == entry.getValue()) {
+                String national = digits.substring(code.length());
+                StringBuilder grouped = new StringBuilder();
+                for (int i = 0; i < national.length(); i += 3) {
+                    if (grouped.length() > 0) {
+                        grouped.append(' ');
+                    }
+                    grouped.append(national, i, Math.min(i + 3, national.length()));
+                }
+                return "+" + code + " " + grouped;
+            }
+        }
+        return this.telephone;
+    }
+
     public String getEmail() {
         return this.email;
     }
