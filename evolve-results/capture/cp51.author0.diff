@@ -0,0 +1,46 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Derives the owner's {@code membershipLevelCap}: a new owner's {@code membershipLevel} cannot exceed
+ * one above the current maximum {@code membershipLevel} among their household members (the other
+ * owners sharing this owner's {@link Owner#getHouseholdId() householdId}). The cap is one above that
+ * maximum; {@link Owner#getMembershipLevel()} applies it. When the owner has no household id or no
+ * existing household member, no cap applies and the level stands unchanged.
+ *
+ * <p>Soft-deleted owners are ignored, matching {@link CheckOwnerHouseholdUnique}. The cap is a
+ * transient, response-time value set on the in-flight owner; it is not persisted. Wired into the
+ * create pipeline (after {@link AssignOwnerHousehold} has stamped the shared id) and the
+ * single-owner GET pipeline, so reads apply the same ceiling.
+ */
+public class CapOwnerMembershipLevel {
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        String householdId = owner.getHouseholdId();
+        if (householdId == null) {
+            return;
+        }
+        Integer maxMemberLevel = null;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (existing.getId() != null && existing.getId().equals(owner.getId())) {
+                continue; // the owner itself is not one of its household members
+            }
+            if (existing.isDeleted()) {
+                continue; // soft-deleted owners are not counted
+            }
+            if (!householdId.equals(existing.getHouseholdId())) {
+                continue;
+            }
+            int level = existing.getMembershipLevel();
+            if (maxMemberLevel == null || level > maxMemberLevel) {
+                maxMemberLevel = level;
+            }
+        }
+        if (maxMemberLevel != null) {
+            owner.setMembershipLevelCap(maxMemberLevel + 1);
+        }
+    }
+}
