diff --git a/src/main/java/org/springframework/samples/petclinic/model/Person.java b/src/main/java/org/springframework/samples/petclinic/model/Person.java
index 3f1aba5d8..307bc0e1f 100644
--- a/src/main/java/org/springframework/samples/petclinic/model/Person.java
+++ b/src/main/java/org/springframework/samples/petclinic/model/Person.java
@@ -61,4 +61,14 @@ public class Person extends BaseEntity {
         return this.lastName + ", " + this.firstName;
     }
 
+    /**
+     * The person's initials: the upper-cased first letters of {@code firstName} and
+     * {@code lastName}, dot-separated with a trailing dot, e.g. {@code "J.S."}.
+     */
+    @Transient
+    public String getInitials() {
+        return Character.toUpperCase(this.firstName.charAt(0)) + "."
+            + Character.toUpperCase(this.lastName.charAt(0)) + ".";
+    }
+
 }
