index 000000000..8d71972ea
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
@@ -0,0 +1,58 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns a shared {@code householdId} when the request set {@code sharesHousehold} true
+ * (published by {@link BuildOwner}). A household is defined by {@link HouseholdKey} — the same
+ * definition {@link RejectDuplicateHousehold} uses to decide who is a duplicate.
+ *
+ * <p>The identifier is derived deterministically from the household key, so every owner in a
+ * household computes the same value and it is stable across requests. It is assigned to this
+ * (new) owner and also back-filled onto the existing same-household owner(s), so all members
+ * return the same {@code householdId}.
+ *
+ * <p>Does nothing when {@code sharesHousehold} is not true, leaving {@code householdId} absent.
+ */
+public class AssignHousehold {
+
+    public void service(@Val Owner owner, @Val Boolean sharesHousehold, OwnerRepository ownerRepository) {
+        if (!Boolean.TRUE.equals(sharesHousehold)) {
+            return;
+        }
+        HouseholdKey household = HouseholdKey.of(owner);
+        String householdId = householdId(household);
+        owner.setHouseholdId(householdId);
+        for (Owner existing : ownerRepository.findAll()) {
+            if (existing.getId() != null && existing.getId().equals(owner.getId())) {
+                continue;
+            }
+            if (household.matches(existing) && !householdId.equals(existing.getHouseholdId())) {
+                existing.setHouseholdId(householdId);
+                ownerRepository.save(existing);
+            }
+        }
+    }
+
+    /** Stable id {@code H-<16 upper-hex>} derived from the household key. */
+    private static String householdId(HouseholdKey household) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256")
+                    .digest(household.canonical().getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < 8; i++) {
+                sb.append(String.format("%02X", digest[i]));
+            }
+            return "H-" + sb;
+        }
+        catch (NoSuchAlgorithmException ex) {
+            throw new IllegalStateException("SHA-256 not available", ex);
+        }
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/HouseholdKey.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/HouseholdKey.java
new file mode 100644
index 000000000..10b4cc9ae
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/HouseholdKey.java
@@ -0,0 +1,71 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * The identity of a household: the same last name and the same address, compared
+ * case-insensitively with runs of whitespace collapsed to a single space (and trimmed), so
+ * e.g. "110  W.  Liberty St." matches "110 w. liberty st.".
+ *
+ * <p>Single-sources the "what is a household" definition shared by
+ * {@link RejectDuplicateHousehold} (who is rejected) and {@link AssignHousehold} (who shares a
+ * {@code householdId}); the two steps must agree on it, so it lives in exactly one place.
+ */
+final class HouseholdKey {
+
+    private final String lastName;
+
+    private final String address;
+
+    private HouseholdKey(String lastName, String address) {
+        this.lastName = lastName;
+        this.address = address;
+    }
+
+    /** The household the given owner belongs to. */
+    static HouseholdKey of(Owner owner) {
+        return new HouseholdKey(normalize(owner.getLastName()), normalize(owner.getAddress()));
+    }
+
+    /** Whether {@code owner} belongs to this household. */
+    boolean matches(Owner owner) {
+        return equals(of(owner));
+    }
+
+    /** Stable canonical form of the key, suitable for deriving a shared identifier. */
+    String canonical() {
+        return lastName + "|" + address;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (!(o instanceof HouseholdKey other)) {
+            return false;
+        }
+        return lastName.equals(other.lastName) && address.equals(other.address);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(lastName, address);
+    }
+
+    @Override
+    public String toString() {
+        return canonical();
+    }
+
+    /** Lower-case, trim, and collapse any run of whitespace to a single space. */
+    private static String normalize(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.trim().replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
+    }
+}
