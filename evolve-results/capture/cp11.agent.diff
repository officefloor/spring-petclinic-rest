diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateKey.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateKey.java
index a93f4eb..375167b 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateKey.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateKey.java
@@ -27,4 +27,22 @@ final class DuplicateKey {
         }
         return collapsed.toLowerCase(Locale.ROOT);
     }
+
+    /**
+     * Normalises a telephone number to digits only, stripping spaces, dashes,
+     * parentheses and any other non-digit characters. This is both how a
+     * telephone is stored and the comparison key for the uniqueness check, so
+     * {@code "(613) 555-0100"} and {@code "6135550100"} are treated as the same
+     * number.
+     *
+     * @return the digits-only value, or {@code null} when {@code value} is
+     *         {@code null} or contains no digits.
+     */
+    static String telephone(String value) {
+        if (value == null) {
+            return null;
+        }
+        String digits = value.replaceAll("\\D", "");
+        return digits.isEmpty() ? null : digits;
+    }
 }
