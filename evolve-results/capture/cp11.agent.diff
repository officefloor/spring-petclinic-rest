diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
new file mode 100644
index 000000000..d28b5992c
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
@@ -0,0 +1,37 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * When a create-owner request sets {@code sharesHousehold} true, the new owner is allowed to share a
+ * household with the existing owner(s) at the same address and last name (see {@link HouseholdKey}).
+ * This step assigns the new owner — and every matching existing owner that does not already carry one
+ * — the same stable {@code householdId}, so the whole household shares one identifier.
+ *
+ * <p>Requests that do not set {@code sharesHousehold} leave the owner without a household id.
+ */
+public class AssignHousehold {
+
+    public void service(@Val OwnerFieldsDto request, @Val Owner owner, OwnerRepository ownerRepository) {
+        if (!Boolean.TRUE.equals(request.getSharesHousehold())) {
+            return;
+        }
+        HouseholdKey household = HouseholdKey.of(owner.getLastName(), owner.getAddress());
+        String householdId = household.householdId();
+        owner.setHouseholdId(householdId);
+
+        // Backfill the existing household members so the whole household shares the identifier.
+        // These are pre-existing side entities, not the request's new owner, so they are saved
+        // directly here rather than through the pipeline's save: step (which persists only the
+        // new owner mutated above).
+        for (Owner existing : ownerRepository.findAll()) {
+            if (household.matches(existing) && !householdId.equals(existing.getHouseholdId())) {
+                existing.setHouseholdId(householdId);
+                ownerRepository.save(existing);
+            }
+        }
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/HouseholdKey.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/HouseholdKey.java
new file mode 100644
index 000000000..4f123c0a0
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/HouseholdKey.java
@@ -0,0 +1,57 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * The single definition of what makes owners share a household: the same last name and the same
+ * address, compared case-insensitively after collapsing runs of whitespace. Shared by
+ * {@link RequireUniqueHousehold} (which rejects an un-flagged duplicate) and {@link AssignHousehold}
+ * (which links a {@code sharesHousehold} owner to the existing members), so both apply the same rule
+ * and cannot drift apart.
+ *
+ * <p>Also owns the deterministic {@code householdId} derived from that key: joining the same household
+ * always yields the same value and it never changes over time.
+ *
+ * <p>Kept out of the function classes themselves because OfficeFloor requires each function class to
+ * expose exactly one public method.
+ */
+final class HouseholdKey {
+
+    private final String lastName;
+
+    private final String address;
+
+    private HouseholdKey(String lastName, String address) {
+        this.lastName = lastName;
+        this.address = address;
+    }
+
+    /** The household key for the given last name and address. */
+    static HouseholdKey of(String lastName, String address) {
+        return new HouseholdKey(normalize(lastName), normalize(address));
+    }
+
+    /** True when the existing owner belongs to this household. */
+    boolean matches(Owner owner) {
+        return this.lastName.equals(normalize(owner.getLastName()))
+                && this.address.equals(normalize(owner.getAddress()));
+    }
+
+    /** A stable, shared identifier derived from the normalized last name and address. */
+    String householdId() {
+        String key = this.lastName + "\u0000" + this.address;
+        return UUID.nameUUIDFromBytes(key.getBytes(StandardCharsets.UTF_8)).toString();
+    }
+
+    /** Lower-cases and collapses runs of whitespace to a single space for case- and
+     *  whitespace-insensitive comparison. */
+    private static String normalize(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.trim().replaceAll("\\s+", " ").toLowerCase();
+    }
+}
