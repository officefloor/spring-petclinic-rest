diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/HouseholdKey.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/HouseholdKey.java
new file mode 100644
index 000000000..94356dc0e
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/HouseholdKey.java
@@ -0,0 +1,51 @@
+/*
