+package org.springframework.samples.petclinic.model;
+
+import java.util.Map;
+
+/**
+ * Normalises raw postal address input: whitespace is trimmed and collapsed, the
+ * result is upper-cased, and common abbreviations are expanded to their full words.
+ */
+public final class AddressNormalizer {
+
+    private static final Map<String, String> ABBREVIATIONS =
+        Map.of("ST", "STREET", "RD", "ROAD", "AVE", "AVENUE");
+
+    private AddressNormalizer() {
+    }
+
+    /**
+     * @param raw the caller-supplied address value
+     * @return the normalized address, or {@code null} if {@code raw} is null
+     */
+    public static String normalize(String raw) {
+        if (raw == null) {
+            return null;
+        }
+        String[] tokens = raw.trim().replaceAll("\\s+", " ").toUpperCase().split(" ");
+        StringBuilder sb = new StringBuilder();
+        for (String token : tokens) {
+            if (sb.length() > 0) {
+                sb.append(' ');
+            }
+            sb.append(ABBREVIATIONS.getOrDefault(token, token));
+        }
+        return sb.toString();
+    }
+}
