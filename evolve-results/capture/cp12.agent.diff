+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner's address is blank once it has been normalized (trimmed, whitespace
+ * collapsed, upper-cased and common abbreviations expanded).
+ * Handled as a 400 Bad Request by {@link ExceptionControllerAdvice}.
+ */
+public class InvalidAddressException extends RuntimeException {
+
+    private final transient Object rejectedValue;
+
+    public InvalidAddressException(Object rejectedValue) {
+        super("must not be blank");
+        this.rejectedValue = rejectedValue;
+    }
+
+    public Object getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
