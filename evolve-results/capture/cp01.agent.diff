+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+/**
+ * Thrown by the create-owner pipeline when the request body fails field validation
+ * (a required field is missing/blank, or a present field breaks its format rule).
+ * Carries the offending field names so {@link InvalidOwnerFieldsExceptionHandler}
+ * can report them. Handled as 400 Bad Request.
+ */
+public class InvalidOwnerFieldsException extends Exception {
+
+    private final List<String> fields;
+
+    public InvalidOwnerFieldsException(List<String> fields) {
+        super("Invalid or missing owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidOwnerFieldsExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidOwnerFieldsExceptionHandler.java
new file mode 100644
index 000000000..ebf4581b8
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidOwnerFieldsExceptionHandler.java
@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 400 Bad Request with a JSON body whose {@code errors} array lists the name
+ * of each invalid or missing field, e.g. {@code {"errors":["city","telephone"]}}.
+ */
+public class InvalidOwnerFieldsExceptionHandler {
+
+    /** Response body carrying the list of offending field names. */
+    public record ValidationErrors(List<String> errors) {
+    }
+
+    public void handle(@Parameter InvalidOwnerFieldsException ex,
+            ObjectResponse<ResponseEntity<ValidationErrors>> response) {
+        response.send(ResponseEntity.badRequest().body(new ValidationErrors(ex.getFields())));
+    }
+}
