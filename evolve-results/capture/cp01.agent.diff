+package org.springframework.samples.petclinic.rest.validation;
+
+import java.util.List;
+
+/**
+ * Raised when a request to create or update an owner omits one or more mandatory fields.
+ * The offending field names are reported so the client can be told exactly what is missing.
+ */
+public class MissingOwnerFieldsException extends RuntimeException {
+
+    private final List<String> fields;
+
+    public MissingOwnerFieldsException(List<String> fields) {
+        super("Missing required owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
