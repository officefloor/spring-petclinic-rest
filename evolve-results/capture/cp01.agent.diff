+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+/**
+ * Thrown when a create-owner request is missing or blank in one or more required fields.
+ * Handled by {@link MissingOwnerFieldsExceptionHandler}, which responds 400 with the
+ * offending field names.
+ */
+public class MissingOwnerFieldsException extends Exception {
+
+    private final List<String> fields;
+
+    public MissingOwnerFieldsException(List<String> fields) {
+        super("Missing or blank required owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    /** Names of the required fields that were missing or blank. */
+    public List<String> getFields() {
+        return fields;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/MissingOwnerFieldsExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/MissingOwnerFieldsExceptionHandler.java
new file mode 100644
index 000000000..8fdc0a2ca
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/MissingOwnerFieldsExceptionHandler.java
@@ -0,0 +1,19 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.ResponseEntity;
+
+public class MissingOwnerFieldsExceptionHandler {
+
+    public void handle(@Parameter MissingOwnerFieldsException ex,
+            ObjectResponse<ResponseEntity<MissingFieldsError>> response) {
+        response.send(ResponseEntity.badRequest().body(new MissingFieldsError(ex.getFields())));
+    }
+
+    /** Response body listing, in {@code errors}, the name of each missing or blank field. */
+    public record MissingFieldsError(List<String> errors) {
+    }
+}
