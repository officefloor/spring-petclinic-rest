+/**
+ * Response body carrying the names of the fields that failed validation, serialised
+ * as {@code {"errors": ["city", ...]}}.
+ */
+public class ValidationErrorsResponse {
+
+    private final List<String> errors;
+
+    public ValidationErrorsResponse(List<String> errors) {
