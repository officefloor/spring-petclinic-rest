--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/MissingOwnerFieldsHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 400 to a {@link MissingOwnerFieldsException} with a JSON body whose
+ * {@code errors} array lists the name of each missing or blank required field.
+ */
+public class MissingOwnerFieldsHandler {
+
+    public void handle(@Parameter MissingOwnerFieldsException ex,
+            ObjectResponse<ResponseEntity<Map<String, List<String>>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                .body(Map.of("errors", ex.getFields())));
+    }
+}
