+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when a request to create or update an owner omits, or leaves blank, one or more
+ * required fields. Carries the names of the offending fields so the exception handler can
+ * report them in the response {@code errors} array.
+ */
+public class InvalidOwnerFieldsException extends RuntimeException {
+
+    private final List<String> fields;
+
+    public InvalidOwnerFieldsException(List<String> fields) {
+        super("Missing or blank owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
