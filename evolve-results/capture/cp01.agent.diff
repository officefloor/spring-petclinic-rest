+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when a create or update request omits or blanks one or more required fields.
+ * Carries the names of the offending fields so the {@link ExceptionControllerAdvice} can
+ * report them in the {@code errors} array of a 400 Bad Request response.
+ */
+public class RequiredFieldsMissingException extends RuntimeException {
+
+    private final List<String> errors;
+
+    public RequiredFieldsMissingException(List<String> errors) {
+        super("Missing or blank required fields: " + errors);
+        this.errors = List.copyOf(errors);
+    }
+
+    public List<String> getErrors() {
+        return this.errors;
+    }
+}
