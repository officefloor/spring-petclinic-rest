+
+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when a request is missing or blank in one or more required fields.
+ * <p>
+ * Carries the names of the offending fields so the exception handler can report them
+ * to the client in the response body's {@code errors} array.
+ */
+public class RequiredFieldsMissingException extends RuntimeException {
+
+    private final List<String> missingFields;
+
+    public RequiredFieldsMissingException(List<String> missingFields) {
+        super("The request is missing or blank in required fields: " + missingFields);
+        this.missingFields = List.copyOf(missingFields);
+    }
+
+    public List<String> getMissingFields() {
+        return this.missingFields;
+    }
+}
