+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when a request to create or update an owner is missing or blank in one or more
+ * required fields. Carries the names of the offending fields so the
+ * {@link ExceptionControllerAdvice} can report them to the client.
+ */
+public class InvalidOwnerFieldsException extends RuntimeException {
+
+    private final transient List<String> fields;
+
+    public InvalidOwnerFieldsException(List<String> fields) {
+        super("Missing or blank owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
