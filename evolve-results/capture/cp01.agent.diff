+package org.springframework.samples.petclinic.rest.error;
+
+import java.util.List;
+
+/**
+ * Thrown when a request omits or leaves blank one or more fields that are required for the
+ * operation. Carries the names of the offending fields so the REST layer can report each of
+ * them back to the client.
+ */
+public class RequiredFieldsMissingException extends RuntimeException {
+
+    private final List<String> missingFields;
+
+    public RequiredFieldsMissingException(List<String> missingFields) {
+        super("Missing or blank required fields: " + missingFields);
+        this.missingFields = List.copyOf(missingFields);
+    }
+
+    public List<String> getMissingFields() {
+        return this.missingFields;
+    }
+}
