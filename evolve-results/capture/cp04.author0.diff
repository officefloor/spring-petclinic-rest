@@ -0,0 +1,13 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+/**
+ * Thrown by {@link NormalizeOwnerEmail} when an owner create request carries an {@code email}
+ * that is present but not a syntactically valid address. Checked so it appears in the
+ * {@code throws} clause and is routed to its escalation handler, which responds 400.
+ */
+public class InvalidEmailException extends Exception {
+
+    public InvalidEmailException(String email) {
+        super("Email must be a syntactically valid address: " + email);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java
new file mode 100644
index 000000000..0dd0f1a8c
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java
@@ -0,0 +1,28 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Create-time email handling for {@code POST /owners}. Email is optional: an absent (null or
+ * blank) value is left untouched and the request proceeds. When a value is supplied it must be
+ * a syntactically valid address — otherwise the request is rejected with 400 via
+ * {@link InvalidEmailException}. A valid value is normalised (trimmed and lower-cased) and
+ * written back onto the body in place (the {@code @Val} object is the same instance
+ * {@link BuildOwner} then maps), so the lower-cased form is what gets stored and returned.
+ *
+ * <p>Runs after {@link NormalizeOwnerTelephone} and before {@link CheckOwnerTelephoneUnique}.
+ */
+public class NormalizeOwnerEmail {
+
+    public void service(@Val OwnerFieldsDto request) throws InvalidEmailException {
+        String email = request.getEmail();
+        if (!OwnerEmail.isPresent(email)) {
+            return;
+        }
+        if (!OwnerEmail.isValid(email)) {
+            throw new InvalidEmailException(email);
+        }
+        request.setEmail(OwnerEmail.normalize(email));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerEmail.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerEmail.java
new file mode 100644
index 000000000..a32527747
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerEmail.java
@@ -0,0 +1,37 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+import java.util.regex.Pattern;
+
+/**
+ * Single source of truth for the owner email rule used by the {@code POST /owners} pipeline:
+ * email is optional, but when supplied it must be a syntactically valid address and is stored
+ * and returned lower-cased. Centralised here (rather than inlined in {@link NormalizeOwnerEmail})
+ * so the notions of "present", "valid" and "normalised" stay defined in one place.
+ */
+final class OwnerEmail {
+
+    /**
+     * A pragmatic syntactic check: a non-empty local part, a single {@code @}, and a domain with
+     * at least one dot and non-empty labels, none containing whitespace or {@code @}.
+     */
+    private static final Pattern VALID = Pattern.compile("^[^@\\s]+@[^@\\s.]+(\\.[^@\\s.]+)+$");
+
+    private OwnerEmail() {
+    }
+
+    /** An email is "present" when it is non-null and not blank. */
+    static boolean isPresent(String email) {
+        return email != null && !email.isBlank();
+    }
+
+    /** Whether the (present) value is a syntactically valid address. */
+    static boolean isValid(String email) {
+        return email != null && VALID.matcher(email.trim()).matches();
+    }
+
+    /** The stored/returned form: trimmed and lower-cased. */
+    static String normalize(String email) {
+        return email.trim().toLowerCase(Locale.ROOT);
+    }
+}
