@@ -0,0 +1,20 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@link org.springframework.samples.petclinic.rest.function.owner.ValidateOwner} when an
+ * owner email is present on the request but is not a syntactically valid address. Handled by
+ * {@link OwnerEmailInvalidExceptionHandler}, which responds 400.
+ */
+public class OwnerEmailInvalidException extends Exception {
+
+    private final String submitted;
+
+    public OwnerEmailInvalidException(String submitted) {
+        super("Email is not a syntactically valid address: " + submitted);
+        this.submitted = submitted;
+    }
+
+    public String getSubmitted() {
+        return this.submitted;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerEmailInvalidExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerEmailInvalidExceptionHandler.java
new file mode 100644
index 000000000..9a4c40458
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerEmailInvalidExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 400 with a JSON body whose {@code errors} array names {@code email} when the submitted
+ * email is present but not a syntactically valid address.
+ */
+public class OwnerEmailInvalidExceptionHandler {
+
+    public void handle(@Parameter OwnerEmailInvalidException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        Map<String, Object> body = Map.of("errors", List.of("email"));
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(body));
+    }
+}
