diff --git a/src/main/java/org/springframework/samples/petclinic/service/MembershipNumberGenerator.java b/src/main/java/org/springframework/samples/petclinic/service/MembershipNumberGenerator.java
new file mode 100644
index 000000000..0f0e43af5
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/service/MembershipNumberGenerator.java
@@ -0,0 +1,40 @@
+/*
