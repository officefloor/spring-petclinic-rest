diff --git a/src/main/java/org/springframework/samples/petclinic/model/Salutation.java b/src/main/java/org/springframework/samples/petclinic/model/Salutation.java
new file mode 100644
index 000000000..17bdf7e9b
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/model/Salutation.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.model;
+
+/**
+ * Derives an owner's salutation from their own fields: the title followed by a single
+ * space and the lastName when a title is present (e.g. 'DR who'), otherwise just the
+ * lastName.
+ */
+public final class Salutation {
+
+    private Salutation() {
+    }
+
+    /** '{title} {lastName}' when the owner has a non-empty title, otherwise just the lastName. */
+    public static String of(Owner owner) {
+        String title = owner.getTitle();
+        String lastName = owner.getLastName();
+        if (title == null || title.isEmpty()) {
+            return lastName;
+        }
+        return title + " " + lastName;
+    }
+}
