+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created whose city already contains the maximum number of owners
+ * (50). A city at capacity cannot take any more owners, so the create is rejected with a
+ * {@code 409 Conflict} response.
+ */
+public class OwnerCityAtCapacityException extends RuntimeException {
+
+    private final transient String city;
+
+    public OwnerCityAtCapacityException(String city) {
+        super("City " + city + " already contains the maximum number of owners");
+        this.city = city;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
