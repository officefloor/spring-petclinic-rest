@@ -0,0 +1,14 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@code CheckOwnerCityCapacity} when a new owner would be created in a city that
+ * already holds 50 or more owners (compared case-insensitively, matching how city membership is
+ * counted elsewhere). Handled globally by {@link CityOwnerLimitExceededExceptionHandler}, which
+ * responds 409 Conflict.
+ */
+public class CityOwnerLimitExceededException extends Exception {
+
+    public CityOwnerLimitExceededException(String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityOwnerLimitExceededExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityOwnerLimitExceededExceptionHandler.java
new file mode 100644
index 000000000..66767ea86
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityOwnerLimitExceededExceptionHandler.java
@@ -0,0 +1,16 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class CityOwnerLimitExceededExceptionHandler {
+
+    public void handle(@Parameter CityOwnerLimitExceededException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.CONFLICT, ex.getMessage());
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckOwnerCityCapacity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckOwnerCityCapacity.java
