diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckDigit.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckDigit.java
new file mode 100644
index 000000000..35d02d65f
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckDigit.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+/** Luhn check digit (0-9) over the digits contained in a value. */
+public final class CheckDigit {
+
+    private CheckDigit() {
+    }
+
+    public static int of(String value) {
+        int sum = 0;
+        boolean dbl = true;
+        for (int i = value.length() - 1; i >= 0; i--) {
+            char c = value.charAt(i);
+            if (c < '0' || c > '9') {
+                continue;
+            }
+            int d = c - '0';
+            if (dbl) {
+                d *= 2;
+                if (d > 9) {
+                    d -= 9;
+                }
+            }
+            sum += d;
+            dbl = !dbl;
+        }
+        return (10 - (sum % 10)) % 10;
+    }
+}
