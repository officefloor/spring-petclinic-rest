diff --git a/src/main/java/org/springframework/samples/petclinic/mapper/CheckDigits.java b/src/main/java/org/springframework/samples/petclinic/mapper/CheckDigits.java
new file mode 100644
index 000000000..7f27a0f50
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/mapper/CheckDigits.java
@@ -0,0 +1,33 @@
+package org.springframework.samples.petclinic.mapper;
+
+/**
+ * Computes a single Luhn check digit (0-9) over the digits contained in a
+ * string, ignoring any non-digit characters.
+ */
+final class CheckDigits {
+
+    private CheckDigits() {
+    }
+
+    /** Luhn check digit (0-9) over the digits contained in {@code s}. */
+    static int luhnOf(String s) {
+        int sum = 0;
+        boolean dbl = true;
+        for (int i = s.length() - 1; i >= 0; i--) {
+            char c = s.charAt(i);
+            if (c < '0' || c > '9') {
+                continue;
+            }
+            int d = c - '0';
+            if (dbl) {
+                d *= 2;
+                if (d > 9) {
+                    d -= 9;
+                }
+            }
+            sum += d;
+            dbl = !dbl;
+        }
+        return (10 - (sum % 10)) % 10;
+    }
+}
