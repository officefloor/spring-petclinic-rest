diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RespondWithOwner.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RespondWithOwner.java
index 58cc07032..e816a1df2 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RespondWithOwner.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RespondWithOwner.java
@@ -14,6 +14,32 @@ public class RespondWithOwner {
         OwnerDto dto = ownerMapper.toOwnerDto(owner);
         dto.setBulkSignupWarning(BulkSignupWarning.isActive(owner, ownerRepository));
         dto.setContactPreference(ContactPreference.of(owner));
+        dto.setCheckDigit(luhn(owner.getCustomerCode()));
         response.send(dto);
     }
+
+    /** Luhn check digit (0-9) over the digits contained in {@code code}; null when absent. */
+    private static Integer luhn(String code) {
+        if (code == null) {
+            return null;
+        }
+        int sum = 0;
+        boolean dbl = true;
+        for (int i = code.length() - 1; i >= 0; i--) {
+            char c = code.charAt(i);
+            if (c < '0' || c > '9') {
+                continue;
+            }
+            int d = c - '0';
+            if (dbl) {
+                d *= 2;
+                if (d > 9) {
+                    d -= 9;
+                }
+            }
+            sum += d;
+            dbl = !dbl;
+        }
+        return (10 - (sum % 10)) % 10;
+    }
 }
