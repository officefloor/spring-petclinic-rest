+package org.springframework.samples.petclinic.model;
+
+/**
+ * The Luhn check-digit algorithm, computed over the decimal digits contained in a string
+ * (any non-digit characters are ignored).
+ */
+final class Luhn {
+
+    private Luhn() {
+    }
+
+    /**
+     * The single Luhn check digit (0-9) over the digits contained in {@code value}.
+     *
+     * @param value the string whose decimal digits are checksummed
+     * @return the Luhn check digit
+     */
+    static int checkDigit(String value) {
+        int sum = 0;
+        boolean doubling = true;
+        for (int i = value.length() - 1; i >= 0; i--) {
+            char c = value.charAt(i);
+            if (c < '0' || c > '9') {
+                continue;
+            }
+            int digit = c - '0';
+            if (doubling) {
+                digit *= 2;
+                if (digit > 9) {
+                    digit -= 9;
+                }
+            }
+            sum += digit;
+            doubling = !doubling;
+        }
+        return (10 - (sum % 10)) % 10;
+    }
+}
