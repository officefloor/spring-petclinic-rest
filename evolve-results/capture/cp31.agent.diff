diff --git a/src/main/java/org/springframework/samples/petclinic/util/Luhn.java b/src/main/java/org/springframework/samples/petclinic/util/Luhn.java
new file mode 100644
index 000000000..1b169f01d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/util/Luhn.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.util;
+
+/**
+ * Computes the Luhn check digit over the digits contained in a string.
+ */
+public final class Luhn {
+
+    private Luhn() {
+    }
+
+    /** The Luhn check digit (0-9) over the digits contained in {@code s}. */
+    public static int checkDigit(String s) {
+        int sum = 0;
+        boolean dbl = true;
+        for (int i = s.length() - 1; i >= 0; i--) {
+            char c = s.charAt(i);
+            if (c < '0' || c > '9') {
+                continue;
+            }
+            int d = c - '0';
+            if (dbl && (d *= 2) > 9) {
+                d -= 9;
+            }
+            sum += d;
+            dbl = !dbl;
+        }
+        return (10 - (sum % 10)) % 10;
+    }
+}
