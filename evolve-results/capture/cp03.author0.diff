+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created whose normalized telephone is already in use by another
+ * owner. Telephone numbers must be unique across owners, so the duplicate is rejected with a
+ * {@code 409 Conflict} response.
+ */
+public class DuplicateOwnerTelephoneException extends RuntimeException {
+
+    private final transient String telephone;
+
+    public DuplicateOwnerTelephoneException(String telephone) {
+        super("An owner with telephone " + telephone + " already exists");
+        this.telephone = telephone;
+    }
+
+    public String getTelephone() {
+        return this.telephone;
+    }
+}
