+    /**
+     * Fills the {@code checkDigit} as a single Luhn check digit (0-9) computed over the digits
+     * contained in the owner's {@code customerCode}. Left null when the customerCode is missing.
+     */
+    @AfterMapping
+    default void addCheckDigit(Owner owner, @MappingTarget OwnerDto ownerDto) {
+        String customerCode = owner.getCustomerCode();
+        if (customerCode == null) {
+            return;
+        }
+        int sum = 0;
+        boolean dbl = true;
+        for (int i = customerCode.length() - 1; i >= 0; i--) {
+            char c = customerCode.charAt(i);
+            if (c < '0' || c > '9') {
+                continue;
+            }
+            int d = c - '0';
+            if (dbl) {
+                d *= 2;
+                if (d > 9) {
+                    d -= 9;
+                }
+            }
+            sum += d;
+            dbl = !dbl;
+        }
+        ownerDto.setCheckDigit((10 - (sum % 10)) % 10);
+    }
