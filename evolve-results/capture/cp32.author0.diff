-        owner.setCustomerCode(String.format("%s-%s-%04d", prefix3(city), prefix3(owner.getLastName()), sequence));
+    public void service(@Val Owner owner) {
+        String region = OwnerLocality.regionFor(owner.getPostcode(), owner.getCity());
+        String regionCode = region != null ? region : "UNKNOWN";
+        owner.setCustomerCode(regionCode + "-" + hash8(normalizedTelephone(owner.getTelephone()) + owner.getLastName()));
+    }
+
+    /** The owner's telephone in canonical E.164 form, or its raw value when it cannot form one. */
+    private static String normalizedTelephone(String telephone) {
+        String e164 = OwnerTelephone.toE164(telephone);
+        return e164 != null ? e164 : (telephone == null ? "" : telephone);
     }
 
