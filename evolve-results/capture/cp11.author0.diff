+    /**
+     * Derives the stable household identifier shared by all owners with the same last name and
+     * address. The value is deterministic (the first 12 upper-case hex characters of the SHA-256
+     * digest of the normalized last name and address), so every owner in the same household is
+     * assigned an identical, non-blank identifier regardless of creation order.
+     *
+     * @param lastName the owner's last name
+     * @param address  the owner's address
+     * @return the stable household identifier
+     */
+    private static String householdIdFor(String lastName, String address) {
+        String key = normalizeForHousehold(lastName) + "\n" + normalizeForHousehold(address);
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256")
+                .digest(key.getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder(digest.length * 2);
+            for (byte b : digest) {
+                sb.append(String.format("%02X", b));
+            }
+            return sb.substring(0, 12);
+        } catch (NoSuchAlgorithmException ex) {
+            throw new IllegalStateException("SHA-256 not available", ex);
+        }
+    }
+
+    /**
+     * Assigns the shared household identifier to the given owner and to every existing owner that
+     * already shares its household (same last name and address), so all members carry the same
+     * stable value. Existing members whose identifier is missing or stale are updated and saved.
+     *
+     * @param owner the owner being created into (or as the seed of) a shared household
+     */
+    private void assignHousehold(Owner owner) {
+        String householdId = householdIdFor(owner.getLastName(), owner.getAddress());
+        owner.setHouseholdId(householdId);
+        String normalizedLastName = normalizeForHousehold(owner.getLastName());
+        String normalizedAddress = normalizeForHousehold(owner.getAddress());
+        for (Owner existing : this.clinicService.findAllOwners()) {
+            if (owner.getId() != null && owner.getId().equals(existing.getId())) {
+                continue;
+            }
+            if (normalizedLastName.equals(normalizeForHousehold(existing.getLastName()))
+                && normalizedAddress.equals(normalizeForHousehold(existing.getAddress()))
+                && !householdId.equals(existing.getHouseholdId())) {
+                existing.setHouseholdId(householdId);
+                this.clinicService.saveOwner(existing);
+            }
+        }
+    }
 }
