diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
new file mode 100644
index 000000000..c159e978a
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
@@ -0,0 +1,58 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * When a create-owner request sets {@code sharesHousehold} true, the new owner is allowed to share a
+ * household with the existing owner(s) at the same address and last name (compared case-insensitively
+ * after collapsing runs of whitespace). This step assigns the new owner — and every matching existing
+ * owner that does not already carry one — the same stable {@code householdId}, so the whole household
+ * shares one identifier.
+ *
+ * <p>The identifier is derived deterministically from the normalized last name and address, so joining
+ * the same household always yields the same value and it never changes over time. Requests that do not
+ * set {@code sharesHousehold} leave the owner without a household id.
+ */
+public class AssignHousehold {
+
+    public void service(@Val OwnerFieldsDto request, @Val Owner owner, OwnerRepository ownerRepository) {
+        if (!Boolean.TRUE.equals(request.getSharesHousehold())) {
+            return;
+        }
+        String lastName = normalize(owner.getLastName());
+        String address = normalize(owner.getAddress());
+        String householdId = householdId(lastName, address);
+        owner.setHouseholdId(householdId);
+
+        // Backfill the existing household members so the whole household shares the identifier.
+        for (Owner existing : ownerRepository.findAll()) {
+            if (lastName.equals(normalize(existing.getLastName()))
+                    && address.equals(normalize(existing.getAddress()))
+                    && !householdId.equals(existing.getHouseholdId())) {
+                existing.setHouseholdId(householdId);
+                ownerRepository.save(existing);
+            }
+        }
+    }
+
+    /** A stable, shared identifier derived from the household's normalized last name and address. */
+    private static String householdId(String lastName, String address) {
+        String key = lastName + "\u0000" + address;
+        return UUID.nameUUIDFromBytes(key.getBytes(StandardCharsets.UTF_8)).toString();
+    }
+
+    /** Lower-cases and collapses runs of whitespace to a single space for case- and
+     *  whitespace-insensitive comparison. */
+    private static String normalize(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.trim().replaceAll("\\s+", " ").toLowerCase();
+    }
+}
