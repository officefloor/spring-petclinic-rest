diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
new file mode 100644
index 000000000..1472b2afc
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignHousehold.java
@@ -0,0 +1,47 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+import java.util.UUID;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Runs after {@link BuildOwner} on {@code POST /api/owners} and assigns the new owner's stable
+ * {@code householdId}.
+ *
+ * <p>When the request opted in via {@code sharesHousehold} true, the new owner joins an existing
+ * household: the first already-persisted owner with the same lastName and address (compared the same
+ * way as {@link CheckOwnerHouseholdUnique} — case-insensitively, with surrounding whitespace stripped
+ * and internal runs collapsed) donates its {@code householdId} so both owners share one identifier.
+ * Otherwise (not sharing, or sharing with no existing household to join) a fresh random identifier is
+ * minted so every owner always has a non-blank {@code householdId}.
+ */
+public class AssignHousehold {
+
+    public void service(@Val Owner owner, @Val OwnerFieldsDto request, OwnerRepository ownerRepository) {
+        if (Boolean.TRUE.equals(request.getSharesHousehold())) {
+            String lastName = normalize(owner.getLastName());
+            String address = normalize(owner.getAddress());
+            for (Owner existing : ownerRepository.findAll()) {
+                if (existing.getHouseholdId() != null
+                        && lastName.equals(normalize(existing.getLastName()))
+                        && address.equals(normalize(existing.getAddress()))) {
+                    owner.setHouseholdId(existing.getHouseholdId());
+                    return;
+                }
+            }
+        }
+        owner.setHouseholdId(UUID.randomUUID().toString());
+    }
+
+    /** Lower-cases and collapses whitespace so comparison ignores case and incidental spacing. */
+    private static String normalize(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.strip().replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
+    }
+}
