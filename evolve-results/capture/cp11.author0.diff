diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignOwnerHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignOwnerHousehold.java
new file mode 100644
index 000000000..17d6de1d9
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignOwnerHousehold.java
@@ -0,0 +1,40 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns a shared {@code householdId} when a create request opts in with
+ * {@code sharesHousehold: true}.
+ *
+ * <p>Runs after {@link BuildOwner} in the {@code POST /api/owners} pipeline. The id is derived
+ * deterministically from the owner's normalized last name and address (see
+ * {@link OwnerHousehold#householdId}), so every owner that joins the same household computes the
+ * same value. The joining owner receives the id, and any existing owner in the same household that
+ * does not yet carry one is backfilled with it — so both ends of a shared household end up with the
+ * same stable identifier. When the request did not opt in, no id is assigned.
+ */
+public class AssignOwnerHousehold {
+
+    public void service(@Val OwnerFieldsDto request, @Val Owner owner,
+            OwnerRepository ownerRepository) {
+        if (!Boolean.TRUE.equals(request.getSharesHousehold())) {
+            return;
+        }
+        String householdId = OwnerHousehold.householdId(owner.getLastName(), owner.getAddress());
+        owner.setHouseholdId(householdId);
+
+        String lastName = OwnerHousehold.normalize(owner.getLastName());
+        String address = OwnerHousehold.normalize(owner.getAddress());
+        for (Owner existing : ownerRepository.findAll()) {
+            if (existing.getHouseholdId() == null
+                    && lastName.equals(OwnerHousehold.normalize(existing.getLastName()))
+                    && address.equals(OwnerHousehold.normalize(existing.getAddress()))) {
+                existing.setHouseholdId(householdId);
+                ownerRepository.save(existing);
+            }
+        }
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerHousehold.java
index 16e3328e6..933fd3de4 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerHousehold.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerHousehold.java
@@ -1,5 +1,8 @@
 package org.springframework.samples.petclinic.rest.function.owner;
 
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
 import java.util.Locale;
 
 /**
@@ -26,4 +29,27 @@ final class OwnerHousehold {
         }
         return value.trim().replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
     }
+
+    /**
+     * Derives the stable household identifier shared by every owner in the same household. Two
+     * owners whose normalized last name and address match produce the same value, so the id can be
+     * computed independently for each joining owner without coordinating through the database. The
+     * value is {@code "HH-"} followed by the first 12 upper-case hex characters of the SHA-256 of
+     * the normalized {@code "<lastName>|<address>"}.
+     */
+    static String householdId(String lastName, String address) {
+        String key = normalize(lastName) + "|" + normalize(address);
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256")
+                    .digest(key.getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < 6; i++) {
+                sb.append(String.format("%02X", digest[i]));
+            }
+            return "HH-" + sb;
+        }
+        catch (NoSuchAlgorithmException ex) {
+            throw new IllegalStateException("SHA-256 not available", ex);
+        }
+    }
 }
