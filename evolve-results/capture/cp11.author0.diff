diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignOwnerHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignOwnerHousehold.java
new file mode 100644
index 000000000..1e9a9c334
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignOwnerHousehold.java
@@ -0,0 +1,65 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+import java.util.UUID;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Assigns the owner's {@code householdId} when the request opts in with
+ * {@code sharesHousehold} true. Owners sharing a household — same lastName and address
+ * compared case-insensitively with collapsed whitespace, matching
+ * {@link EnsureUniqueOwnerHousehold} — receive one stable shared identifier: the first
+ * existing housemate's id is reused, otherwise a fresh one is minted and back-filled onto
+ * every existing housemate so later joiners keep sharing it. Runs after the owner is built
+ * and before it is saved; leaves {@code householdId} null when {@code sharesHousehold} is
+ * not true.
+ */
+public class AssignOwnerHousehold {
+
+    public void service(@Val Owner owner, @Val OwnerFieldsDto request, OwnerRepository ownerRepository) {
+        if (!Boolean.TRUE.equals(request.getSharesHousehold())) {
+            return;
+        }
+        String lastName = normalize(owner.getLastName());
+        String address = normalize(owner.getAddress());
+
+        String householdId = null;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (isSameHousehold(lastName, address, existing) && existing.getHouseholdId() != null) {
+                householdId = existing.getHouseholdId();
+                break;
+            }
+        }
+        if (householdId == null) {
+            householdId = UUID.randomUUID().toString();
+        }
+
+        // Back-fill the shared id onto any existing housemate that lacks it, so the whole
+        // household ends up on one identifier and later joiners reuse it.
+        for (Owner existing : ownerRepository.findAll()) {
+            if (isSameHousehold(lastName, address, existing) && existing.getHouseholdId() == null) {
+                existing.setHouseholdId(householdId);
+                ownerRepository.save(existing);
+            }
+        }
+
+        owner.setHouseholdId(householdId);
+    }
+
+    private static boolean isSameHousehold(String lastName, String address, Owner existing) {
+        return lastName.equals(normalize(existing.getLastName()))
+                && address.equals(normalize(existing.getAddress()));
+    }
+
+    /** Lower-case and collapse whitespace runs to a single space for comparison. */
+    private static String normalize(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.trim().replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
+    }
+}
