+    public static String deduplicate(String code, java.util.Collection<String> taken) {
+        if (!taken.contains(code)) {
+            return code;
+        }
+        for (int n = 2; ; n++) {
+            String candidate = code + "-" + n;
+            if (!taken.contains(candidate)) {
