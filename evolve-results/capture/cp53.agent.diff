+        event.put("customerCode", primaryIdentifier(owner));
+        event.put("membershipLevel", ownerDto.getMembershipLevel());
+        event.put("event", OWNER_CREATED_EVENT);
+        AUDIT.info(AUDIT_MAPPER.writeValueAsString(event));
+    }
