+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Signals that an owner request supplied an email address that is not syntactically
+ * valid.
+ *
+ * <p>Handled as a 400 Bad Request, reporting {@code email} as the offending field.
+ */
+public class InvalidEmailException extends RuntimeException {
+
+    public InvalidEmailException(String rejectedValue) {
+        super("Email must be a syntactically valid address: " + rejectedValue);
+    }
+}
