+
+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner's email is present but is not a syntactically valid address.
+ * Carries the rejected input so it can be logged.
+ */
+public class InvalidEmailException extends RuntimeException {
+
+    /** Name of the offending field, used to build the error response. */
+    public static final String FIELD = "email";
+
+    public InvalidEmailException(String rejectedValue) {
+        super("Email must be a syntactically valid address, but was: " + rejectedValue);
+    }
+}
