  */
 public class ValidateOwner {
 
+    /** Syntactic email check: a non-empty local part, an '@', then a dotted domain. */
+    private static final Pattern EMAIL = Pattern.compile("^[^@\\s]+@[^@\\s.]+(\\.[^@\\s.]+)+$");
+
