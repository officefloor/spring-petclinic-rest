+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Raised when an owner payload supplies an {@code email} that is not a syntactically valid address.
+ * Carries the offending value so the API can report the rejection back to the client.
+ */
+public class InvalidEmailException extends RuntimeException {
+
+    private final String email;
+
+    public InvalidEmailException(String email) {
+        super("Email is not a syntactically valid address: '" + email + "'");
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
