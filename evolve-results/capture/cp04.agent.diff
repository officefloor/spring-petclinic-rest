+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner's submitted email is present but is not a syntactically valid address. The
+ * REST layer reports this as a 400 Bad Request.
+ *
+ * @see EmailNormalizer
+ */
+public class InvalidEmailException extends RuntimeException {
+
+    public InvalidEmailException(String message) {
+        super(message);
+    }
+}
