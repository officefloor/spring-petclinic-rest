 final class TelephoneE164 {
 
@@ -51,6 +55,17 @@ final class TelephoneE164 {
         if (national.length() < 8 || national.length() > 15) {
             return null;
         }
+        // National-number length per country code: '+61' => 9 national digits, '+1' => 10.
+        if (national.startsWith("61")) {
