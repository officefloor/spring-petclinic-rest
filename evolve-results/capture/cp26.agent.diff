+package org.springframework.samples.petclinic.util;
+
+import java.util.Optional;
+
+/**
+ * The E.164 country calling codes this application recognises, each paired with the exact
+ * number of national (subscriber) digits a valid number for that country carries.
+ *
+ * <p>Used to check a normalized number's national-number length against its country code.
+ * A number whose calling code is not listed here has no per-country length rule.
+ */
+enum CountryCallingCode {
+
+    /** Australia: {@code '+61'} followed by 9 national digits. */
+    AUSTRALIA("61", 9),
+
+    /** North American Numbering Plan: {@code '+1'} followed by 10 national digits. */
+    NANP("1", 10);
+
+    private final String code;
+    private final int nationalDigits;
+
+    CountryCallingCode(String code, int nationalDigits) {
+        this.code = code;
+        this.nationalDigits = nationalDigits;
+    }
+
+    /**
+     * The recognised calling code that prefixes the given digit string, if any. When more than
+     * one would match, the longest (most specific) code wins.
+     *
+     * @param digits the digits of an E.164 number, without the leading {@code '+'}
+     * @return the matching calling code, or {@link Optional#empty()} if none is recognised
+     */
+    static Optional<CountryCallingCode> forDigits(String digits) {
+        CountryCallingCode match = null;
+        for (CountryCallingCode candidate : values()) {
+            if (digits.startsWith(candidate.code)
+                    && (match == null || candidate.code.length() > match.code.length())) {
+                match = candidate;
+            }
+        }
+        return Optional.ofNullable(match);
+    }
+
+    /**
+     * Whether {@code digits} carries exactly the national-digit count this country requires.
+     *
+     * @param digits the digits of an E.164 number, without the leading {@code '+'}, that this
+     * calling code prefixes
+     */
+    boolean hasValidNationalLength(String digits) {
+        return digits.length() - code.length() == nationalDigits;
+    }
+}
