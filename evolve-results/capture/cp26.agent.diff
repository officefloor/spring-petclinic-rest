+        for (Map.Entry<String, Integer> country : NATIONAL_DIGITS.entrySet()) {
+            String code = country.getKey();
+            if (digits.startsWith(code) && digits.length() - code.length() != country.getValue()) {
+                throw new InvalidTelephoneException();
+            }
+        }
+    }
