-            level++;
+            points += 2;
         }
         if (owner.getNamesakeCount() != null && owner.getNamesakeCount() == 0) {
-            level++;
+            points += 1;
+        }
+        if (owner.getHouseholdMemberCount() != null
+                && owner.getHouseholdMemberCount() >= HOUSEHOLD_SIZE_FOR_POINTS) {
+            points += 2;
+        }
+        if (tenureDays(owner) > TENURE_DAYS_FOR_POINTS) {
+            points += 3;
+        }
+        return points;
+    }
