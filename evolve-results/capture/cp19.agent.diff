@@ -0,0 +1,33 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.escalation.DailyLimitExceededException;
+
+/**
+ * Rejects creating an owner once {@value #MAX_PER_DAY} or more owners have already been created today
+ * (counted by registrationDate equal to the server's current date), so the create endpoint responds
+ * 429 instead of exceeding the daily sign-up cap. Runs after {@link ValidateOwner} (which publishes
+ * the body) and before {@link BuildOwner}, which is where a new owner's registrationDate defaults to
+ * today.
+ */
+public class CheckDailyLimit {
+
+    /** Maximum owners that may be created per day; the next create once reached is rejected. */
+    static final int MAX_PER_DAY = 100;
+
+    public void service(OwnerRepository ownerRepository) throws DailyLimitExceededException {
+        LocalDate today = LocalDate.now();
+        int count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (today.equals(existing.getRegistrationDate())) {
+                count++;
+            }
+        }
+        if (count >= MAX_PER_DAY) {
+            throw new DailyLimitExceededException(count);
+        }
+    }
+}
