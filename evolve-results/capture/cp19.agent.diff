+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner is created after the maximum number of owners allowed for the current day
+ * has already been reached. The REST layer reports this as a 429 Too Many Requests.
+ *
+ * @see DailyRegistrationCapacityValidator
+ */
+public class DailyRegistrationLimitExceededException extends RuntimeException {
+
+    public DailyRegistrationLimitExceededException(long maxOwnersPerDay) {
+        super("The daily limit of " + maxOwnersPerDay + " owner registrations has been reached");
+    }
+}
