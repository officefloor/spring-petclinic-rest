+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner is created on a day that has already reached the maximum allowed number
+ * of owner registrations. Carries the offending date so it can be logged.
+ */
+public class DailyOwnerLimitException extends RuntimeException {
+
+    /** Maximum number of owners that may be registered on a single day. */
+    public static final long MAX_OWNERS_PER_DAY = 100;
+
+    /** Name of the offending field, used to build the error response. */
+    public static final String FIELD = "registrationDate";
+
+    public DailyOwnerLimitException(java.time.LocalDate registrationDate) {
+        super("Day already reached the maximum of " + MAX_OWNERS_PER_DAY + " owner registrations: "
+            + registrationDate);
+    }
+}
