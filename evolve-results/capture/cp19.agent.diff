+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectDailyOwnerLimit.java
@@ -0,0 +1,31 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.escalation.DailyOwnerLimitException;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Step of {@code POST /api/owners} that rejects the request when {@value #MAX_OWNERS_PER_DAY} or
+ * more owners have already been created today, counted by {@link Owner#getRegistrationDate()}, so a
+ * full day is a 429 Too Many Requests rather than an over-quota create. Runs before {@link
+ * BuildOwner} assigns today's {@code registrationDate} to the new owner, so the count reflects only
+ * owners already persisted.
+ */
+public class RejectDailyOwnerLimit {
+
+    /** Maximum number of owners that may be created in a single day. */
+    static final int MAX_OWNERS_PER_DAY = 100;
+
+    public void service(OwnerRepository ownerRepository) throws DailyOwnerLimitException {
+        LocalDate today = LocalDate.now();
+        long count = ownerRepository.findAll().stream()
+                .map(Owner::getRegistrationDate)
+                .filter(today::equals)
+                .count();
+        if (count >= MAX_OWNERS_PER_DAY) {
+            throw new DailyOwnerLimitException((int) count);
+        }
+    }
+}
