+package org.springframework.samples.petclinic.rest.error;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown when an owner is created on a day that has already reached the maximum permitted number of
+ * owner registrations. Carries the day whose quota was exhausted so the REST layer can report what
+ * was rejected.
+ */
+public class DailyOwnerLimitExceededException extends RuntimeException {
+
+    private final LocalDate registrationDate;
+
+    public DailyOwnerLimitExceededException(LocalDate registrationDate) {
+        super("The maximum number of owners has already been created on " + registrationDate);
+        this.registrationDate = registrationDate;
+    }
+
+    public LocalDate getRegistrationDate() {
+        return this.registrationDate;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/DailyOwnerLimitValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/DailyOwnerLimitValidator.java
