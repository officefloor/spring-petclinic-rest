@@ -0,0 +1,12 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when the number of owners already registered today has reached the daily limit.
+ * Handled by {@link DailyLimitExceededExceptionHandler}, which responds 429.
+ */
+public class DailyLimitExceededException extends Exception {
+
+    public DailyLimitExceededException(long registeredToday) {
+        super("Daily owner registration limit reached: " + registeredToday);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyLimitExceededExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyLimitExceededExceptionHandler.java
new file mode 100644
index 000000000..86c53abfb
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyLimitExceededExceptionHandler.java
@@ -0,0 +1,14 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class DailyLimitExceededExceptionHandler {
+
+    public void handle(@Parameter DailyLimitExceededException ex,
+            ObjectResponse<ResponseEntity<Void>> response) {
+        response.send(ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS).build());
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/EnsureDailyLimit.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/EnsureDailyLimit.java
