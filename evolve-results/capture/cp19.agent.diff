@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown when a create-owner request arrives after the maximum number of owners has already
+ * been registered on the current date. Handled by {@link DailyLimitExceededExceptionHandler},
+ * which responds 429 with the date and its limit.
+ */
+public class DailyLimitExceededException extends Exception {
+
+    private final LocalDate date;
+
+    private final int limit;
+
+    public DailyLimitExceededException(LocalDate date, int limit) {
+        super("Daily owner registration limit reached (" + limit + " owners) for " + date);
+        this.date = date;
+        this.limit = limit;
+    }
+
+    public LocalDate getDate() {
+        return this.date;
+    }
+
+    public int getLimit() {
+        return this.limit;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyLimitExceededExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyLimitExceededExceptionHandler.java
new file mode 100644
index 000000000..6eae63001
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DailyLimitExceededExceptionHandler.java
@@ -0,0 +1,19 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class DailyLimitExceededExceptionHandler {
+
+    public void handle(@Parameter DailyLimitExceededException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.TOO_MANY_REQUESTS,
+                "Daily owner registration limit reached; try again tomorrow");
+        detail.setProperty("date", ex.getDate());
+        detail.setProperty("limit", ex.getLimit());
+        response.send(ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/EnsureDailyLimit.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/EnsureDailyLimit.java
