+package org.springframework.samples.petclinic.rest.controller;
+
+import java.time.LocalDate;
+
+/**
+ * Signals that a new owner could not be created because the maximum permitted number of
+ * owners have already been registered on that day (by registration date).
+ *
+ * <p>Handled as a 429 Too Many Requests.
+ */
+public class OwnerDailyRegistrationLimitExceededException extends RuntimeException {
+
+    public OwnerDailyRegistrationLimitExceededException(LocalDate registrationDate, long maxOwners) {
+        super("Daily registration limit of " + maxOwners + " owners reached for: " + registrationDate);
+    }
+}
