+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an attempt is made to create an owner once 100 or more owners have already been
+ * created today (compared by registration date). Handled by {@link ExceptionControllerAdvice} as a
+ * 429 Too Many Requests.
+ */
+public class DailyOwnerLimitExceededException extends RuntimeException {
+
+    public DailyOwnerLimitExceededException(String message) {
+        super(message);
+    }
+}
