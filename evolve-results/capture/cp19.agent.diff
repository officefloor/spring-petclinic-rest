+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Thrown when creating an owner would exceed the maximum number of owners that may be
+ * registered on a single day. Handled as {@code 429 Too Many Requests}.
+ */
+public class DailyRegistrationLimitExceededException extends RuntimeException {
+
+    public DailyRegistrationLimitExceededException(int limit) {
+        super("the maximum number of owners for today has already been reached (limit: " + limit + ")");
+    }
+}
