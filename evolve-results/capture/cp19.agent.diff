+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a new owner cannot be created because 100 or more owners have already been
+ * registered today (by {@code registrationDate}). {@link ExceptionControllerAdvice} reports it
+ * back to the client as a 429 Too Many Requests response.
+ */
+public class DailyRegistrationLimitException extends RuntimeException {
+
+    public DailyRegistrationLimitException(String message) {
+        super(message);
+    }
+
+}
