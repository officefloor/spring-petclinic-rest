+package org.springframework.samples.petclinic.rest.advice;
+
+import java.time.LocalDate;
+
+/**
+ * Raised when an owner submitted to the create endpoint would exceed the maximum number of owners
+ * that may be registered on a single day (100 or more owners already carry today's
+ * {@code registrationDate}). The {@code ExceptionControllerAdvice} renders this as a
+ * 429 Too Many Requests response.
+ */
+public class DailyOwnerRegistrationLimitException extends RuntimeException {
+
+    private final LocalDate date;
+
+    public DailyOwnerRegistrationLimitException(LocalDate date) {
+        super("Daily owner registration limit reached for: " + date);
+        this.date = date;
+    }
+
+    /**
+     * @return the registration date that has already reached its owner-creation limit
+     */
+    public LocalDate getDate() {
+        return this.date;
+    }
+}
