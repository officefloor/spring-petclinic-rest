+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created after 100 or more owners have already been created today
+ * (counted by {@code registrationDate}), i.e. the daily create limit is reached. Handled as a
+ * 429 Too Many Requests by {@link ExceptionControllerAdvice}.
+ */
+public class DailyOwnerLimitException extends RuntimeException {
+
+    private final transient Object rejectedValue;
+
+    public DailyOwnerLimitException(Object registrationDate) {
+        super("the daily limit of 100 owner registrations has been reached");
+        this.rejectedValue = registrationDate;
+    }
+
+    public Object getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
