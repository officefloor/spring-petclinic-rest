+    @Mapping(target = "contactPreference", expression = "java(contactPreference(owner))")
     OwnerDto toOwnerDto(Owner owner);
 
+    /**
+     * Derives the owner's preferred contact channel: {@code 'EMAIL'} when an email is present,
