@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.samples.petclinic.mapper.OwnerMapper;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.dto.OwnerDto;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Replays the owner originally created under a repeated {@code Idempotency-Key}: loads it by the id
+ * carried on the {@code replay} branch and returns it with 200 (not 201), so a repeated create is a
+ * read of the original rather than a new resource.
+ */
+public class RespondWithOwnerReplay {
+
+    public void service(@Parameter Integer ownerId, OwnerRepository ownerRepository,
+            OwnerMapper ownerMapper, ObjectResponse<OwnerDto> response) {
+        Owner owner = ownerRepository.findById(ownerId);
+        response.send(ownerMapper.toOwnerDto(owner));
+    }
+}
