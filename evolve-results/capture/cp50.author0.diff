+package org.springframework.samples.petclinic.rest.escalation;
+
+import org.springframework.samples.petclinic.rest.dto.OwnerDto;
+
+/**
+ * Raised on create when the request's {@code Idempotency-Key} was already seen: the owner
+ * created the first time is replayed rather than a duplicate created. Carries the already
+ * mapped {@link OwnerDto} so {@link IdempotentReplayExceptionHandler} can respond 200 OK
+ * with the original owner without re-reading the entity outside the pipeline's transaction.
+ */
+public class IdempotentReplayException extends Exception {
+
+    private final OwnerDto owner;
+
+    public IdempotentReplayException(OwnerDto owner) {
+        super("Idempotent replay of a previously created owner");
+        this.owner = owner;
+    }
+
+    public OwnerDto getOwner() {
+        return this.owner;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/IdempotentReplayExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/IdempotentReplayExceptionHandler.java
