@@ -0,0 +1,39 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.section.clazz.Flow;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.samples.petclinic.mapper.OwnerMapper;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerDto;
+import org.springframework.web.bind.annotation.RequestHeader;
+
+/**
+ * First step of {@code POST /api/owners}. When the request carries an {@code Idempotency-Key}
+ * that a previous create has already recorded (and that owner still exists), responds with the
+ * originally created owner and 200 OK, short-circuiting the create so no duplicate is made.
+ * Otherwise publishes the key for {@link RecordIdempotency} and takes the {@code proceed} flow
+ * into the normal validate/build/save pipeline.
+ */
+public class CheckIdempotency {
+
+    public void service(
+            @RequestHeader(name = "Idempotency-Key", required = false) String key,
+            IdempotencyStore store, OwnerRepository ownerRepository, OwnerMapper ownerMapper,
+            Out<IdempotencyKey> keyOut, ObjectResponse<OwnerDto> response,
+            @Flow("proceed") ContinueCreate proceed) {
+        Integer existingId = store.find(key);
+        if (existingId != null) {
+            Owner owner = ownerRepository.findById(existingId);
+            if (owner != null) {
+                // Seen key with a live owner: return the original with 200, do not create again.
+                response.send(ownerMapper.toOwnerDto(owner));
+                return;
+            }
+        }
+        // First time (or a stale key): carry the key forward and run the normal create.
+        keyOut.set(new IdempotencyKey(key));
+        proceed.proceed();
+    }
+}
