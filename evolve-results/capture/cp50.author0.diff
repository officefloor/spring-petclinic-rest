@@ -0,0 +1,52 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.section.clazz.Flow;
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.web.HttpHeaderParameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.samples.petclinic.mapper.OwnerMapper;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.dto.OwnerDto;
+import org.springframework.samples.petclinic.rest.idempotency.IdempotencyStore;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Entry step for {@code POST /api/owners}. When the request carries an
+ * {@code Idempotency-Key} already seen, respond with the originally created owner (200)
+ * instead of creating a duplicate; otherwise remember the key and continue the create
+ * pipeline.
+ */
+public class CheckIdempotencyKey {
+
+	/** Branch taken when the create should proceed normally. */
+	@FunctionalInterface
+	public interface ProceedFlow {
+		void proceed();
+	}
+
+	public void service(@HttpHeaderParameter("Idempotency-Key") String idempotencyKey,
+			IdempotencyStore store, OwnerRepository ownerRepository, OwnerMapper ownerMapper,
+			Out<String> idempotencyKeyOut, ObjectResponse<OwnerDto> response,
+			@Flow("proceed") ProceedFlow proceed) {
+
+		// No key (or blank) => never idempotent; just create.
+		if (idempotencyKey == null || idempotencyKey.isBlank()) {
+			proceed.proceed();
+			return;
+		}
+
+		// Replay the original create when this key has already produced an owner.
+		Integer existingId = store.find(idempotencyKey);
+		if (existingId != null) {
+			Owner existing = ownerRepository.findById(existingId);
+			if (existing != null) {
+				response.send(ownerMapper.toOwnerDto(existing)); // 200 OK, no duplicate
+				return;
+			}
+		}
+
+		// First time this key is seen: remember it for RecordIdempotencyKey, then create.
+		idempotencyKeyOut.set(idempotencyKey);
+		proceed.proceed();
+	}
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RecordIdempotencyKey.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RecordIdempotencyKey.java
