@@ -0,0 +1,12 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+/**
+ * Flow taken by {@link CheckIdempotency} to continue into the normal create pipeline. Calling
+ * {@link #proceed()} runs the create; not calling it short-circuits the pipeline (used when the
+ * idempotency key is a hit and the response has already been sent).
+ */
+@FunctionalInterface
+public interface ContinueCreate {
+
+    void proceed();
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/IdempotencyKey.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/IdempotencyKey.java
