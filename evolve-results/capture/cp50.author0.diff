@@ -0,0 +1,39 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.server.http.ServerHttpConnection;
+import org.springframework.dao.DataAccessException;
+import org.springframework.samples.petclinic.mapper.OwnerMapper;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.escalation.IdempotentReplayException;
+
+/**
+ * First step of the create pipeline. When the request carries an {@code Idempotency-Key}
+ * that was already seen, the owner created the first time is mapped and raised as an
+ * {@link IdempotentReplayException} (replayed 200) instead of continuing on to create a
+ * duplicate. A missing or new key simply falls through to validation.
+ *
+ * <p>The owner is mapped to its DTO here, inside the pipeline's transaction, so the handler
+ * never touches the entity's lazy state once governance has ended.
+ */
+public class CheckIdempotencyKey {
+
+    public void service(ServerHttpConnection connection, IdempotencyStore store,
+            OwnerRepository ownerRepository, OwnerMapper ownerMapper) throws IdempotentReplayException {
+        Integer id = store.find(IdempotencyStore.keyFrom(connection));
+        if (id == null) {
+            return;
+        }
+        Owner owner;
+        try {
+            owner = ownerRepository.findById(id);
+        }
+        catch (DataAccessException ex) {
+            // The recorded owner is gone; treat the key as new and create afresh.
+            return;
+        }
+        if (owner != null) {
+            throw new IdempotentReplayException(ownerMapper.toOwnerDto(owner));
+        }
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/IdempotencyStore.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/IdempotencyStore.java
