--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerFieldsValidationExceptionHandler.java
@@ -0,0 +1,18 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class OwnerFieldsValidationExceptionHandler {
+
+    public void handle(@Parameter OwnerFieldsValidationException ex,
+            ObjectResponse<ResponseEntity<Map<String, List<String>>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                .body(Map.of("errors", ex.getErrors())));
+    }
+}
