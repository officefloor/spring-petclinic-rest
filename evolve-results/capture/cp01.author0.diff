@@ -0,0 +1,46 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+
+import net.officefloor.plugin.variable.Out;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.rest.escalation.OwnerFieldsInvalidException;
+import org.springframework.web.bind.annotation.RequestBody;
+
+/**
+ * First step of {@code POST /api/owners}: rejects a request that is missing or blank in any of
+ * firstName, lastName, address, city or telephone with a 400 whose body lists the offending fields.
+ * On success it republishes the body for later steps (only one step may bind {@code @RequestBody}).
+ */
+public class RequireOwnerFields {
+
+    /** Required fields in reporting order, each paired with its accessor. */
+    private static final Map<String, Function<OwnerFieldsDto, String>> REQUIRED = new LinkedHashMap<>();
+
+    static {
+        REQUIRED.put("firstName", OwnerFieldsDto::getFirstName);
+        REQUIRED.put("lastName", OwnerFieldsDto::getLastName);
+        REQUIRED.put("address", OwnerFieldsDto::getAddress);
+        REQUIRED.put("city", OwnerFieldsDto::getCity);
+        REQUIRED.put("telephone", OwnerFieldsDto::getTelephone);
+    }
+
+    public void service(@RequestBody OwnerFieldsDto request, Out<OwnerFieldsDto> validated)
+            throws OwnerFieldsInvalidException {
+        List<String> missing = new ArrayList<>();
+        REQUIRED.forEach((name, accessor) -> {
+            String value = accessor.apply(request);
+            if (value == null || value.isBlank()) {
+                missing.add(name);
+            }
+        });
+        if (!missing.isEmpty()) {
+            throw new OwnerFieldsInvalidException(missing);
+        }
+        validated.set(request);
+    }
+}
