+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+/**
+ * Thrown by {@link org.springframework.samples.petclinic.rest.function.owner.ValidateOwner}
+ * when a required owner field is missing or blank (null, empty or whitespace-only).
+ *
+ * <p>Carries the names of the offending fields so {@link MissingOwnerFieldsExceptionHandler}
+ * can respond 400 with an {@code errors} array naming each one.
+ */
+public class MissingOwnerFieldsException extends Exception {
+
+    private final List<String> fields;
+
+    public MissingOwnerFieldsException(List<String> fields) {
+        super("Missing or blank owner fields: " + String.join(", ", fields));
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/MissingOwnerFieldsExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/MissingOwnerFieldsExceptionHandler.java
