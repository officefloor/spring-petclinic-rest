+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when an owner payload is missing or blank in one or more required fields that
+ * Bean Validation does not reject on its own (for example a whitespace-only value that
+ * still satisfies a {@code @Size(min = 1)} constraint).
+ *
+ * <p>The offending field names are reported back to the client in the {@code errors}
+ * array of a {@code 400 Bad Request} response.
+ */
+public class InvalidOwnerFieldsException extends RuntimeException {
+
+    private final transient List<String> fields;
+
+    public InvalidOwnerFieldsException(List<String> fields) {
+        super("Missing or blank required owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
