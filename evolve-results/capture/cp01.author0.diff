+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+/**
+ * Thrown when a create-owner request is missing or blank in one or more required fields.
+ * Handled globally by {@link OwnerFieldsValidationExceptionHandler}, which responds 400 with
+ * a JSON body whose {@code errors} array lists the offending field names.
+ */
+public class OwnerFieldsValidationException extends Exception {
+
+    private final List<String> errors;
+
+    public OwnerFieldsValidationException(List<String> errors) {
+        super("Missing or blank fields: " + String.join(", ", errors));
+        this.errors = List.copyOf(errors);
+    }
+
+    public List<String> getErrors() {
+        return this.errors;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerFieldsValidationExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerFieldsValidationExceptionHandler.java
