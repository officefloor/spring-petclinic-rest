+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Raised when an owner payload is missing or blank in one or more required fields that
+ * Bean Validation alone does not reject (e.g. whitespace-only values). Carries the names
+ * of the offending fields so the {@link ExceptionControllerAdvice} can report them in the
+ * {@code errors} array of a 400 response.
+ */
+public class InvalidOwnerFieldsException extends RuntimeException {
+
+    private final List<String> fields;
+
+    public InvalidOwnerFieldsException(List<String> fields) {
+        super("Missing or blank owner fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
