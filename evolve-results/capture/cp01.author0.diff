+    public ResponseEntity<ProblemDetail> handleRequiredFieldsException(RequiredFieldsException e, HttpServletRequest request) {
+        HttpStatus status = HttpStatus.BAD_REQUEST;
+        logger.debug("Required fields missing at {} {}: {}",
+            request.getMethod(),
+            request.getRequestURI(),
