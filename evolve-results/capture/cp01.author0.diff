+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when a request omits or leaves blank one or more required fields that
+ * cannot be caught by the generated Bean Validation constraints alone (e.g. a
+ * whitespace-only value for a field with no format pattern).
+ * <p>
+ * Carries the names of the offending fields so the {@link ExceptionControllerAdvice}
+ * can report them in the {@code errors} array of a 400 response.
+ */
+public class RequiredFieldsMissingException extends RuntimeException {
+
+    private final List<String> fields;
+
+    public RequiredFieldsMissingException(List<String> fields) {
+        super("Missing or blank required fields: " + fields);
+        this.fields = List.copyOf(fields);
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
