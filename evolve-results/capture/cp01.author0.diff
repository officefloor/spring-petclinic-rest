 package org.springframework.samples.petclinic.rest.function.owner;
 
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Function;
+
 import jakarta.validation.Valid;
 import net.officefloor.plugin.variable.Out;
 import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.rest.escalation.MissingOwnerFieldsException;
 import org.springframework.validation.annotation.Validated;
 import org.springframework.web.bind.annotation.RequestBody;
 
 /**
  * Validates before {@link LoadOwner} runs, so an invalid body is a 400 even when the owner does not exist.
+ *
+ * <p>Beyond the schema (pattern/length) checks carried by {@code @Valid}, this explicitly rejects any
+ * required field that is missing or blank (null, empty or whitespace-only) — the fields without a schema
+ * pattern (address, city) would otherwise accept a whitespace-only value. Each offending field name is
+ * reported via {@link MissingOwnerFieldsException}.
  */
 @Validated
 public class ValidateOwner {
 
-    public void service(@Valid @RequestBody OwnerFieldsDto request, Out<OwnerFieldsDto> validated) {
+    /** Required fields, in the order they are reported. */
+    private static final List<FieldAccessor> REQUIRED_FIELDS = List.of(
+            new FieldAccessor("firstName", OwnerFieldsDto::getFirstName),
+            new FieldAccessor("lastName", OwnerFieldsDto::getLastName),
+            new FieldAccessor("address", OwnerFieldsDto::getAddress),
+            new FieldAccessor("city", OwnerFieldsDto::getCity),
+            new FieldAccessor("telephone", OwnerFieldsDto::getTelephone));
+
+    public void service(@Valid @RequestBody OwnerFieldsDto request, Out<OwnerFieldsDto> validated)
+            throws MissingOwnerFieldsException {
+        List<String> missing = new ArrayList<>();
+        for (FieldAccessor field : REQUIRED_FIELDS) {
+            String value = field.getter().apply(request);
+            if (value == null || value.isBlank()) {
+                missing.add(field.name());
+            }
+        }
+        if (!missing.isEmpty()) {
+            throw new MissingOwnerFieldsException(missing);
+        }
         validated.set(request);
     }
+
+    private record FieldAccessor(String name, Function<OwnerFieldsDto, String> getter) {
+    }
 }
