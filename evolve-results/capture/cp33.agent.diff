+package org.springframework.samples.petclinic.rest.advice;
+
+import java.time.LocalDate;
+
+/**
+ * Raised when an owner submitted to the create endpoint carries a {@code registrationDate} that is
+ * later than the server's current date. A registration date may be supplied to backdate a create,
+ * but it may never be in the future; this closes the gap for a well-formed date that lies after
+ * today. The {@code ExceptionControllerAdvice} renders it as a 400 response naming the
+ * {@code registrationDate} field.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    private final LocalDate registrationDate;
+
+    public FutureRegistrationDateException(LocalDate registrationDate) {
+        super("Registration date '" + registrationDate + "' is later than the current server date");
+        this.registrationDate = registrationDate;
+    }
+
+    /**
+     * @return the rejected future registration date
+     */
+    public LocalDate getRegistrationDate() {
+        return this.registrationDate;
+    }
+}
