@@ -0,0 +1,13 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.ResponseEntity;
+
+public class FutureRegistrationDateExceptionHandler {
+
+    public void handle(@Parameter FutureRegistrationDateException ex,
+            ObjectResponse<ResponseEntity<String>> response) {
+        response.send(ResponseEntity.badRequest().body(ex.getMessage()));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateRegistrationDate.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateRegistrationDate.java
