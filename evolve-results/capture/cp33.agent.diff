@@ -0,0 +1,30 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.time.LocalDate;
+
+/**
+ * Raised when a create-owner request supplies a {@code registrationDate} later than the
+ * server date. Registration may be back-dated or omitted (defaulting to today), but it may
+ * not be in the future. Carries the supplied date and the server date so the handler can
+ * report why the request was rejected (400).
+ */
+public class FutureRegistrationDateException extends Exception {
+
+    private final LocalDate supplied;
+
+    private final LocalDate today;
+
+    public FutureRegistrationDateException(LocalDate supplied, LocalDate today) {
+        super("Registration date " + supplied + " is later than the server date " + today);
+        this.supplied = supplied;
+        this.today = today;
+    }
+
+    public LocalDate getSupplied() {
+        return supplied;
+    }
+
+    public LocalDate getToday() {
+        return today;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateHandler.java
new file mode 100644
index 00000000..45a4c8a8
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Turns a {@link FutureRegistrationDateException} into a 400 naming {@code registrationDate}
+ * in the body's {@code errors} array, mirroring the shape of the other owner field responses.
+ */
+public class FutureRegistrationDateHandler {
+
+    public void handle(@Parameter FutureRegistrationDateException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.BAD_REQUEST,
+                "The request contains invalid or missing parameters");
+        detail.setProperty("errors", java.util.List.of("registrationDate"));
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckRegistrationDateNotFuture.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckRegistrationDateNotFuture.java
