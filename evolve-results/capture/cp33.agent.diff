+package org.springframework.samples.petclinic.rest.controller;
+
+import java.time.LocalDate;
+
+/**
+ * Signals that an owner request supplied a {@code registrationDate} later than the
+ * current server date.
+ *
+ * <p>Owners cannot be registered into the future, so the supplied date is rejected as
+ * an invalid request rather than being stored or rolled to a business day.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    public FutureRegistrationDateException(LocalDate registrationDate, LocalDate serverDate) {
+        super("Registration date " + registrationDate + " is later than the server date " + serverDate);
+    }
+}
