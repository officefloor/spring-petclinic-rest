+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown on create when the caller supplies a {@code registrationDate} later than the server date.
+ * The {@link ExceptionControllerAdvice} reports it as a 400 Bad Request response, so an owner can
+ * never be registered with a future date.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    public FutureRegistrationDateException(String message) {
+        super(message);
+    }
+}
