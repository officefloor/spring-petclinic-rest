+package org.springframework.samples.petclinic.rest.controller;
+
+import java.time.LocalDate;
+
+/**
+ * Raised when a create request supplies a {@code registrationDate} that is later than the
+ * server's current date. A registration may be back-dated but never post-dated. Carries the
+ * rejected value so the exception handler can report a 400 Bad Request naming the
+ * {@code registrationDate} field.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    private final LocalDate registrationDate;
+
+    public FutureRegistrationDateException(LocalDate registrationDate) {
+        super("Registration date is later than the server date: " + registrationDate);
+        this.registrationDate = registrationDate;
+    }
+
+    public LocalDate getRegistrationDate() {
+        return this.registrationDate;
+    }
+}
