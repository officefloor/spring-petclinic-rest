@@ -0,0 +1,13 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by the create pipeline when the supplied registration date is later than the
+ * server date (a future registration date). Handled globally by
+ * {@link InvalidRegistrationDateExceptionHandler}, which responds 400.
+ */
+public class InvalidRegistrationDateException extends Exception {
+
+    public InvalidRegistrationDateException(String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidRegistrationDateExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidRegistrationDateExceptionHandler.java
new file mode 100644
index 000000000..d99b9eb68
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidRegistrationDateExceptionHandler.java
@@ -0,0 +1,16 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class InvalidRegistrationDateExceptionHandler {
+
+    public void handle(@Parameter InvalidRegistrationDateException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.BAD_REQUEST, ex.getMessage());
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectFutureRegistrationDate.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectFutureRegistrationDate.java
new file mode 100644
index 000000000..6cf21c8e8
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectFutureRegistrationDate.java
@@ -0,0 +1,27 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.escalation.InvalidRegistrationDateException;
+
+/**
+ * Rejects creating an owner whose registration date is later than the server date. The
+ * effective registration date — supplied in the request or defaulted to the server date
+ * by {@link BuildOwner} — must not be in the future. Runs before
+ * {@link NormalizeOwnerRegistrationDate}, so the check is on the supplied date rather
+ * than a weekend-adjusted one. A future date escalates as a 400 via
+ * {@link InvalidRegistrationDateException}.
+ */
+public class RejectFutureRegistrationDate {
+
+    public void service(@Val Owner owner) throws InvalidRegistrationDateException {
+        LocalDate registrationDate = owner.getRegistrationDate();
+        if (registrationDate != null && registrationDate.isAfter(LocalDate.now())) {
+            throw new InvalidRegistrationDateException(
+                    "Registration date '" + registrationDate
+                            + "' is later than the server date");
+        }
+    }
+}
