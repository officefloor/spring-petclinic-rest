@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown by {@code ValidateOwnerRegistrationDate} when a create-owner request supplies a
+ * registrationDate that is later than the server's current date. A future registration date is
+ * rejected before it is defaulted or adjusted to a business day. Handled by
+ * {@link FutureRegistrationDateExceptionHandler}, which responds 400.
+ */
+public class FutureRegistrationDateException extends Exception {
+
+    private final LocalDate registrationDate;
+
+    public FutureRegistrationDateException(LocalDate registrationDate) {
+        super("Registration date must not be later than the server date: " + registrationDate);
+        this.registrationDate = registrationDate;
+    }
+
+    public LocalDate getRegistrationDate() {
+        return this.registrationDate;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateExceptionHandler.java
new file mode 100644
index 00000000..5d324a02
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateExceptionHandler.java
@@ -0,0 +1,18 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class FutureRegistrationDateExceptionHandler {
+
+    public void handle(@Parameter FutureRegistrationDateException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                .body(Map.of("errors", List.of("registrationDate"))));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateOwnerRegistrationDate.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateOwnerRegistrationDate.java
