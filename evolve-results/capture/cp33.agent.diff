+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner's supplied registration date is later than the server's current date. The
+ * REST layer reports this as a 400 Bad Request.
+ *
+ * @see RegistrationDateValidator
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    public FutureRegistrationDateException(String message) {
+        super(message);
+    }
+}
