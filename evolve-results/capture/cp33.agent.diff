+package org.springframework.samples.petclinic.rest.advice;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown when a request to create an owner supplies a {@code registrationDate} that is later than the
+ * server's current date. A registration may be back-dated but never post-dated, so a future date is a
+ * client error. Carries the offending date so the {@link ExceptionControllerAdvice} can report it to the
+ * client, which answers with a 400 Bad Request.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    private final transient LocalDate date;
+
+    public FutureRegistrationDateException(LocalDate date) {
+        super("Registration date is later than the server date: " + date);
+        this.date = date;
+    }
+
+    public LocalDate getDate() {
+        return this.date;
+    }
+}
