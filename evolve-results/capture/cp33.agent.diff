+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+@Target({ ElementType.FIELD })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = RegistrationDateValidator.class)
+@Documented
+public @interface RegistrationDateValidation {
+
+    String message() default "Registration date cannot be in the future";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/RegistrationDateValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/RegistrationDateValidator.java
new file mode 100644
index 000000000..a942e7e22
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/RegistrationDateValidator.java
@@ -0,0 +1,27 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import java.time.LocalDate;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+
+public class RegistrationDateValidator implements ConstraintValidator<RegistrationDateValidation, LocalDate> {
+
+    @Override
+    public boolean isValid(LocalDate registrationDate, ConstraintValidatorContext context) {
+
+        if (registrationDate == null) {
+            return true;
+        }
+
+        if (registrationDate.isAfter(LocalDate.now())) {
+            context.disableDefaultConstraintViolation();
+            context.buildConstraintViolationWithTemplate(
+                "Registration date cannot be in the future"
+            ).addConstraintViolation();
+            return false;
+        }
+
+        return true;
+    }
+}
