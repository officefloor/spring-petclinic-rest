+package org.springframework.samples.petclinic.rest.advice;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown when an owner is created with a supplied {@code registrationDate} that is later than the
+ * current server date. The exception handler translates it to a 400 Bad Request whose
+ * {@code errors} array names the offending {@code registrationDate} field.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    public FutureRegistrationDateException(LocalDate registrationDate) {
+        super("Registration date must not be later than the current server date: " + registrationDate);
+    }
+}
