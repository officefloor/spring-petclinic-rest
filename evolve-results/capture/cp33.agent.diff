+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a supplied registration date is later than the server's current date. One of the
+ * field-level {@link InvalidOwnerFieldException} rules, handled by {@link ExceptionControllerAdvice}
+ * as a 400 Bad Request.
+ */
+public class InvalidRegistrationDateException extends InvalidOwnerFieldException {
+
+    public InvalidRegistrationDateException(String message) {
+        super(message, "The supplied registration date may not be later than the current date");
+    }
+}
