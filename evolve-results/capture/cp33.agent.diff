@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown when a create-owner request supplies a {@code registrationDate} that is later than the
+ * server's current date. Validated only WHEN PRESENT (an absent registrationDate defaults to the
+ * server date and is accepted). Handled by {@link FutureRegistrationDateExceptionHandler}, which
+ * responds 400 with the offending field.
+ */
+public class FutureRegistrationDateException extends Exception {
+
+    private final LocalDate registrationDate;
+
+    public FutureRegistrationDateException(LocalDate registrationDate) {
+        super("Registration date is later than the server date: " + registrationDate);
+        this.registrationDate = registrationDate;
+    }
+
+    public LocalDate getRegistrationDate() {
+        return this.registrationDate;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateExceptionHandler.java
new file mode 100644
index 00000000..6c2458eb
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/FutureRegistrationDateExceptionHandler.java
@@ -0,0 +1,21 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class FutureRegistrationDateExceptionHandler {
+
+    public void handle(@Parameter FutureRegistrationDateException ex,
+            ObjectResponse<ResponseEntity<Errors>> response) {
+        response.send(
+                ResponseEntity.status(HttpStatus.BAD_REQUEST).body(new Errors(List.of("registrationDate"))));
+    }
+
+    /** Response body: {@code {"errors": ["registrationDate"]}}. */
+    public record Errors(List<String> errors) {
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireCurrentRegistrationDate.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireCurrentRegistrationDate.java
