+package org.springframework.samples.petclinic.rest.controller;
+
+import java.time.LocalDate;
+
+/**
+ * Thrown when creating an owner with a supplied registration date that lies in the future
+ * relative to the server's current date. Handled as {@code 400 Bad Request}.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    public FutureRegistrationDateException(LocalDate registrationDate, LocalDate serverDate) {
+        super("registration date must not be later than the server date (registrationDate: "
+            + registrationDate + ", serverDate: " + serverDate + ")");
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/controller/RegistrationDateValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/controller/RegistrationDateValidator.java
