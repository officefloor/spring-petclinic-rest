+     * @param request {@link HttpServletRequest} object referring to the current request.
+     * @param detail  Human-readable explanation of the rejection.
+     * @param errors  Names of the offending fields, exposed as the {@code errors} property.
+     * @return A {@link ResponseEntity} whose body is an RFC 7807 problem document.
+     */
+    private ResponseEntity<ProblemDetail> problem(Exception e, HttpStatus status, HttpServletRequest request,
+            String detail, List<String> errors) {
+        ProblemDetail problemDetail = this.detailBuild(e, status, request.getRequestURL(), detail);
+        problemDetail.setProperty("errors", errors);
+        return ResponseEntity.status(status)
+            .contentType(MediaType.APPLICATION_PROBLEM_JSON)
+            .body(problemDetail);
+    }
