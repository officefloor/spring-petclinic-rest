+package org.springframework.samples.petclinic.rest.advice;
+
+import java.io.IOException;
+import java.util.Map;
+import java.util.Set;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.filter.OncePerRequestFilter;
+import org.springframework.web.util.ContentCachingResponseWrapper;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import tools.jackson.databind.ObjectMapper;
+
+/**
+ * Guarantees that every rejection (400, 409, 429) leaves the server as an RFC7807
+ * {@code application/problem+json} body carrying {@code type}, {@code title},
+ * {@code status} and {@code detail}.
+ * <p>
+ * Rejections that already carry a problem body (for example the bean-validation 400
+ * produced by {@link ExceptionControllerAdvice}) are passed through untouched; only
+ * status-only rejections returned straight from a controller are given a body here.
+ */
+@Component
+public class ProblemDetailResponseFilter extends OncePerRequestFilter {
+
+    private static final Set<Integer> REJECTIONS = Set.of(
+        HttpStatus.BAD_REQUEST.value(),
+        HttpStatus.CONFLICT.value(),
+        HttpStatus.TOO_MANY_REQUESTS.value());
+
+    private final ObjectMapper objectMapper;
+
+    public ProblemDetailResponseFilter(ObjectMapper objectMapper) {
+        this.objectMapper = objectMapper;
+    }
+
+    @Override
+    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response,
+                                    FilterChain chain) throws ServletException, IOException {
+        ContentCachingResponseWrapper caching = new ContentCachingResponseWrapper(response);
+        chain.doFilter(request, caching);
+        if (REJECTIONS.contains(caching.getStatus()) && caching.getContentSize() == 0) {
+            writeProblem(caching);
+        }
+        caching.copyBodyToResponse();
+    }
+
+    private void writeProblem(ContentCachingResponseWrapper response) throws IOException {
+        HttpStatus status = HttpStatus.valueOf(response.getStatus());
+        byte[] body = objectMapper.writeValueAsBytes(Map.of(
+            "type", "about:blank",
+            "title", status.getReasonPhrase(),
+            "status", status.value(),
+            "detail", status.getReasonPhrase()));
+        response.resetBuffer();
+        response.setStatus(status.value());
+        response.setContentType(MediaType.APPLICATION_PROBLEM_JSON_VALUE);
+        response.getOutputStream().write(body);
+    }
+}
