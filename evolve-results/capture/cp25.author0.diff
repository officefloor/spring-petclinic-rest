+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when a request to create an owner carries an email whose lower-cased form already belongs to
+ * another owner. Carries the offending (lower-cased) email so {@link DuplicateEmailExceptionHandler}
+ * can report it. Checked so it appears in the function's {@code throws} clause and is routed as an
+ * escalation (a 409 Conflict).
+ */
+public class DuplicateEmailException extends Exception {
+
+    private final String email;
+
+    public DuplicateEmailException(String email) {
+        super("An owner with email '" + email + "' already exists");
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateEmailExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateEmailExceptionHandler.java
new file mode 100644
index 000000000..b2bea647f
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateEmailExceptionHandler.java
@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 409 with an RFC-7807 {@link ProblemDetail} (built through the shared {@link ProblemDetails}
+ * helper, like every other handler in this package) when a new owner's lower-cased email is already
+ * used by another owner.
+ */
+public class DuplicateEmailExceptionHandler {
+
+    public void handle(@Parameter DuplicateEmailException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.CONFLICT,
+                "An owner with the given email already exists");
+        detail.setProperty("errors", java.util.List.of("email"));
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckEmailUnique.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckEmailUnique.java
