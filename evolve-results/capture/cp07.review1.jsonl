e block from `OwnerRestControllerV1`.\n\n(A JPA `@PrePersist` callback on `Owner` would also be idiomatic and would fire only on insert, but there is no existing `@PrePersist` precedent in this codebase, whereas the service layer already owns pre-save rules — so the service is the more codebase-natural home here.)"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":737,"cache_read_input_tokens":22380,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":737},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1ec63ac2-1ede-4dc0-900e-7bc0d8621889","uuid":"eca6de05-27fc-4b1a-9446-4fcbc9def318","timestamp":"2026-10-01T07:38:04.521Z","request_id":"req_011Cfb8o3Ny1SyVBBJhecdDA"}
