--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java
@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Class-level constraint asserting that an owner's postcode, when present, is valid for
+ * the region derived from its city (see {@link PostcodeValidator}). It is a class-level
+ * constraint because the check spans two fields (postcode and city).
+ */
+@Target({ ElementType.TYPE })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = PostcodeValidator.class)
+@Documented
+public @interface PostcodeValidation {
+
+    String message() default "Postcode is not valid for the city's region";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java
new file mode 100644
index 000000000..02495b645
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.util.Postcodes;
+
+/**
+ * Validates that an owner's postcode, when present, is valid for the region derived from its
+ * city (see {@link Postcodes}). The 4-digit format is enforced separately by the field's pattern
+ * constraint, so a missing or non-4-digit postcode is accepted here and left for that constraint.
+ */
+public class PostcodeValidator implements ConstraintValidator<PostcodeValidation, OwnerFieldsDto> {
+
+    @Override
+    public boolean isValid(OwnerFieldsDto owner, ConstraintValidatorContext context) {
+        if (owner == null) {
+            return true;
+        }
+        return Postcodes.isValidForCity(owner.getPostcode(), owner.getCity());
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/util/Postcodes.java b/src/main/java/org/springframework/samples/petclinic/util/Postcodes.java
new file mode 100644
index 000000000..12c245605
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/util/Postcodes.java
@@ -0,0 +1,59 @@
+package org.springframework.samples.petclinic.util;
+
+import java.util.Map;
+
+/**
+ * Validates an owner's postcode against the region derived from its city.
+ *
+ * <p>A postcode is a 4-digit string. When present it must fall within the inclusive
+ * range fixed for the region of the owner's city, keyed via a fixed city-to-region
+ * table:
+ * <ul>
+ *     <li>Sydney -&gt; NSW, postcodes 2000-2099;</li>
+ *     <li>Melbourne -&gt; VIC, postcodes 3000-3099;</li>
+ *     <li>Brisbane -&gt; QLD, postcodes 4000-4099.</li>
+ * </ul>
+ *
+ * <p>A city with no known region accepts any 4-digit postcode. The postcode is
+ * optional, so a {@code null} postcode is always accepted; the 4-digit format is
+ * enforced separately by the field's pattern constraint, so a value that is not a
+ * 4-digit number is left for that constraint to reject.
+ */
+public final class Postcodes {
+
+    /**
+     * Known city-to-region mappings, keyed by the exact city name.
+     */
+    private static final Map<String, String> CITY_REGIONS = Map.of(
+        "Sydney", "NSW", "Melbourne", "VIC", "Brisbane", "QLD");
+
+    /**
+     * Region to its inclusive 4-digit postcode range {@code {low, high}}.
+     */
+    private static final Map<String, int[]> REGION_RANGES = Map.of(
+        "NSW", new int[] {2000, 2099},
+        "VIC", new int[] {3000, 3099},
+        "QLD", new int[] {4000, 4099});
+
+    private Postcodes() {
+    }
+
+    /**
+     * Whether the given postcode is acceptable for the given city. Returns {@code true} when the
+     * postcode is {@code null} (optional), when it is not a 4-digit value (deferred to the format
+     * constraint), or when the city has no known region. Otherwise the 4-digit value must lie within
+     * the inclusive range for the city's region.
+     */
+    public static boolean isValidForCity(String postcode, String city) {
+        if (postcode == null || !postcode.matches("[0-9]{4}")) {
+            return true;
+        }
+        String region = CITY_REGIONS.get(city);
+        int[] range = region == null ? null : REGION_RANGES.get(region);
+        if (range == null) {
+            return true;
+        }
+        int value = Integer.parseInt(postcode);
+        return value >= range[0] && value <= range[1];
+    }
+}
