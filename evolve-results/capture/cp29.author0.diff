diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java
new file mode 100644
index 000000000..8d699afbd
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java
@@ -0,0 +1,25 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Class-level constraint enforcing the cross-field postcode rule: a supplied postcode must be valid
+ * for the owner's city. The check needs both {@code city} and {@code postcode}, so it is applied to
+ * the whole owner payload rather than a single field. A {@code null} postcode is accepted (the
+ * field is optional) and 4-digit formatting is enforced separately by {@code @Pattern}; this
+ * constraint only rejects a well-formed postcode that is out of range for the city's known region.
+ */
+@Target({ ElementType.TYPE })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = PostcodeValidator.class)
+@Documented
+public @interface PostcodeValidation {
+
+    String message() default "Postcode is not valid for the owner's city";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java
new file mode 100644
index 000000000..362bb206d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java
@@ -0,0 +1,24 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.util.PostcodeRules;
+
+/**
+ * Validates an owner payload's postcode against its city, delegating to {@link PostcodeRules}, the
+ * single source of truth for the fixed region ranges. A {@code null} payload or a postcode that is
+ * absent, malformed (left to {@code @Pattern}) or valid for the city's region passes; only a
+ * 4-digit postcode out of range for the city's known region is rejected.
+ */
+public class PostcodeValidator implements ConstraintValidator<PostcodeValidation, OwnerFieldsDto> {
+
+    @Override
+    public boolean isValid(OwnerFieldsDto owner, ConstraintValidatorContext context) {
+        if (owner == null) {
+            return true;
+        }
+        return PostcodeRules.isValidForCity(owner.getCity(), owner.getPostcode());
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/util/PostcodeRules.java b/src/main/java/org/springframework/samples/petclinic/util/PostcodeRules.java
