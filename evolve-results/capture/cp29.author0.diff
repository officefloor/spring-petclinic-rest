index 000000000..801d48917
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidPostcodeException.java
@@ -0,0 +1,31 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when an owner's supplied postcode is out of range for the owner's city. Postcodes
+ * are validated only when present: for a city with a known region (Sydney=NSW 2000-2099,
+ * Melbourne=VIC 3000-3099, Brisbane=QLD 4000-4099) the 4-digit postcode must fall within that
+ * region's inclusive range; a city with no known region accepts any 4-digit postcode. Handled
+ * globally by {@link InvalidPostcodeExceptionHandler}, which responds 400.
+ */
+public class InvalidPostcodeException extends Exception {
+
+    private final String city;
+
+    private final String rejectedValue;
+
+    public InvalidPostcodeException(String city, String rejectedValue) {
+        super("Postcode " + rejectedValue + " is not valid for city " + city);
+        this.city = city;
+        this.rejectedValue = rejectedValue;
+    }
+
+    /** The city whose region the postcode failed to match. */
+    public String getCity() {
+        return this.city;
+    }
+
+    /** The postcode value that was rejected. */
+    public String getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidPostcodeExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidPostcodeExceptionHandler.java
new file mode 100644
index 000000000..654bfb409
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidPostcodeExceptionHandler.java
@@ -0,0 +1,18 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class InvalidPostcodeExceptionHandler {
+
+    public void handle(@Parameter InvalidPostcodeException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.BAD_REQUEST, ex.getMessage());
+        detail.setProperty("field", "postcode");
+        detail.setProperty("rejectedValue", ex.getRejectedValue());
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(detail));
+    }
+}
