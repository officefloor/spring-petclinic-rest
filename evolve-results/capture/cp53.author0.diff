+package org.springframework.samples.petclinic.rest.function.owner;
+
+/**
+ * Immutable structured audit event emitted once per successful owner create (see
+ * {@link AuditOwnerCreated}). Serialized to a single JSON object on the {@code AUDIT}
+ * logger, alongside the human-readable audit line.
+ *
+ * <p>{@code identifier} carries the owner's <em>current primary identifier</em>. Today
+ * that is the {@code customerCode}; the JSON field is named {@code customerCode}
+ * accordingly (see {@link AuditOwnerCreated#primaryIdentifier}). When the primary
+ * identifier is later unified into the {@code memberId}, only that single resolution
+ * point changes and the event automatically carries the {@code memberId} instead.
+ *
+ * <p>Being a record, every field is final and set once at construction — the event
+ * cannot be mutated after it is published.
+ */
+public record OwnerCreatedEvent(long seq, Integer ownerId, String customerCode,
+        Integer membershipLevel, String event) {
+
+    /** The fixed event marker for an owner create. */
+    public static final String OWNER_CREATED = "OWNER_CREATED";
+}
