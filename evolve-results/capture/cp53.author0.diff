+package org.springframework.samples.petclinic.rest.function.owner;
+
+/**
+ * Immutable structured audit event for a freshly created owner.
+ *
+ * <p>Serialises to the JSON object
+ * {@code {seq, ownerId, customerCode, membershipLevel, event:"OWNER_CREATED"}}.
+ *
+ * <p>The {@code customerCode} slot carries the owner's <em>current primary
+ * identifier</em>. Today that is the owner's customerCode; when the customerCode is
+ * later unified into the memberId the same slot carries the memberId instead, because
+ * the value is sourced from {@link org.springframework.samples.petclinic.model.Owner#getPrimaryIdentifier()}.
+ *
+ * <p>The record is immutable: once constructed its fields cannot change, so the event
+ * published to the audit log is a faithful, tamper-proof snapshot.
+ *
+ * @param seq            monotonically increasing sequence number across all creates
+ * @param ownerId        the created owner's id
+ * @param customerCode   the owner's current primary identifier
+ * @param membershipLevel the owner's derived membership level at creation time
+ */
+public record OwnerCreatedEvent(long seq, Integer ownerId, String customerCode, Integer membershipLevel) {
+
+    /** The fixed event type discriminator. */
+    public static final String EVENT = "OWNER_CREATED";
+
+    /** @return the event type, always {@value #EVENT}. */
+    public String event() {
+        return EVENT;
+    }
+
+    /** @return this event as a compact JSON object string. */
+    public String toJson() {
+        StringBuilder json = new StringBuilder();
+        json.append('{');
+        json.append("\"seq\":").append(this.seq);
+        json.append(",\"ownerId\":").append(this.ownerId);
+        json.append(",\"customerCode\":").append(quote(this.customerCode));
+        json.append(",\"membershipLevel\":").append(this.membershipLevel);
+        json.append(",\"event\":").append(quote(EVENT));
+        json.append('}');
+        return json.toString();
+    }
+
+    /** JSON-encodes a value: a quoted, escaped string, or bare {@code null}. */
+    private static String quote(String value) {
+        if (value == null) {
+            return "null";
+        }
+        StringBuilder sb = new StringBuilder(value.length() + 2);
+        sb.append('"');
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            switch (c) {
+                case '"' -> sb.append("\\\"");
+                case '\\' -> sb.append("\\\\");
+                case '\n' -> sb.append("\\n");
+                case '\r' -> sb.append("\\r");
+                case '\t' -> sb.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        sb.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        sb.append(c);
+                    }
+                }
+            }
+        }
+        sb.append('"');
+        return sb.toString();
+    }
+}
