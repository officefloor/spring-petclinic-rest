+package org.springframework.samples.petclinic.rest.function.owner;
+
+/**
+ * Immutable structured audit event emitted on a successful owner create, alongside the plain audit
+ * line. Serialized by {@link #toJson()} to a single-line JSON object with fields in the order the
+ * spec lists them — {@code {"seq":..,"ownerId":..,"customerCode":..,"membershipLevel":..,"event":"OWNER_CREATED"}}
+ * — and logged via the dedicated {@code AUDIT} logger by {@link AuditOwnerCreated}.
+ *
+ * <p>The {@code customerCode} slot carries the owner's <strong>current primary identifier</strong>.
+ * Today that identifier is the customer code; when the customer code is unified into the
+ * {@code memberId}, this event carries the memberId instead. {@link AuditOwnerCreated} reads it from
+ * one place so that migration is a single edit and the event and read model cannot drift apart.
+ *
+ * <p>{@code seq} is a monotonically increasing integer across creates (see {@link AuditOwnerCreated}).
+ */
+public record OwnerCreatedEvent(long seq, int ownerId, String customerCode, Integer membershipLevel) {
+
+    /** The fixed event marker distinguishing this structured event from other AUDIT lines. */
+    public static final String EVENT = "OWNER_CREATED";
+
+    /** This event as a single-line JSON object, fields ordered as the spec lists them. */
+    public String toJson() {
+        return new StringBuilder(96)
+                .append("{\"seq\":").append(this.seq)
+                .append(",\"ownerId\":").append(this.ownerId)
+                .append(",\"customerCode\":").append(quote(this.customerCode))
+                .append(",\"membershipLevel\":").append(this.membershipLevel)
+                .append(",\"event\":").append(quote(EVENT))
+                .append('}')
+                .toString();
+    }
+
+    /** A JSON string literal for {@code s}, or the bare literal {@code null} when absent. */
+    private static String quote(String s) {
+        if (s == null) {
+            return "null";
+        }
+        StringBuilder q = new StringBuilder(s.length() + 2).append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"' -> q.append("\\\"");
+                case '\\' -> q.append("\\\\");
+                case '\n' -> q.append("\\n");
+                case '\r' -> q.append("\\r");
+                case '\t' -> q.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        q.append(String.format("\\u%04x", (int) c));
+                    }
+                    else {
+                        q.append(c);
+                    }
+                }
+            }
+        }
+        return q.append('"').toString();
+    }
+}
