+    private static String ownerCreatedEvent(Integer ownerId, String identifier, Integer membershipLevel) {
+        return String.format(
+            "{\"seq\":%d,\"ownerId\":%d,\"customerCode\":%s,\"membershipLevel\":%d,\"event\":\"OWNER_CREATED\"}",
