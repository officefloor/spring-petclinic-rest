 public class AssignOwnerMembershipLevel {
 
+    /** Tenure, in days, that an owner must exceed to earn the level-4 factor. */
+    static final long TENURE_THRESHOLD_DAYS = 365;
+
     public void service(@Val Owner owner) {
         int level = 1;
