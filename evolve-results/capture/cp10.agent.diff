+package org.springframework.samples.petclinic.service;
+
+/**
+ * Thrown when an attempt is made to create an {@code Owner} whose last name and address (compared
+ * case-insensitively with collapsed whitespace) already belong to another owner, i.e. a duplicate
+ * household. Enforcing it in the service layer keeps the invariant in one place regardless of which
+ * caller initiates the create; the REST layer maps this to a {@code 409 Conflict}. Callers that
+ * genuinely share a household can bypass the check by setting {@code sharesHousehold} true.
+ */
+public class DuplicateHouseholdException extends RuntimeException {
+
+    public DuplicateHouseholdException(String lastName, String address) {
+        super("An owner with last name '" + lastName + "' already exists at address '" + address + "'");
+    }
+
+}
