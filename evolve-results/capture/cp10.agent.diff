+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created whose last name and address already match another owner's
+ * (compared case-insensitively with collapsed whitespace), meaning they appear to belong to the
+ * same household. The duplicate is rejected with a {@code 409 Conflict} response unless the
+ * request explicitly sets {@code sharesHousehold} to {@code true}.
+ */
+public class DuplicateOwnerHouseholdException extends RuntimeException {
+
+    private final transient String lastName;
+
+    private final transient String address;
+
+    public DuplicateOwnerHouseholdException(String lastName, String address) {
+        super("An owner with last name " + lastName + " already exists at address " + address);
+        this.lastName = lastName;
+        this.address = address;
+    }
+
+    public String getLastName() {
+        return this.lastName;
+    }
+
+    public String getAddress() {
+        return this.address;
+    }
+}
