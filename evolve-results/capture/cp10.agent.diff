@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when a request to create an owner has the same last name and address (compared
+ * case-insensitively with collapsed whitespace) as an owner that already exists, i.e. another member
+ * of the same household, without opting in via {@code sharesHousehold}. Carries the offending last name
+ * and address so {@link DuplicateHouseholdExceptionHandler} can report them. Checked so it appears in
+ * the function's {@code throws} clause and is routed as an escalation (a 409 Conflict).
+ */
+public class DuplicateHouseholdException extends Exception {
+
+    private final String lastName;
+
+    private final String address;
+
+    public DuplicateHouseholdException(String lastName, String address) {
+        super("An owner named '" + lastName + "' already exists at address '" + address + "'");
+        this.lastName = lastName;
+        this.address = address;
+    }
+
+    public String getLastName() {
+        return this.lastName;
+    }
+
+    public String getAddress() {
+        return this.address;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateHouseholdExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateHouseholdExceptionHandler.java
new file mode 100644
index 000000000..8e3811ca7
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateHouseholdExceptionHandler.java
@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 409 with an RFC-7807 {@link ProblemDetail} (built through the shared {@link ProblemDetails}
+ * helper, like every other handler in this package) when a new owner belongs to the same household
+ * (same last name and address) as an existing owner and did not set {@code sharesHousehold}.
+ */
+public class DuplicateHouseholdExceptionHandler {
+
+    public void handle(@Parameter DuplicateHouseholdException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.CONFLICT,
+                "An owner with the same last name and address already exists");
+        detail.setProperty("errors", java.util.List.of("lastName", "address"));
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckHouseholdUnique.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckHouseholdUnique.java
new file mode 100644
index 000000000..c4c3b288c
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckHouseholdUnique.java
@@ -0,0 +1,45 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.rest.escalation.DuplicateHouseholdException;
+
+/**
+ * Rejects a new owner who belongs to the same household as an existing owner — same last name and same
+ * address — so the request is answered with a 409 Conflict rather than persisting a duplicate household
+ * member. Last name and address are compared case-insensitively with surrounding and internal whitespace
+ * collapsed, so "Smith" / " smith " and "10  Main St" / "10 Main St" collide.
+ *
+ * <p>The caller can opt in to sharing a household by setting {@code sharesHousehold} true on the request,
+ * which skips this check (e.g. a spouse or flatmate registering under the same roof). Runs after
+ * {@link CheckTelephoneUnique} and before {@link BuildOwner}.
+ */
+public class CheckHouseholdUnique {
+
+    public void service(@Val OwnerFieldsDto request, OwnerRepository ownerRepository)
+            throws DuplicateHouseholdException {
+        if (Boolean.TRUE.equals(request.getSharesHousehold())) {
+            return;
+        }
+        String lastName = normalize(request.getLastName());
+        String address = normalize(request.getAddress());
+        for (Owner existing : ownerRepository.findAll()) {
+            if (lastName.equals(normalize(existing.getLastName()))
+                    && address.equals(normalize(existing.getAddress()))) {
+                throw new DuplicateHouseholdException(request.getLastName(), request.getAddress());
+            }
+        }
+    }
+
+    /** Lower-case (locale-independent) with leading/trailing and repeated internal whitespace collapsed. */
+    private static String normalize(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value.trim().replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
+    }
+}
