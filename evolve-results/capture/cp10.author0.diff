@@ -0,0 +1,15 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by the owner-create pipeline when another owner already shares the same last name
+ * at the same address (compared case-insensitively with collapsed whitespace), i.e. the same
+ * household, and the request did not opt in with {@code sharesHousehold = true}.
+ *
+ * <p>Handled by {@link HouseholdDuplicateExceptionHandler}, which responds 409.
+ */
+public class HouseholdDuplicateException extends Exception {
+
+    public HouseholdDuplicateException(String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/HouseholdDuplicateExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/HouseholdDuplicateExceptionHandler.java
new file mode 100644
index 000000000..13763af3e
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/HouseholdDuplicateExceptionHandler.java
@@ -0,0 +1,18 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 409 Conflict when a new owner would share a household (same last name and address)
+ * with an existing owner and the request did not set {@code sharesHousehold = true}.
+ */
+public class HouseholdDuplicateExceptionHandler {
+
+    public void handle(@Parameter HouseholdDuplicateException ex,
+            ObjectResponse<ResponseEntity<Void>> response) {
+        response.send(new ResponseEntity<>(HttpStatus.CONFLICT));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateUniqueHousehold.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateUniqueHousehold.java
