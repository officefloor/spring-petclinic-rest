+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Signals that an owner request supplied a {@code postcode} that is either not four digits or,
+ * for a city whose region is known, falls outside that region's permitted postcode range.
+ */
+public class InvalidPostcodeException extends RuntimeException {
+
+    public InvalidPostcodeException(String postcode) {
+        super("Invalid postcode: " + postcode);
+    }
+}
