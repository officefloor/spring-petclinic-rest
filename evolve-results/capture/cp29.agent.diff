index 000000000..b1a38205b
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/InvalidPostcodeException.java
@@ -0,0 +1,15 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+/**
+ * Thrown by {@link ValidateOwnerPostcode} when an owner create request carries a {@code postcode}
+ * that is present but invalid: either not four digits, or outside the inclusive range for the
+ * city's known region (NSW 2000-2099, VIC 3000-3099, QLD 4000-4099). A city with no known region
+ * accepts any 4-digit postcode. Checked so it appears in the {@code throws} clause and is routed
+ * to its escalation handler, which responds 400.
+ */
+public class InvalidPostcodeException extends Exception {
+
+    public InvalidPostcodeException(String postcode) {
+        super("Postcode is not valid for the owner's city: " + postcode);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerLocality.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerLocality.java
new file mode 100644
index 000000000..c4e05696e
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerLocality.java
@@ -0,0 +1,32 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Map;
+
+/**
+ * Single source of truth for the owner city-to-region rule shared across the {@code POST /owners}
+ * pipeline: a fixed table maps Sydney-&gt;NSW, Melbourne-&gt;VIC, Brisbane-&gt;QLD, and any other
+ * (or null) city has no known region.
+ *
+ * <p>Centralised here (as {@link OwnerAddress} is for address normalisation) so the read-time and
+ * write-time sides of the rule cannot drift: {@code OwnerMapper.locality} derives the returned
+ * {@code locality} from it, and {@link ValidateOwnerPostcode} uses it to decide which region's
+ * postcode range a supplied postcode must fall within.
+ */
+public final class OwnerLocality {
+
+    /** City -> canonical region. Anything not listed has no known region. */
+    private static final Map<String, String> CITY_REGION = Map.of(
+            "Sydney", "NSW", "Melbourne", "VIC", "Brisbane", "QLD");
+
+    private OwnerLocality() {
+    }
+
+    /**
+     * The owner's canonical region for the given city, or {@code null} when the city is not in the
+     * table (no known region). Callers that need a display sentinel map {@code null} themselves
+     * (e.g. to {@code "UNKNOWN"}).
+     */
+    public static String regionFor(String city) {
+        return city == null ? null : CITY_REGION.get(city);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateOwnerPostcode.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateOwnerPostcode.java
new file mode 100644
index 000000000..691baa30b
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/ValidateOwnerPostcode.java
@@ -0,0 +1,45 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Map;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Create-time guard for {@code POST /owners}: validates {@code postcode} <em>only when present</em>.
+ * A supplied postcode must be exactly four digits and, when the city maps to a known region, fall
+ * within that region's inclusive range; otherwise the request is rejected with 400 via
+ * {@link InvalidPostcodeException}. A city with no known region accepts any 4-digit postcode, and
+ * an absent (null/blank) postcode is accepted unchanged — so the request contract stays
+ * backward-compatible.
+ *
+ * <p>The city-to-region decision comes from {@link OwnerLocality}, the single shared table also
+ * used by {@code OwnerMapper.locality} for the read-time {@code locality}, so the two sides of the
+ * rule cannot drift.
+ */
+public class ValidateOwnerPostcode {
+
+    /** Region -> inclusive 4-digit postcode range {low, high}. */
+    private static final Map<String, int[]> REGION_POSTCODES = Map.of(
+            "NSW", new int[] {2000, 2099},
+            "VIC", new int[] {3000, 3099},
+            "QLD", new int[] {4000, 4099});
+
+    public void service(@Val OwnerFieldsDto request) throws InvalidPostcodeException {
+        String postcode = request.getPostcode();
+        if (postcode == null || postcode.isBlank()) {
+            return; // optional when absent
+        }
+        if (!postcode.matches("[0-9]{4}")) {
+            throw new InvalidPostcodeException(postcode);
+        }
+        String region = OwnerLocality.regionFor(request.getCity());
+        int[] range = region == null ? null : REGION_POSTCODES.get(region);
+        if (range != null) {
+            int value = Integer.parseInt(postcode);
+            if (value < range[0] || value > range[1]) {
+                throw new InvalidPostcodeException(postcode);
+            }
+        }
+    }
+}
