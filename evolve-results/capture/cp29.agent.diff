diff --git a/src/main/java/org/springframework/samples/petclinic/util/PostcodeValidator.java b/src/main/java/org/springframework/samples/petclinic/util/PostcodeValidator.java
new file mode 100644
index 000000000..597568343
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/util/PostcodeValidator.java
@@ -0,0 +1,66 @@
+/*
