diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java
new file mode 100644
index 000000000..fcdeb5abd
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidation.java
@@ -0,0 +1,24 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Class-level constraint asserting that an owner's optional postcode is valid for its city.
+ * It is a cross-field check (the postcode is validated against the region derived from the city),
+ * so it is applied to the whole owner payload rather than a single field. The actual rule is
+ * owned by {@link org.springframework.samples.petclinic.model.Owner#isPostcodeValidForCity(String, String)}.
+ */
+@Target({ ElementType.TYPE })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = PostcodeValidator.class)
+@Documented
+public @interface PostcodeValidation {
+
+    String message() default "Postcode must be 4 digits and valid for the owner's city";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java
new file mode 100644
index 000000000..f056ad61a
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/PostcodeValidator.java
@@ -0,0 +1,32 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+
+/**
+ * Validates that an owner's optional postcode is valid for its city. The check delegates to
+ * {@link Owner#isPostcodeValidForCity(String, String)}, the single source of truth for postcode
+ * validity, so an absent postcode is accepted while a present one must be four digits and within
+ * the range of the city's region. On failure the violation is reported against the {@code postcode}
+ * field so the error response names it.
+ */
+public class PostcodeValidator implements ConstraintValidator<PostcodeValidation, OwnerFieldsDto> {
+
+    @Override
+    public boolean isValid(OwnerFieldsDto owner, ConstraintValidatorContext context) {
+        if (owner == null) {
+            return true;
+        }
+        if (Owner.isPostcodeValidForCity(owner.getPostcode(), owner.getCity())) {
+            return true;
+        }
+        context.disableDefaultConstraintViolation();
+        context.buildConstraintViolationWithTemplate(context.getDefaultConstraintMessageTemplate())
+            .addPropertyNode("postcode")
+            .addConstraintViolation();
+        return false;
+    }
+}
