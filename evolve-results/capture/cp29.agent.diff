@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@link org.springframework.samples.petclinic.rest.function.owner.ValidateOwner} when an
+ * owner postcode is present on the request but is not a valid 4-digit value, or is out of range for
+ * the owner's city region (NSW 2000-2099, VIC 3000-3099, QLD 4000-4099). A city with no known region
+ * accepts any 4-digit value. Handled by {@link OwnerPostcodeInvalidExceptionHandler}, which responds
+ * 400.
+ */
+public class OwnerPostcodeInvalidException extends Exception {
+
+    private final String submitted;
+
+    public OwnerPostcodeInvalidException(String submitted) {
+        super("Postcode is not valid for the owner's city: " + submitted);
+        this.submitted = submitted;
+    }
+
+    public String getSubmitted() {
+        return this.submitted;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerPostcodeInvalidExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerPostcodeInvalidExceptionHandler.java
new file mode 100644
index 000000000..378b3ead0
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerPostcodeInvalidExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 400 with a JSON body whose {@code errors} array names {@code postcode} when the submitted
+ * postcode is present but not a valid 4-digit value, or is out of range for the owner's city region.
+ */
+public class OwnerPostcodeInvalidExceptionHandler {
+
+    public void handle(@Parameter OwnerPostcodeInvalidException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        Map<String, Object> body = Map.of("errors", List.of("postcode"));
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(body));
+    }
+}
