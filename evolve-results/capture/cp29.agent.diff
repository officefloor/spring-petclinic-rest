diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/PostcodeOutOfRangeException.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/PostcodeOutOfRangeException.java
new file mode 100644
index 000000000..584d25e65
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/PostcodeOutOfRangeException.java
@@ -0,0 +1,28 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@code RequirePostcodeForCity} when a supplied 4-digit postcode is outside the inclusive
+ * range fixed for the owner's city region (NSW 2000-2099, VIC 3000-3099, QLD 4000-4099). A city with
+ * no known region accepts any 4-digit postcode and never triggers this. Carries the offending values so
+ * {@link PostcodeOutOfRangeExceptionHandler} can report a 400.
+ */
+public class PostcodeOutOfRangeException extends Exception {
+
+    private final String postcode;
+
+    private final String city;
+
+    public PostcodeOutOfRangeException(String postcode, String city) {
+        super("Postcode '" + postcode + "' is not valid for city '" + city + "'");
+        this.postcode = postcode;
+        this.city = city;
+    }
+
+    public String getPostcode() {
+        return this.postcode;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/PostcodeOutOfRangeExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/PostcodeOutOfRangeExceptionHandler.java
new file mode 100644
index 000000000..8978c10f1
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/PostcodeOutOfRangeExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 400 when a create/update-owner postcode is out of range for the owner's city region,
+ * mirroring {@link InvalidTelephoneExceptionHandler}'s {@code errors} array shape.
+ */
+public class PostcodeOutOfRangeExceptionHandler {
+
+    public void handle(@Parameter PostcodeOutOfRangeException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                .body(Map.of("errors", List.of("postcode"))));
+    }
+}
