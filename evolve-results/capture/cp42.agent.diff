+package org.springframework.samples.petclinic.model;
+
+import java.util.Map;
+
+/**
+ * Fixed lookup from a region code to its IANA timezone name.
+ */
+public final class RegionTimezoneTable {
+
+    private static final Map<String, String> REGION_TIMEZONES = Map.of(
+        "NSW", "Australia/Sydney",
+        "VIC", "Australia/Melbourne",
+        "QLD", "Australia/Brisbane");
+
+    private RegionTimezoneTable() {
+    }
+
+    /**
+     * The IANA timezone name for the given region code, or {@code null} when the region
+     * is not in the table.
+     */
+    public static String timezoneOf(String region) {
+        return REGION_TIMEZONES.get(region);
+    }
+}
