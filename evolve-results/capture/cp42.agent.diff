+package org.springframework.samples.petclinic.util;
+
+import java.util.Map;
+
+/**
+ * Resolves an IANA timezone name from a canonical region via a fixed
+ * region-to-timezone table: {@code NSW -> Australia/Sydney},
+ * {@code VIC -> Australia/Melbourne}, {@code QLD -> Australia/Brisbane}.
+ */
+public abstract class TimezoneResolver {
+
+    /** Region -> IANA timezone name. */
+    private static final Map<String, String> REGION_TIMEZONE = Map.of(
+        "NSW", "Australia/Sydney",
+        "VIC", "Australia/Melbourne",
+        "QLD", "Australia/Brisbane");
+
+    /**
+     * Return the IANA timezone name for the given canonical region, or {@code null}
+     * when the region is {@code null} or absent from the table.
+     */
+    public static String timezoneOf(String region) {
+        return REGION_TIMEZONE.get(region);
+    }
+
+}
