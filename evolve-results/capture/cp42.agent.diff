diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RegionTimezone.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RegionTimezone.java
new file mode 100644
index 000000000..8a105fdee
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RegionTimezone.java
@@ -0,0 +1,21 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Map;
+
+/**
+ * Maps a canonical region to its IANA timezone via a fixed table
+ * (NSW->Australia/Sydney, VIC->Australia/Melbourne, QLD->Australia/Brisbane);
+ * any other region yields {@code null}.
+ */
+public final class RegionTimezone {
+
+    private static final Map<String, String> REGION_TIMEZONE = Map.of(
+            "NSW", "Australia/Sydney", "VIC", "Australia/Melbourne", "QLD", "Australia/Brisbane");
+
+    private RegionTimezone() {
+    }
+
+    public static String of(String region) {
+        return REGION_TIMEZONE.get(region);
+    }
+}
