diff --git a/src/main/java/org/springframework/samples/petclinic/service/PossibleDuplicateDetector.java b/src/main/java/org/springframework/samples/petclinic/service/PossibleDuplicateDetector.java
new file mode 100644
index 000000000..a47ebd30d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/service/PossibleDuplicateDetector.java
@@ -0,0 +1,64 @@
