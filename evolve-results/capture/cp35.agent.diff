+                    && !java.util.Objects.equals(owner.getTelephone(), existing.getTelephone()))
+                .min(java.util.Comparator.comparing(Owner::getId))
+                .orElse(null);
+        }
+        owner.setPossibleDuplicate(softMatch != null);
