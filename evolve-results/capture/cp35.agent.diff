+                && postcode.equals(existing.getPostcode())
+                && normalizeHouseholdField(existing.getLastName()).equals(lastName)
+                && !telephone.equals(existing.getTelephone()))
+            .map(Owner::getId)
+            .min(Integer::compareTo)
+            .orElse(null);
