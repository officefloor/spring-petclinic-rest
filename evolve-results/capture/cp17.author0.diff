diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/common/Regions.java b/src/main/java/org/springframework/samples/petclinic/rest/function/common/Regions.java
new file mode 100644
index 000000000..44d014748
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/common/Regions.java
@@ -0,0 +1,32 @@
+package org.springframework.samples.petclinic.rest.function.common;
+
+import java.util.Map;
+
+/**
+ * Fixed city-to-region lookup shared by the owner functions. The table pins each known city to its
+ * canonical region string; any city not listed derives the locality {@code "UNKNOWN"}.
+ */
+public final class Regions {
+
+    /** City -> canonical region. Anything not listed derives locality {@link #UNKNOWN}. */
+    private static final Map<String, String> CITY_REGION = Map.of(
+        "Sydney", "NSW",
+        "Melbourne", "VIC",
+        "Brisbane", "QLD");
+
+    /** The locality returned for a city absent from {@link #CITY_REGION}. */
+    public static final String UNKNOWN = "UNKNOWN";
+
+    private Regions() {
+    }
+
+    /**
+     * Derive the locality (canonical region) for a city.
+     *
+     * @param city the owner's city; may be {@code null}
+     * @return the canonical region string, or {@code "UNKNOWN"} when the city is not in the table
+     */
+    public static String localityOf(String city) {
+        return CITY_REGION.getOrDefault(city, UNKNOWN);
+    }
+}
