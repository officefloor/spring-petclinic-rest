diff --git a/src/main/java/org/springframework/samples/petclinic/model/Owner.java b/src/main/java/org/springframework/samples/petclinic/model/Owner.java
index b91a29f9b..2f163f73c 100644
--- a/src/main/java/org/springframework/samples/petclinic/model/Owner.java
+++ b/src/main/java/org/springframework/samples/petclinic/model/Owner.java
@@ -61,6 +61,9 @@ public class Owner extends Person {
     @Column(name = "email")
     private String email;
 
+    @Column(name = "title")
+    private String title;
+
     @Column(name = "registration_date")
     private LocalDate registrationDate;
 
@@ -168,6 +171,26 @@ public class Owner extends Person {
         this.email = email;
     }
 
+    public String getTitle() {
+        return this.title;
+    }
+
+    public void setTitle(String title) {
+        this.title = title;
+    }
+
+    /**
+     * The owner's salutation: the {@link #getTitle() title} followed by a single space and the
+     * {@link #getLastName() last name} (e.g. {@code "DR Franklin"}), or just the last name when no
+     * title was supplied. Derived per response, not persisted.
+     */
+    public String getSalutation() {
+        if (this.title == null || this.title.isBlank()) {
+            return this.getLastName();
+        }
+        return this.title + " " + this.getLastName();
+    }
+
     public LocalDate getRegistrationDate() {
         return this.registrationDate;
     }
