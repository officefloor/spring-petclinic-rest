diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCityCapacityWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCityCapacityWarning.java
new file mode 100644
index 000000000..98e858483
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCityCapacityWarning.java
@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Flags the response with {@code capacityWarning}: {@code true} when this owner's city already contains
+ * between {@link CheckCityCapacity#WARNING_THRESHOLD 40} and 49 owners (inclusive) — i.e. it is
+ * approaching, but has not yet reached, the per-city {@link CheckCityCapacity#CAPACITY capacity limit of
+ * 50} — otherwise {@code false}. The per-city count is taken over all owners sharing this owner's
+ * {@link OwnerCity#normalize normalized} city via {@link CheckCityCapacity#countInCity}, the same
+ * accumulation path as the hard {@link CheckCityCapacity capacity check}. Computed per request and mutated
+ * onto the loaded owner in place, not persisted; the hard rejection at 50 is unchanged.
+ */
+public class FlagCityCapacityWarning {
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        int count = CheckCityCapacity.countInCity(owner.getCity(), ownerRepository);
+        owner.setCapacityWarning(
+            count >= CheckCityCapacity.WARNING_THRESHOLD && count < CheckCityCapacity.CAPACITY);
+    }
+}
