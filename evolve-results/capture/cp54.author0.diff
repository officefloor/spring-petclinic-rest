diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssessCityCapacity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssessCityCapacity.java
new file mode 100644
index 000000000..6167ea74a
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssessCityCapacity.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns the owner's {@code capacityWarning}: {@code true} when the owner's city already
+ * holds between 40 and 49 owners (inclusive), i.e. it is approaching the hard capacity
+ * limit of 50, otherwise {@code false}. The count is taken over the existing owners (the
+ * new owner is not yet saved) and matches cities by exact value, exactly as the hard
+ * rejection in {@link EnsureCityCapacity} does; since that step runs earlier in the
+ * pipeline and rejects at 50 or more, by the time this step runs the count is always below
+ * the limit.
+ */
+public class AssessCityCapacity {
+
+    private static final int CITY_CAPACITY = 50;
+
+    private static final int WARNING_THRESHOLD = 40;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        String city = owner.getCity();
+        long inCity = ownerRepository.findAll().stream()
+            .filter(existing -> city != null && city.equals(existing.getCity()))
+            .count();
+        owner.setCapacityWarning(inCity >= WARNING_THRESHOLD && inCity < CITY_CAPACITY);
+    }
+}
