diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignCapacityWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignCapacityWarning.java
new file mode 100644
index 000000000..10477fb66
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignCapacityWarning.java
@@ -0,0 +1,34 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns the owner's {@code capacityWarning}: true when this owner's city already holds
+ * between 40 and 49 owners (approaching the hard capacity limit of 50), otherwise false.
+ * The city is compared case-insensitively, matching {@link EnsureCityCapacity}. Runs before
+ * the owner is saved, so the count excludes the owner being created; the hard rejection at 50
+ * has already happened in {@link EnsureCityCapacity}, so the count seen here is always below
+ * the limit. The flag is stamped on the owner so it is persisted and returned on read, and
+ * never changes afterwards.
+ */
+public class AssignCapacityWarning {
+
+    /** Number of existing owners in a city at or above which a create is warned. */
+    private static final int CAPACITY_WARNING_THRESHOLD = 40;
+
+    /** Maximum number of owners a single city may contain. */
+    private static final int CITY_CAPACITY = 50;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        String city = owner.getCity();
+        int count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (city.equalsIgnoreCase(existing.getCity())) {
+                count++;
+            }
+        }
+        owner.setCapacityWarning(count >= CAPACITY_WARNING_THRESHOLD && count < CITY_CAPACITY);
+    }
+}
