diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCapacityWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCapacityWarning.java
new file mode 100644
index 000000000..30da98fd5
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCapacityWarning.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Populates the response-only {@link Owner#isCapacityWarning() capacityWarning} flag: true when
+ * the owner's city already holds between 40 and 49 owners (compared case-insensitively),
+ * approaching the hard capacity limit of 50 that {@link ValidateCityCapacity} rejects at;
+ * otherwise false. Mutates the loaded owner in place so the responder's mapper carries the flag
+ * onto the DTO.
+ */
+public class FlagCapacityWarning {
+
+    private static final int WARN_FROM = 40;
+    private static final int WARN_TO = 49;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        String city = owner.getCity();
+        int count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (city != null && city.equalsIgnoreCase(existing.getCity())) {
+                count++;
+            }
+        }
+        owner.setCapacityWarning(count >= WARN_FROM && count <= WARN_TO);
+    }
+}
