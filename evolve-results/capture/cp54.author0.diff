diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagOwnerCapacityWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagOwnerCapacityWarning.java
new file mode 100644
index 000000000..f740bb3e4
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagOwnerCapacityWarning.java
@@ -0,0 +1,33 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Flags the owner with {@code capacityWarning} when the owner's city is approaching capacity.
+ *
+ * <p>Runs in the {@code POST /api/owners} pipeline after {@link BuildOwner} and before
+ * {@link SaveOwner}, so the new owner is not yet persisted and therefore not counted. When the
+ * owner's city already holds between {@value #WARNING_THRESHOLD} and {@code CITY_CAPACITY - 1}
+ * owners (inclusive) the warning is set to {@code true}; otherwise {@code false}. This mirrors the
+ * count used by {@link CheckOwnerCityCapacity}, which hard-rejects (409) once a city reaches the
+ * capacity limit of 50 — so by the time this step runs the count is always below 50. The value is
+ * frozen at creation time and returned unchanged on later reads.
+ */
+public class FlagOwnerCapacityWarning {
+
+    /** At or above this many owners already in the city, the next owner carries the warning. */
+    private static final int WARNING_THRESHOLD = 40;
+
+    /** The hard per-city capacity limit; a city at this count rejects the next owner. */
+    private static final int CITY_CAPACITY = 50;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        String city = owner.getCity();
+        long ownersInCity = ownerRepository.findAll().stream()
+                .filter(existing -> city != null && city.equals(existing.getCity()))
+                .count();
+        owner.setCapacityWarning(ownersInCity >= WARNING_THRESHOLD && ownersInCity < CITY_CAPACITY);
+    }
+}
