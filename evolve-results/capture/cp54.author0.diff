diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignCityCapacityWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignCityCapacityWarning.java
new file mode 100644
index 000000000..9a4ad2f84
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignCityCapacityWarning.java
@@ -0,0 +1,34 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns the owner's {@code capacityWarning}: {@code true} when this owner's city already held
+ * between 40 and 49 owners (inclusive) when this owner was created — i.e. it is approaching the
+ * per-city hard capacity of 50 — {@code false} otherwise.
+ *
+ * <p>Runs within the create transaction after {@link BuildOwner} (so the owner's {@code city} is
+ * set) and before {@link SaveOwner} (so {@code findAll} excludes the owner being created). The
+ * city is compared case-insensitively against each existing owner's city, matching the count used
+ * by {@link CheckOwnerCityCapacity}; that guard already rejected the request with a 409 at 50, so
+ * this step only ever sees counts below the hard limit.
+ */
+public class AssignCityCapacityWarning {
+
+    /** Owner count in a city at or above which the capacity warning is raised. */
+    private static final int WARNING_THRESHOLD = 40;
+
+    /** Maximum number of owners permitted in a single city (the hard limit). */
+    private static final int CITY_CAPACITY = 50;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        String city = owner.getCity();
+        long count = ownerRepository.findAll().stream()
+            .map(Owner::getCity)
+            .filter(existing -> existing != null && existing.equalsIgnoreCase(city))
+            .count();
+        owner.setCapacityWarning(count >= WARNING_THRESHOLD && count < CITY_CAPACITY);
+    }
+}
