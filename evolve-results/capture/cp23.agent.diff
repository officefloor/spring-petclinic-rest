+        }
+        long members = this.clinicService.findAllOwners().stream()
+            .filter(other -> householdId.equals(other.getHouseholdId()))
+            .count();
+        return members >= GOLD_HOUSEHOLD_SIZE ? OwnerDto.MembershipTierEnum.GOLD : base;
+    }
