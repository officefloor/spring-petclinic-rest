+     *         otherwise {@code base}
+     */
+    private OwnerDto.MembershipTierEnum applyHouseholdTier(Owner owner, OwnerDto.MembershipTierEnum base) {
+        String householdId = owner.getHouseholdId();
+        if (householdId == null) {
