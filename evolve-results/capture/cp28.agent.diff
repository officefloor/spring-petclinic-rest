+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created whose derived {@code identityKey} duplicates an existing owner's,
+ * i.e. duplicate detection consolidated into the single identity key rejects the create. Handled as a
+ * 409 Conflict by {@link ExceptionControllerAdvice}.
+ */
+public class DuplicateIdentityException extends RuntimeException {
+
+    private final transient Object rejectedValue;
+
+    public DuplicateIdentityException(Object rejectedValue) {
+        super("identityKey is already used by another owner");
+        this.rejectedValue = rejectedValue;
+    }
+
+    public Object getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
