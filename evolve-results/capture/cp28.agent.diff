+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Raised when a create request supplies an owner whose derived {@code identityKey} (the normalized
+ * telephone, the email or empty, and the household id joined by {@code '|'}) exactly equals that of
+ * an existing owner. This single key subsumes the former separate telephone, email and household
+ * duplicate checks. Carries the conflicting key so the API can report the rejection back to the client.
+ */
+public class DuplicateIdentityException extends RuntimeException {
+
+    private final String identityKey;
+
+    public DuplicateIdentityException(String identityKey) {
+        super("An owner with identity key '" + identityKey + "' already exists");
+        this.identityKey = identityKey;
+    }
+
+    public String getIdentityKey() {
+        return this.identityKey;
+    }
+}
