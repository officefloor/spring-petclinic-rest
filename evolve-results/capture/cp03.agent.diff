+package org.springframework.samples.petclinic.service;
+
+/**
+ * Thrown when an attempt is made to create an {@code Owner} whose normalized telephone number is
+ * already used by another owner. Enforcing it in the service layer keeps the uniqueness invariant
+ * in one place regardless of which caller initiates the create; the REST layer maps this to a
+ * {@code 409 Conflict}.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    public DuplicateTelephoneException(String telephone) {
+        super("An owner with telephone '" + telephone + "' already exists");
+    }
+
+}
