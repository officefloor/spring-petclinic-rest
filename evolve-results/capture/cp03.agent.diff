+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a request to create an owner carries a normalized telephone that is already
+ * used by another owner. The exception handler translates it to a 409 Conflict whose
+ * {@code errors} array names the offending {@code telephone} field.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    public DuplicateTelephoneException(String telephone) {
+        super("Telephone is already used by another owner: " + telephone);
+    }
+}
