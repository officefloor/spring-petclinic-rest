@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 409 with a JSON body {@code {"errors": ["telephone"]}} when the create-owner
+ * normalized telephone is already used by another owner.
+ */
+public class OwnerTelephoneDuplicateExceptionHandler {
+
+    public void handle(@Parameter OwnerTelephoneDuplicateException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT)
+                .body(Map.of("errors", List.of("telephone"))));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireUniqueOwnerTelephone.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireUniqueOwnerTelephone.java
