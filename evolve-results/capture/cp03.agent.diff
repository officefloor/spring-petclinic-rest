+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Signals that a new owner could not be created because its normalized telephone
+ * number is already used by an existing owner.
+ *
+ * <p>Handled as a 409 Conflict, reporting {@code telephone} as the offending field.
+ */
+public class DuplicateOwnerTelephoneException extends RuntimeException {
+
+    public DuplicateOwnerTelephoneException(String telephone) {
+        super("Telephone already in use by another owner: " + telephone);
+    }
+}
