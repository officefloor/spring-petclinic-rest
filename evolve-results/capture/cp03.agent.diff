+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown by REST controllers when an owner cannot be created because its normalized telephone is
+ * already used by another owner. The exception handler reports it as a {@code 409 Conflict}.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    public DuplicateTelephoneException(String telephone) {
+        super("An owner with telephone '" + telephone + "' already exists");
+    }
+}
