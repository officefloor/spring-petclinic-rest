+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown on create when the supplied telephone, after normalization, is already used by another
+ * owner. Carries the {@code telephone} field name so the {@link ExceptionControllerAdvice} can
+ * report it in the {@code errors} array of a 409 Conflict response, mirroring
+ * {@link InvalidTelephoneException}.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    public DuplicateTelephoneException(String message) {
+        super(message);
+    }
+}
