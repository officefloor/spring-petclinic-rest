+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created with a normalized telephone that is already used by another owner.
+ * Handled as a 409 Conflict by {@link ExceptionControllerAdvice}.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    private final transient Object rejectedValue;
+
+    public DuplicateTelephoneException(Object rejectedValue) {
+        super("telephone is already used by another owner");
+        this.rejectedValue = rejectedValue;
+    }
+
+    public Object getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
