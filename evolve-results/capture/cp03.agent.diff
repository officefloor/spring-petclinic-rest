+/**
+ * Thrown when an attempt is made to create an owner whose normalized telephone number is already used by another
+ * owner. Reported as a {@code 409 Conflict} by the {@link ExceptionControllerAdvice}.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    public DuplicateTelephoneException(String message) {
+        super(message);
+    }
+}
