+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a submitted owner telephone, once normalized, is already in use by another owner.
+ * Carries the offending (normalized) value so it can be reported to the client.
+ */
+public class DuplicateTelephoneException extends RuntimeException {
+
+    private final String rejectedValue;
+
+    public DuplicateTelephoneException(String rejectedValue) {
+        super("Telephone is already used by another owner: " + rejectedValue);
+        this.rejectedValue = rejectedValue;
+    }
+
+    public String getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
