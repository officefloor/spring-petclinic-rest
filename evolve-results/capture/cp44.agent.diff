diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressFormValidation.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressFormValidation.java
new file mode 100644
index 000000000..6e1dd8cfa
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressFormValidation.java
@@ -0,0 +1,27 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Class-level constraint enforcing that an owner supplies an address in EITHER form: a non-blank
+ * structured {@code addressLine1} or the flat {@code address}. The check needs both fields, so it is
+ * applied to the whole owner payload rather than a single field. The flat {@code address} remains
+ * accepted for backward compatibility, so an owner that supplies only it (as earlier minimal owners
+ * did) still validates; a non-blank {@code addressLine1} alone is likewise accepted. Blankness is
+ * decided by {@link org.springframework.samples.petclinic.util.AddressNormalizer}, the same
+ * normalization applied elsewhere.
+ */
+@Target({ ElementType.TYPE })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = AddressFormValidator.class)
+@Documented
+public @interface AddressFormValidation {
+
+    String message() default "An owner must supply an address: either a non-blank addressLine1 or the flat address";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressFormValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressFormValidator.java
new file mode 100644
index 000000000..df23d98fa
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/AddressFormValidator.java
@@ -0,0 +1,26 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.util.AddressNormalizer;
+
+/**
+ * Validates that an owner payload carries an address in at least one accepted form: a structured
+ * {@code addressLine1} that is non-blank after normalization, or the flat {@code address} that is
+ * non-blank after normalization. A {@code null} payload passes. This keeps the request contract
+ * backward-compatible — an owner supplying only the flat {@code address} is still accepted — while
+ * allowing the structured form to stand on its own.
+ */
+public class AddressFormValidator implements ConstraintValidator<AddressFormValidation, OwnerFieldsDto> {
+
+    @Override
+    public boolean isValid(OwnerFieldsDto owner, ConstraintValidatorContext context) {
+        if (owner == null) {
+            return true;
+        }
+        return AddressNormalizer.normalize(owner.getAddressLine1()) != null
+            || AddressNormalizer.normalize(owner.getAddress()) != null;
+    }
+}
