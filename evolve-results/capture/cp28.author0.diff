+    /**
+     * Whether any existing owner has the given derived identity key. This is the single basis
+     * for duplicate detection: a create is rejected only when the whole identity key
+     * (normalized telephone, email and household id joined with {@code '|'}) matches an
+     * existing owner exactly.
+     */
+    @Override
+    @Transactional(readOnly = true)
+    public boolean existsOwnerWithIdentityKey(String identityKey) throws DataAccessException {
+        if (identityKey == null) {
+            return false;
+        }
+        return ownerRepository.findAll().stream()
+            .anyMatch(existing -> identityKey.equals(existing.getIdentityKey()));
+    }
+
