-        if (!OwnerHouseholds.members(existing, request.getLastName(), request.getPostcode()).isEmpty()) {
-            throw new DuplicateOwnerException(
-                    OwnerHouseholds.householdId(request.getLastName(), request.getPostcode()));
-        }
-    }
