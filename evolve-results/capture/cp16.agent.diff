+    private static long countOwnersInCity(OwnerRepository ownerRepository, String city) {
+        String key = cityKey(city);
+        long count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (key.equals(cityKey(existing.getCity()))) {
+                count++;
+            }
