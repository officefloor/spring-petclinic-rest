+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner is created whose household (same last name and postcode) already exists,
+ * without the request declaring {@code sharesHousehold}. A caller that knowingly registers a
+ * further member of the same household opts in via {@code sharesHousehold} to bypass this block.
+ * Carries the offending household id so it can be logged.
+ */
+public class HouseholdDuplicateException extends RuntimeException {
+
+    /** Name of the offending field, used to build the error response. */
+    public static final String FIELD = "householdId";
+
+    public HouseholdDuplicateException(String householdId) {
+        super("Household already exists (set 'sharesHousehold' to join it): " + householdId);
+    }
+}
