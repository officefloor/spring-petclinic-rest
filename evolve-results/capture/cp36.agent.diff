+package org.springframework.samples.petclinic.service;
+
+/**
+ * Thrown when an {@link org.springframework.samples.petclinic.model.Owner} is created into a
+ * household that already has a member — another owner sharing the same computed
+ * {@link org.springframework.samples.petclinic.model.Owner#getHouseholdId() householdId} (i.e. the
+ * same normalized {@code lastName} and {@code postcode}) — without declaring
+ * {@code sharesHousehold}. Signals a business-rule conflict, mapped to HTTP 409.
+ */
+public class HouseholdDuplicateException extends RuntimeException {
+
+    public HouseholdDuplicateException(String householdId) {
+        super("An owner in household '" + householdId + "' already exists; "
+            + "set sharesHousehold to add a declared household member");
+    }
+}
