diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/DuplicateHouseholdException.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/DuplicateHouseholdException.java
new file mode 100644
index 000000000..8486b5056
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/DuplicateHouseholdException.java
@@ -0,0 +1,19 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when a new owner belongs to the household of an existing owner (same last name and postcode)
+ * without declaring that it shares the household.
+ */
+public class DuplicateHouseholdException extends RuntimeException {
+
+    private final String householdId;
+
+    public DuplicateHouseholdException(String householdId) {
+        super("An owner with the same last name and postcode already exists; set 'sharesHousehold' to join the household");
+        this.householdId = householdId;
+    }
+
+    public String getHouseholdId() {
+        return householdId;
+    }
+}
