+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an attempt is made to create an owner that belongs to a household (same last name and
+ * postcode, and therefore the same deterministic household id) that already contains another owner,
+ * without declaring the shared household. Setting {@code sharesHousehold} bypasses this rule so the
+ * owner is created as a declared household member instead. Handled by
+ * {@link ExceptionControllerAdvice} as a 409 Conflict.
+ */
+public class HouseholdDuplicateException extends OwnerConflictException {
+
+    public HouseholdDuplicateException(String message) {
+        super(message, "An owner in the same household already exists");
+    }
+}
