+package org.springframework.samples.petclinic.model;
+
+import java.time.LocalDate;
+import java.time.Period;
+
+/**
+ * The age band an owner falls into, derived from their birth date as of a reference date.
+ */
+public enum AgeBand {
+    MINOR, ADULT, SENIOR;
+
+    /**
+     * Resolve the age band for someone born on {@code birthDate} as of {@code referenceDate}:
+     * {@code MINOR} under 18, {@code ADULT} from 18 to 64, {@code SENIOR} at 65 or older. Returns
+     * {@code null} when either date is unknown, since no band can be derived.
+     */
+    public static AgeBand asOf(LocalDate birthDate, LocalDate referenceDate) {
+        if (birthDate == null || referenceDate == null) {
+            return null;
+        }
+        int years = Period.between(birthDate, referenceDate).getYears();
+        if (years < 18) {
+            return MINOR;
+        }
+        if (years < 65) {
+            return ADULT;
+        }
+        return SENIOR;
+    }
+}
