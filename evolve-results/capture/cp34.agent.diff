+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.model;
+
+import java.time.LocalDate;
+import java.time.Period;
+
+/**
+ * A person's age band: {@link #MINOR} (under 18), {@link #ADULT} (18-64) or {@link #SENIOR}
+ * (65 and over).
+ */
+public enum AgeBand {
+
+    MINOR, ADULT, SENIOR;
+
+    /**
+     * Classifies the age band for someone born on {@code birthDate} as observed on
+     * {@code asOf}, based on their completed years of age at that date.
+     */
+    public static AgeBand of(LocalDate birthDate, LocalDate asOf) {
+        int years = Period.between(birthDate, asOf).getYears();
+        if (years < 18) {
+            return MINOR;
+        }
+        if (years < 65) {
+            return ADULT;
+        }
+        return SENIOR;
+    }
+}
