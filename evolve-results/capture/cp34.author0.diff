@@ -34,8 +34,33 @@ public interface OwnerMapper {
         expression = "java(toIdentityKey(owner))")
     @Mapping(target = "checkDigit",
         expression = "java(toCheckDigit(owner))")
+    @Mapping(target = "ageBand",
+        expression = "java(toAgeBand(owner))")
     OwnerDto toOwnerDto(Owner owner);
 
+    /**
+     * Derive an owner's age band from the {@code birthDate} relative to the {@code registrationDate}:
+     * 'MINOR' when under 18, 'ADULT' when 18 to 64, and 'SENIOR' when 65 or older. Returns
+     * {@code null} when no birth date was supplied (the band is then absent from the DTO). When the
+     * registration date is missing (e.g. legacy records) the current date is used as the reference.
+     */
+    default org.springframework.samples.petclinic.rest.dto.OwnerDto.AgeBandEnum toAgeBand(Owner owner) {
+        java.time.LocalDate birthDate = owner.getBirthDate();
+        if (birthDate == null) {
+            return null;
+        }
+        java.time.LocalDate reference = owner.getRegistrationDate() != null
+            ? owner.getRegistrationDate() : java.time.LocalDate.now();
+        int age = java.time.Period.between(birthDate, reference).getYears();
+        if (age < 18) {
+            return org.springframework.samples.petclinic.rest.dto.OwnerDto.AgeBandEnum.MINOR;
+        }
+        if (age < 65) {
+            return org.springframework.samples.petclinic.rest.dto.OwnerDto.AgeBandEnum.ADULT;
+        }
+        return org.springframework.samples.petclinic.rest.dto.OwnerDto.AgeBandEnum.SENIOR;
+    }
+
     /**
      * Derive an owner's check digit: a single Luhn check digit (0-9) computed over the digits
      * contained in the {@code customerCode}. Non-digit characters (the separators) are ignored.
