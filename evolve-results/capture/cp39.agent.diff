+package org.springframework.samples.petclinic.rest.controller.v1;
+
+import java.time.LocalDate;
+import java.time.temporal.ChronoUnit;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * Derives an owner's {@code membershipLevel}. The pre-tenure factors (having an
+ * email and having no namesake) lift the base level of 1 up to at most 3. Level 4
+ * is reserved for loyalty: it requires a tenure of more than 365 days measured from
+ * the registration date, so a brand-new owner (zero tenure) never exceeds level 3.
+ */
+public final class MembershipLevel {
+
+    private MembershipLevel() {
+    }
+
+    /** The membership level of {@code owner} (1-3 pre-tenure, 4 once tenure exceeds 365 days). */
+    public static int of(Owner owner) {
+        int level = 1
+            + (owner.getEmail() != null ? 1 : 0)
+            + (owner.getNamesakeCount() != null && owner.getNamesakeCount() == 0 ? 1 : 0);
+        level = Math.min(3, level);
+        if (ChronoUnit.DAYS.between(owner.getRegistrationDate(), LocalDate.now()) > 365) {
+            level += 1;
+        }
+        return level;
+    }
+}
