diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagOwnerCapacityWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagOwnerCapacityWarning.java
new file mode 100644
index 000000000..7ccd4f10d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagOwnerCapacityWarning.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Flags the owner with {@code capacityWarning} when the owner's city is approaching capacity.
+ *
+ * <p>Runs in the {@code POST /api/owners} pipeline after {@link BuildOwner} and before
+ * {@link SaveOwner}, so the new owner is not yet persisted and therefore not counted. When the
+ * owner's city already holds between {@value #WARNING_THRESHOLD} and {@code CITY_CAPACITY - 1}
+ * owners (inclusive) the warning is set to {@code true}; otherwise {@code false}. It shares the
+ * {@link OwnerCities#countInCity} count and {@link OwnerCities#CITY_CAPACITY} limit with
+ * {@link CheckOwnerCityCapacity}, which hard-rejects (409) once a city reaches capacity — so by the
+ * time this step runs the count is always below the limit. The value is frozen at creation time and
+ * returned unchanged on later reads.
+ */
+public class FlagOwnerCapacityWarning {
+
+    /** At or above this many owners already in the city, the next owner carries the warning. */
+    private static final int WARNING_THRESHOLD = 40;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        long ownersInCity = OwnerCities.countInCity(ownerRepository, owner.getCity());
+        owner.setCapacityWarning(
+                ownersInCity >= WARNING_THRESHOLD && ownersInCity < OwnerCities.CITY_CAPACITY);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCities.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCities.java
new file mode 100644
index 000000000..68e486ee7
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCities.java
@@ -0,0 +1,32 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Per-city capacity rules for owner registration.
+ *
+ * <p>Each city has a hard limit on how many owners it may hold. The count defined here is the single
+ * source of truth shared by {@link CheckOwnerCityCapacity} (which hard-rejects once the city is at
+ * {@link #CITY_CAPACITY}) and {@link FlagOwnerCapacityWarning} (which flags when the city is in the
+ * approaching-capacity band just below it), so the limit and the warning band cannot drift apart.
+ */
+public final class OwnerCities {
+
+    /** Maximum number of owners permitted per city; the next owner is rejected at this count. */
+    public static final int CITY_CAPACITY = 50;
+
+    private OwnerCities() {
+    }
+
+    /**
+     * The number of owners already registered in the given city. Single source of truth for the
+     * per-city count, shared by the capacity reject and the capacity-warning rules so their counts
+     * cannot drift apart; each rule keeps only its own threshold and action. Counts persisted owners
+     * only, so a step calling this before {@code SaveOwner} does not count the owner being created.
+     */
+    public static long countInCity(OwnerRepository ownerRepository, String city) {
+        return ownerRepository.findAll().stream()
+                .filter(existing -> city != null && city.equals(existing.getCity()))
+                .count();
+    }
+}
