index 000000000..4dd726027
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagCityCapacityWarning.java
@@ -0,0 +1,28 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Flags a city approaching its capacity limit on create: sets the owner's
+ * {@code capacityWarning} to {@code true} when the owner's city already contains
+ * between 40 and 49 existing owners (inclusive) — approaching the hard capacity limit
+ * of 50 — otherwise {@code false}. Shares the city-matching predicate with
+ * {@link RejectCityAtCapacity} via {@link OwnerCityCount}.
+ *
+ * <p>Runs before {@link SaveOwner}, so the owner being created is not counted, and
+ * after {@link RejectCityAtCapacity}, which has already escalated a 409 for any city at
+ * (or over) 50 — so by the time this step runs the count is at most 49.
+ */
+public class FlagCityCapacityWarning {
+
+    private static final int WARN_THRESHOLD = 40;
+
+    private static final int CITY_CAPACITY = 50;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        long count = OwnerCityCount.sharingCity(ownerRepository, owner.getCity());
+        owner.setCapacityWarning(count >= WARN_THRESHOLD && count < CITY_CAPACITY);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCityCount.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCityCount.java
new file mode 100644
index 000000000..794a1ecd6
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCityCount.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Single home for "how many owners already live in a given city". Both
+ * {@link RejectCityAtCapacity} and {@link FlagCityCapacityWarning} key off this count
+ * at different thresholds; keeping the matching predicate here avoids maintaining it in
+ * two places.
+ */
+final class OwnerCityCount {
+
+    private OwnerCityCount() {
+    }
+
+    /**
+     * Counts existing owners in {@code city}, comparing cities case-insensitively on
+     * their trimmed value (a null owner city never matches). Called before the new
+     * owner is saved, so it is not itself counted.
+     */
+    static long sharingCity(OwnerRepository ownerRepository, String city) {
+        String target = city == null ? "" : city.trim();
+        return ownerRepository.findAll().stream()
+                .filter(existing -> existing.getCity() != null
+                        && target.equalsIgnoreCase(existing.getCity().trim()))
+                .count();
+    }
+}
