new file mode 100644
index 000000000..793144d12
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssessCityCapacity.java
@@ -0,0 +1,25 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns the owner's {@code capacityWarning}: {@code true} when the owner's city already
+ * holds between {@link CityCapacity#WARNING_THRESHOLD} and
+ * {@link CityCapacity#CITY_CAPACITY}-1 owners (inclusive), i.e. it is approaching the hard
+ * capacity limit, otherwise {@code false}. The count comes from
+ * {@link CityCapacity#countInCity} — the same single source of truth the hard rejection in
+ * {@link EnsureCityCapacity} uses, so the warning and the rejection cannot drift apart. The
+ * count is over the existing owners (the new owner is not yet saved); since
+ * {@link EnsureCityCapacity} runs earlier in the pipeline and rejects at the limit, by the
+ * time this step runs the count is always below it.
+ */
+public class AssessCityCapacity {
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        long inCity = CityCapacity.countInCity(ownerRepository, owner.getCity());
+        owner.setCapacityWarning(
+            inCity >= CityCapacity.WARNING_THRESHOLD && inCity < CityCapacity.CITY_CAPACITY);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CityCapacity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CityCapacity.java
new file mode 100644
index 000000000..8af5d84fa
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CityCapacity.java
@@ -0,0 +1,34 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * City-capacity helper for owner registration. Single source of truth for "how many
+ * owners are in a city" and the hard capacity limit, so the two halves of the rule —
+ * the hard rejection at the limit ({@link EnsureCityCapacity}) and the approaching-limit
+ * warning ({@link AssessCityCapacity}) — cannot drift apart. A city may hold up to
+ * {@link #CITY_CAPACITY} owners; the final 10 places below it are the warning band.
+ */
+final class CityCapacity {
+
+    /** The maximum number of owners a city may hold; creation is rejected at or above it. */
+    static final int CITY_CAPACITY = 50;
+
+    /** The lower bound (inclusive) of the warning band: at or above this, below the limit. */
+    static final int WARNING_THRESHOLD = 40;
+
+    private CityCapacity() {
+    }
+
+    /**
+     * Counts the existing owners whose city equals {@code city}, matching cities by exact
+     * value. The single source of truth for "how many owners are in a city", so the hard
+     * rejection and the capacity warning count the same way. The count is over the existing
+     * owners (a new owner being created is not yet saved).
+     */
+    static long countInCity(OwnerRepository ownerRepository, String city) {
+        return ownerRepository.findAll().stream()
+            .filter(existing -> city != null && city.equals(existing.getCity()))
+            .count();
+    }
+}
