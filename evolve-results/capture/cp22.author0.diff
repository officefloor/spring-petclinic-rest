diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeriveOwnerBulkSignupWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeriveOwnerBulkSignupWarning.java
new file mode 100644
index 000000000..16b97f1d5
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeriveOwnerBulkSignupWarning.java
@@ -0,0 +1,28 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Derives the owner's {@code bulkSignupWarning} at response time: {@code true} when more than
+ * {@value #BULK_THRESHOLD} owners have already been created on this owner's registration day,
+ * otherwise {@code false}. The day is counted by {@link Owner#getRegistrationDate()} — the same
+ * per-business-day accumulation the daily-limit rule uses (see {@link CheckOwnerDailyLimit}) — so
+ * the warning tracks the same population that the daily cap governs. The flag is transient and set
+ * on the in-flight owner so the responder carries it; it is not persisted.
+ */
+public class DeriveOwnerBulkSignupWarning {
+
+    static final int BULK_THRESHOLD = 80;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        LocalDate day = owner.getRegistrationDate();
+        long registeredThatDay = ownerRepository.findAll().stream()
+                .filter(existing -> day != null && day.equals(existing.getRegistrationDate()))
+                .count();
+        owner.setBulkSignupWarning(registeredThatDay > BULK_THRESHOLD);
+    }
+}
