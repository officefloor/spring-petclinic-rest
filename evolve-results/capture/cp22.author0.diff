diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckBulkSignup.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckBulkSignup.java
new file mode 100644
index 000000000..b29235784
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckBulkSignup.java
@@ -0,0 +1,38 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Runs just before the responder on both {@code GET /api/owners/{ownerId}} and {@code POST /api/owners}.
+ * Computes the {@code bulkSignupWarning} flag carried on the owner response: it is {@code true} once more
+ * than {@value #BULK_SIGNUP_THRESHOLD} owners have already been created for this owner's effective
+ * (business-day) registration date, otherwise {@code false}.
+ *
+ * <p>The count mirrors the per-day create-limit rule (see {@link CheckOwnerDailyLimit}): it counts owners
+ * whose {@code registrationDate} equals this owner's, excluding the owner itself, so on a create it
+ * reflects the owners already created that day and on a read it reflects the other owners sharing the day.
+ */
+public class CheckBulkSignup {
+
+    /** More than this many owners already created for the day raises the warning. */
+    static final int BULK_SIGNUP_THRESHOLD = 80;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository, Out<Boolean> bulkSignupWarning) {
+        LocalDate day = owner.getRegistrationDate();
+        int count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (owner.getId() != null && owner.getId().equals(existing.getId())) {
+                continue; // do not count the owner against itself
+            }
+            if (day != null && day.equals(existing.getRegistrationDate())) {
+                count++;
+            }
+        }
+        bulkSignupWarning.set(count > BULK_SIGNUP_THRESHOLD);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RespondWithOwner.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RespondWithOwner.java
