diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignBulkSignupWarning.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignBulkSignupWarning.java
new file mode 100644
index 000000000..d09a2bf64
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignBulkSignupWarning.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Assigns the owner's {@code bulkSignupWarning}: true when more than 80 owners have
+ * already been registered on this owner's registration date, otherwise false. The count
+ * uses {@link Owner#getRegistrationDate()} against the resolved registration date, the
+ * same per-day accumulation the daily-registration-limit rule counts. Runs before the
+ * owner is saved, so the count excludes the owner being created; the flag is stamped on
+ * the owner so it is persisted and returned on read, and never changes afterwards.
+ */
+public class AssignBulkSignupWarning {
+
+    /** Threshold above which a create is flagged as part of a bulk signup. */
+    private static final int BULK_SIGNUP_THRESHOLD = 80;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        int count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (owner.getRegistrationDate().equals(existing.getRegistrationDate())) {
+                count++;
+            }
+        }
+        owner.setBulkSignupWarning(count > BULK_SIGNUP_THRESHOLD);
+    }
+}
