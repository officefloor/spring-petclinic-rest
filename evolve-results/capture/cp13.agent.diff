+package org.springframework.samples.petclinic.service;
+
+import java.util.Collection;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * Counts existing owners that are namesakes of a given owner: identical first name and
+ * last name compared case-insensitively.
+ */
+public final class NamesakeCounter {
+
+    private NamesakeCounter() {
+    }
+
+    public static int count(Collection<Owner> existing, Owner owner) {
+        String firstName = owner.getFirstName();
+        String lastName = owner.getLastName();
+        return (int) existing.stream()
+            .filter(o -> firstName.equalsIgnoreCase(o.getFirstName())
+                && lastName.equalsIgnoreCase(o.getLastName()))
+            .count();
+    }
+}
