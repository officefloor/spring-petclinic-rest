diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/NamesakeCounter.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/NamesakeCounter.java
new file mode 100644
index 000000000..31193a77e
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/NamesakeCounter.java
@@ -0,0 +1,53 @@
