diff --git a/src/main/java/org/springframework/samples/petclinic/service/NamesakeCounter.java b/src/main/java/org/springframework/samples/petclinic/service/NamesakeCounter.java
new file mode 100644
index 000000000..8285a868e
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/service/NamesakeCounter.java
@@ -0,0 +1,46 @@
+/*
