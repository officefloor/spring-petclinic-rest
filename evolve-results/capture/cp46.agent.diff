+/**
+ * Soft-deletes the owner: flags it {@code deleted = true} and persists the change, retaining the
+ * row. The owner stays readable through {@code GET /api/owners/{id}} (with {@code deleted = true}),
+ * and the create endpoint's duplicate/identity checks ignore owners flagged deleted.
+ */
 public class DeleteOwner {
 
     public void service(@Val Owner owner, OwnerRepository ownerRepository) {
-        ownerRepository.delete(owner);
+        owner.setDeleted(true);
+        ownerRepository.save(owner);
     }
 }
