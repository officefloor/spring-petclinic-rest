diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeleteOwner.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeleteOwner.java
index c467081f..d184ba28 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeleteOwner.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DeleteOwner.java
@@ -4,9 +4,15 @@ import net.officefloor.plugin.variable.Val;
 import org.springframework.samples.petclinic.model.Owner;
 import org.springframework.samples.petclinic.repository.OwnerRepository;
 
+/**
+ * Soft-deletes an owner: flags {@code deleted} true and re-saves, retaining the row so
+ * {@code GET /api/owners/{id}} still returns the owner (now with {@code deleted} true). The
+ * create endpoint's duplicate/identity checks ignore owners flagged deleted.
+ */
 public class DeleteOwner {
 
     public void service(@Val Owner owner, OwnerRepository ownerRepository) {
-        ownerRepository.delete(owner);
+        owner.setDeleted(Boolean.TRUE);
+        ownerRepository.save(owner);
     }
 }
