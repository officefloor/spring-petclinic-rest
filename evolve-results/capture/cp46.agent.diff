diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateCandidates.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateCandidates.java
new file mode 100644
index 000000000..478bf58b1
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/DuplicateCandidates.java
@@ -0,0 +1,25 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * The visibility rule shared by the create endpoint's duplicate and identity checks: a soft-deleted
+ * owner (see {@link Owner#isDeleted()}) is no longer a match candidate, so both
+ * {@link RequireUniqueIdentity} (identity/household duplicate) and {@link AssignOwnerPossibleDuplicate}
+ * (soft-match flagging) skip it. Keeping the rule in one place means the two scans that make up the
+ * create endpoint's duplicate handling cannot drift apart.
+ *
+ * <p>Deliberately narrow: this applies only to duplicate/identity matching, not to every scan over
+ * existing owners. {@code findById} is unaffected, so {@code GET /api/owners/{id}} still returns a
+ * soft-deleted owner, and quota/derived-value scans keep their own (unchanged) semantics.
+ */
+final class DuplicateCandidates {
+
+    private DuplicateCandidates() {
+    }
+
+    /** Whether an existing owner counts as a candidate for duplicate/identity matching. */
+    static boolean isCandidate(Owner existing) {
+        return !existing.isDeleted();
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireUniqueIdentity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireUniqueIdentity.java
index aa6a4b5b8..327f92b60 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireUniqueIdentity.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireUniqueIdentity.java
@@ -32,6 +32,9 @@ public class RequireUniqueIdentity {
         boolean sharesHousehold = Boolean.TRUE.equals(owner.getSharesHousehold());
         String candidate = IdentityKey.of(owner.getTelephone(), owner.getEmail(), householdId);
         for (Owner existing : ownerRepository.findAll()) {
+            if (!DuplicateCandidates.isCandidate(existing)) {
+                continue; // a soft-deleted owner no longer blocks a duplicate or identity match
+            }
             if (candidate.equals(IdentityKey.ofOwner(existing))) {
                 throw new DuplicateIdentityException(candidate);
             }
