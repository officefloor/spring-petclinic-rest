diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagRisk.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagRisk.java
new file mode 100644
index 000000000..57a542ed8
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/FlagRisk.java
@@ -0,0 +1,71 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Computes this owner's overall {@code riskFlag} response field, on both the create and read pipelines.
+ *
+ * <p>The flag is {@code true} when <em>any</em> of three soft risk signals hold, otherwise {@code false}:
+ * <ul>
+ * <li>the owner is a {@link Owner#getPossibleDuplicate() possible duplicate} (a soft near-match of another
+ * owner, as decided earlier by {@link FlagPossibleDuplicate});</li>
+ * <li>the email domain is <em>disposable-adjacent</em> — see {@link #isDisposableAdjacent(String)};</li>
+ * <li>the city is over its soft capacity — it holds at least {@link FlagCityCapacityWarning#WARNING_THRESHOLD}
+ * owners (the per-city soft limit, below the hard {@link CheckCityCapacity#CAPACITY} cap).</li>
+ * </ul>
+ *
+ * <p>A roll-up of signals that are themselves computed per request; it is therefore also computed per
+ * request, mutated onto the loaded owner in place, and not persisted. Runs after the individual flag steps
+ * so {@code possibleDuplicate} is already set.
+ */
+public class FlagRisk {
+
+    /**
+     * The second-level labels of the hard {@link ValidateNewOwner#DISPOSABLE_DOMAINS disposable blocklist}
+     * (e.g. {@code mailinator}, {@code tempmail}, {@code guerrillamail}), derived so the adjacency rule
+     * tracks that single source. A domain is disposable-<em>adjacent</em> when its own second-level label
+     * matches one of these — which catches both subdomains of a blocked provider
+     * ({@code inbox.mailinator.com}) and look-alikes under another TLD ({@code mailinator.net}). The exact
+     * blocklisted domains are already rejected (400) before an owner is persisted, so they never reach here.
+     */
+    static final Set<String> DISPOSABLE_BASES = ValidateNewOwner.DISPOSABLE_DOMAINS.stream()
+            .map(FlagRisk::secondLevelLabel)
+            .collect(Collectors.toUnmodifiableSet());
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        boolean possibleDuplicate = Boolean.TRUE.equals(owner.getPossibleDuplicate());
+        boolean disposableAdjacentEmail = isDisposableAdjacent(owner.getEmail());
+        boolean overSoftCapacity = OwnerCity.countInCity(owner.getCity(), ownerRepository)
+                >= FlagCityCapacityWarning.WARNING_THRESHOLD;
+
+        owner.setRiskFlag(possibleDuplicate || disposableAdjacentEmail || overSoftCapacity);
+    }
+
+    /**
+     * Whether {@code email}'s domain is disposable-adjacent: its second-level label matches that of a known
+     * disposable provider (see {@link #DISPOSABLE_BASES}). A null or blank email is not adjacent.
+     */
+    static boolean isDisposableAdjacent(String email) {
+        if (email == null || email.isBlank()) {
+            return false;
+        }
+        String domain = email.substring(email.lastIndexOf('@') + 1).toLowerCase(Locale.ROOT);
+        return DISPOSABLE_BASES.contains(secondLevelLabel(domain));
+    }
+
+    /**
+     * The label immediately to the left of a domain's final dot (its second-level label): {@code mailinator}
+     * for both {@code mailinator.com} and {@code inbox.mailinator.com}. A domain with no dot is returned as
+     * is.
+     */
+    private static String secondLevelLabel(String domain) {
+        String[] labels = domain.split("\\.");
+        return labels.length >= 2 ? labels[labels.length - 2] : domain;
+    }
+}
