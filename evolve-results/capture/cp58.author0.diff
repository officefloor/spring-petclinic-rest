+    /**
+     * Whether the address's domain is <em>disposable-adjacent</em>: it shares its registrable
+     * (second-level) name with a known {@link #DISPOSABLE_DOMAINS disposable} provider — for
+     * instance a subdomain of one ({@code x.mailinator.com}) or the same name under a different TLD
+     * ({@code mailinator.net}) — so it is in the same throwaway-email family without being an
+     * exactly blocked disposable domain (those are rejected outright at creation). A blank or
+     * malformed address, or a plain mainstream domain, is not adjacent.
+     */
+    static boolean isDisposableAdjacent(String value) {
+        if (value == null) {
+            return false;
+        }
+        int at = value.lastIndexOf('@');
+        if (at < 0) {
+            return false;
+        }
+        String domain = value.substring(at + 1).toLowerCase(Locale.ROOT);
+        if (domain.isEmpty()) {
+            return false;
+        }
+        return DISPOSABLE_BASES.contains(baseLabel(domain));
+    }
+
     static String normalize(String value) {
         return value == null ? null : value.toLowerCase(Locale.ROOT);
     }
+
+    /**
+     * The registrable (second-level) label of a dotted domain — the label immediately before the
+     * public suffix, e.g. "mailinator" for "mailinator.com" and for "mail.mailinator.com". A domain
+     * with no dot yields itself.
+     */
+    private static String baseLabel(String domain) {
+        String[] labels = domain.split("\\.");
+        return labels.length >= 2 ? labels[labels.length - 2] : domain;
+    }
 }
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerRiskFlag.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerRiskFlag.java
new file mode 100644
index 000000000..57a1ae878
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerRiskFlag.java
@@ -0,0 +1,31 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * Single source of truth for an owner's derived {@code riskFlag} — a soft review signal raised when
+ * an owner is worth a second look even though it was accepted at creation.
+ *
+ * <p>The flag is {@code true} when ANY of the following hold, and {@code false} otherwise:
+ * <ul>
+ *   <li>the owner is a possible duplicate ({@link Owner#getPossibleDuplicate possibleDuplicate});</li>
+ *   <li>the owner's email domain is {@link OwnerEmail#isDisposableAdjacent disposable-adjacent};</li>
+ *   <li>the owner's city is over its soft capacity
+ *       ({@link Owner#getCapacityWarning capacityWarning}).</li>
+ * </ul>
+ *
+ * <p>Derived at read time by the owner mapper from the already-stored flags and email, so it needs
+ * no column of its own and can never drift from its inputs.
+ */
+public final class OwnerRiskFlag {
+
+    private OwnerRiskFlag() {
+    }
+
+    /** The risk flag for the given owner. */
+    public static boolean riskFlag(Owner owner) {
+        return Boolean.TRUE.equals(owner.getPossibleDuplicate())
+                || Boolean.TRUE.equals(owner.getCapacityWarning())
+                || OwnerEmail.isDisposableAdjacent(owner.getEmail());
+    }
+}
