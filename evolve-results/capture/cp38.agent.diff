+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner's email is present but its domain is on the disposable-domain
+ * blocklist. Carries the rejected input so it can be logged.
+ */
+public class DisposableEmailDomainException extends RuntimeException {
+
+    /** Name of the offending field, used to build the error response. */
+    public static final String FIELD = "email";
+
+    public DisposableEmailDomainException(String rejectedValue) {
+        super("Email domain must not be a disposable-domain provider, but was: " + rejectedValue);
+    }
+}
