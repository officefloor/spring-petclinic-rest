+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a supplied email's domain is on the disposable-domain blocklist
+ * (mailinator.com, tempmail.com, guerrillamail.com). One of the field-level
+ * {@link InvalidOwnerFieldException} rules, handled by {@link ExceptionControllerAdvice} as a
+ * 400 Bad Request.
+ */
+public class DisposableEmailException extends InvalidOwnerFieldException {
+
+    public DisposableEmailException(String message) {
+        super(message, "The supplied email uses a disposable email domain");
+    }
+}
