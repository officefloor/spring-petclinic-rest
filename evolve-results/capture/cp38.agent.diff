+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Raised when an owner payload supplies an {@code email} whose domain is on the disposable-domain
+ * blocklist (e.g. mailinator.com). Carries the offending domain so the API can report the rejection
+ * back to the client.
+ */
+public class DisposableEmailDomainException extends RuntimeException {
+
+    private final String domain;
+
+    public DisposableEmailDomainException(String domain) {
+        super("Email domain is on the disposable-domain blocklist: '" + domain + "'");
+        this.domain = domain;
+    }
+
+    public String getDomain() {
+        return this.domain;
+    }
+}
