+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner's email address uses a domain on the disposable-domain blocklist
+ * ({@code mailinator.com}, {@code tempmail.com}, {@code guerrillamail.com}). Reported as a
+ * {@code 400 Bad Request} by the {@link ExceptionControllerAdvice}.
+ */
+public class DisposableEmailException extends RuntimeException {
+
+    public DisposableEmailException(String message) {
+        super(message);
+    }
+}
