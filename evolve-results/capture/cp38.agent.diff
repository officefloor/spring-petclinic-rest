@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Raised when an owner request carries an {@code email} whose domain is on the
+ * disposable-domain blocklist (mailinator.com, tempmail.com, guerrillamail.com). The
+ * address is syntactically valid, so this is a policy rejection distinct from
+ * {@link InvalidEmailException}. Carries the offending value so the handler can report
+ * what was seen.
+ */
+public class DisposableEmailDomainException extends Exception {
+
+    private final String email;
+
+    public DisposableEmailDomainException(String email) {
+        super("Email domain is not accepted (disposable address): '" + email + "'");
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return email;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DisposableEmailDomainHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DisposableEmailDomainHandler.java
new file mode 100644
index 00000000..8ef8ba45
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DisposableEmailDomainHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Turns a {@link DisposableEmailDomainException} into a 400 naming {@code email} in the
+ * body's {@code errors} array, mirroring the shape of the other owner field responses.
+ */
+public class DisposableEmailDomainHandler {
+
+    public void handle(@Parameter DisposableEmailDomainException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.BAD_REQUEST,
+                "The request contains invalid or missing parameters");
+        detail.setProperty("errors", java.util.List.of("email"));
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckEmailDomainAllowed.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CheckEmailDomainAllowed.java
