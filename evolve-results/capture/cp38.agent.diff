+package org.springframework.samples.petclinic.service;
+
+/**
+ * Thrown when an owner is created with an email whose domain is on the disposable-domain
+ * blocklist. Signals a bad request rather than a conflict with existing data.
+ */
+public class DisposableEmailDomainException extends RuntimeException {
+
+    public DisposableEmailDomainException(String email) {
+        super("Email '" + email + "' uses a disposable-domain that is not allowed");
+    }
+}
