+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Signals that an owner request supplied an email address whose domain is on the
+ * disposable-domain blocklist.
+ *
+ * <p>Handled as a 400 Bad Request, reporting {@code email} as the offending field.
+ */
+public class DisposableEmailDomainException extends RuntimeException {
+
+    public DisposableEmailDomainException(String domain) {
+        super("Email domain is not accepted: " + domain);
+    }
+}
