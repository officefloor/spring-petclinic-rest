+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Raised when an owner's email domain is on the disposable-domain blocklist (see
+ * {@link DisposableEmailValidator}), so the client can be told the address is not accepted.
+ */
+public class DisposableEmailException extends RuntimeException {
+
+    private final String email;
+
+    public DisposableEmailException(String email) {
+        super("Email address uses a disposable domain: " + email);
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
