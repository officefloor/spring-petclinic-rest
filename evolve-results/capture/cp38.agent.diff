+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Raised when an owner submitted to the create endpoint carries an {@code email} whose domain is on
+ * the disposable-domain blocklist ({@code mailinator.com}, {@code tempmail.com},
+ * {@code guerrillamail.com}). Syntactic validity of the address is enforced separately by Bean
+ * Validation's {@code @Email} constraint; this rejects an otherwise well-formed address that uses a
+ * throwaway mail provider. The {@code ExceptionControllerAdvice} renders it as a 400 response naming
+ * the {@code email} field.
+ */
+public class DisposableEmailDomainException extends RuntimeException {
+
+    private final String email;
+
+    public DisposableEmailDomainException(String email) {
+        super("Email '" + email + "' uses a disposable domain that is not accepted");
+        this.email = email;
+    }
+
+    /**
+     * @return the rejected email
+     */
+    public String getEmail() {
+        return this.email;
+    }
+}
