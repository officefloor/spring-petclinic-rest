@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Flags a bulk signup on create: sets the owner's {@code bulkSignupWarning} to
+ * {@code true} when more than 80 owners already share the new owner's
+ * (business-day-adjusted) registration date, as counted by
+ * {@link Owner#getRegistrationDate()}, otherwise {@code false}. Runs before
+ * {@link SaveOwner}, so the owner being created is not counted — the same
+ * accumulation path as {@link RejectOverDailyLimit}, at a lower threshold.
+ */
+public class FlagBulkSignup {
+
+    private static final int BULK_THRESHOLD = 80;
+
+    public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        long count = OwnerDailyCount.sharingRegistrationDate(ownerRepository, owner.getRegistrationDate());
+        owner.setBulkSignupWarning(count > BULK_THRESHOLD);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerDailyCount.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerDailyCount.java
new file mode 100644
index 000000000..ea409b9e5
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerDailyCount.java
@@ -0,0 +1,29 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Single home for "how many owners were created on a given (business-day-adjusted)
+ * registration date". Both {@link RejectOverDailyLimit} and {@link FlagBulkSignup}
+ * key off this count at different thresholds; keeping the predicate here avoids
+ * maintaining it in two places.
+ */
+final class OwnerDailyCount {
+
+    private OwnerDailyCount() {
+    }
+
+    /**
+     * Counts existing owners whose {@link Owner#getRegistrationDate()} equals
+     * {@code registrationDate}. Called before the new owner is saved, so it is not
+     * itself counted.
+     */
+    static long sharingRegistrationDate(OwnerRepository ownerRepository, LocalDate registrationDate) {
+        return ownerRepository.findAll().stream()
+                .filter(existing -> registrationDate.equals(existing.getRegistrationDate()))
+                .count();
+    }
+}
