--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/AssignBulkSignupWarning.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * Assigns the owner's {@code bulkSignupWarning}: true when more than 80 owners have
+ * already been registered on this owner's registration date, otherwise false. Reads the
+ * per-day total published by {@link CountDailyRegistrations} — the same accumulation the
+ * daily-registration-limit rule checks — which is taken before the owner is saved, so the
+ * count excludes the owner being created. The flag is stamped on the owner so it is
+ * persisted and returned on read, and never changes afterwards.
+ */
+public class AssignBulkSignupWarning {
+
+    /** Threshold above which a create is flagged as part of a bulk signup. */
+    private static final int BULK_SIGNUP_THRESHOLD = 80;
+
+    public void service(@Val Owner owner, @Val Integer dailyRegistrationCount) {
+        owner.setBulkSignupWarning(dailyRegistrationCount > BULK_SIGNUP_THRESHOLD);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CountDailyRegistrations.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CountDailyRegistrations.java
new file mode 100644
index 000000000..6c1ead32d
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/CountDailyRegistrations.java
@@ -0,0 +1,30 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.time.LocalDate;
+
+import net.officefloor.plugin.variable.Out;
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Counts the owners already registered on the resolved registration date (see
+ * {@link ResolveRegistrationDate}) and publishes the total so the per-day rules share a
+ * single accumulation. Runs before the owner is saved, so the count excludes the owner
+ * being created; both {@link EnsureDailyRegistrationLimit} and
+ * {@link AssignBulkSignupWarning} read the published value rather than re-scanning the
+ * table.
+ */
+public class CountDailyRegistrations {
+
+    public void service(@Val LocalDate registrationDate, OwnerRepository ownerRepository,
+            Out<Integer> dailyRegistrationCount) {
+        int count = 0;
+        for (Owner existing : ownerRepository.findAll()) {
+            if (registrationDate.equals(existing.getRegistrationDate())) {
+                count++;
+            }
+        }
+        dailyRegistrationCount.set(count);
+    }
+}
