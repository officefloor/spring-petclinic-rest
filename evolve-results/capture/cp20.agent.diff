+    private static String areaCode(String telephone) {
+        String digits = OwnerTelephones.digitsOnly(telephone);
+        if (digits == null || digits.length() < AREA_CODE_LENGTH) {
+            return null;
+        }
+        return digits.substring(0, AREA_CODE_LENGTH);
     }
