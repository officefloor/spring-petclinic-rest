diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerRegistrationDate.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerRegistrationDate.java
