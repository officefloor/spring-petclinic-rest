@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when an owner's address is blank after normalization (trim, collapse whitespace,
+ * upper-case and expand abbreviations). The required-field check runs against the
+ * normalized form, so a value made up only of whitespace no longer satisfies it. Handled
+ * globally by {@link BlankAddressExceptionHandler}, which responds 400.
+ */
+public class BlankAddressException extends Exception {
+
+    private final String rejectedValue;
+
+    public BlankAddressException(String rejectedValue) {
+        super("Address is required and must not be blank after normalization");
+        this.rejectedValue = rejectedValue;
+    }
+
+    /** The original address value that was blank after normalization. */
+    public String getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/BlankAddressExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/BlankAddressExceptionHandler.java
new file mode 100644
index 000000000..0e9f0c9be
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/BlankAddressExceptionHandler.java
@@ -0,0 +1,20 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.Objects;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class BlankAddressExceptionHandler {
+
+    public void handle(@Parameter BlankAddressException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.BAD_REQUEST, ex.getMessage());
+        detail.setProperty("field", "address");
+        detail.setProperty("rejectedValue", Objects.toString(ex.getRejectedValue(), "null"));
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(detail));
+    }
+}
