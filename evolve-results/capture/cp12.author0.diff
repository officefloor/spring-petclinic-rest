@@ -0,0 +1,24 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.rest.escalation.InvalidAddressException;
+
+/**
+ * Normalizes the submitted address on create via {@link OwnerAddresses} (trim and collapse
+ * whitespace, upper-case, expand common abbreviations). The normalized value is written
+ * back onto the request in place (the {@code @Val} object is shared with later steps) so
+ * downstream steps store, compare and return it. An address that is blank after
+ * normalization is rejected with 400 via {@link InvalidAddressException}.
+ */
+public class NormalizeOwnerAddress {
+
+    public void service(@Val OwnerFieldsDto request) throws InvalidAddressException {
+        String address = request.getAddress();
+        String normalized = OwnerAddresses.normalize(address);
+        if (normalized == null || normalized.isEmpty()) {
+            throw new InvalidAddressException(address);
+        }
+        request.setAddress(normalized);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerAddresses.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerAddresses.java
new file mode 100644
index 000000000..efa3c2e91
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerAddresses.java
@@ -0,0 +1,52 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Single source of truth for what a "normalized" owner address is. Used by
+ * {@link NormalizeOwnerAddress} when storing and returning the value, and by
+ * {@link Households} when comparing addresses for household duplicate detection and the
+ * shared household id, so the rule cannot drift between storing and comparing.
+ *
+ * <p>The rule: the value is trimmed, runs of whitespace are collapsed to a single space
+ * and the whole value is upper-cased; then each whitespace-separated token that is a
+ * common street-type abbreviation is expanded to its full form ({@code ST -> STREET},
+ * {@code RD -> ROAD}, {@code AVE -> AVENUE}). The result is the canonical address;
+ * it is empty when the input was blank (only whitespace).
+ */
+final class OwnerAddresses {
+
+    /** Common street-type abbreviations expanded to their full upper-case form. */
+    private static final Map<String, String> ABBREVIATIONS = Map.of(
+            "ST", "STREET",
+            "RD", "ROAD",
+            "AVE", "AVENUE");
+
+    private OwnerAddresses() {
+    }
+
+    /**
+     * Returns the normalized form of {@code address}: trimmed, whitespace collapsed,
+     * upper-cased and with common abbreviations expanded. Returns {@code null} for a
+     * {@code null} input and an empty string for an input that is blank after trimming.
+     */
+    static String normalize(String address) {
+        if (address == null) {
+            return null;
+        }
+        String collapsed = address.trim().replaceAll("\\s+", " ").toUpperCase(Locale.ROOT);
+        if (collapsed.isEmpty()) {
+            return "";
+        }
+        String[] tokens = collapsed.split(" ");
+        StringBuilder sb = new StringBuilder(collapsed.length());
+        for (int i = 0; i < tokens.length; i++) {
+            if (i > 0) {
+                sb.append(' ');
+            }
+            sb.append(ABBREVIATIONS.getOrDefault(tokens[i], tokens[i]));
+        }
+        return sb.toString();
+    }
+}
