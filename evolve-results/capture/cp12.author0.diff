+    /**
+     * Normalize a postal address for storage so it is persisted and returned in a canonical
+     * form regardless of incidental formatting: the value is trimmed, every run of whitespace
+     * is collapsed to a single space, the result is upper-cased and common street-type
+     * abbreviations ({@code ST->STREET}, {@code RD->ROAD}, {@code AVE->AVENUE}) are expanded.
+     * It is idempotent, so re-normalizing a stored value yields the same value. {@code @Named}
+     * keeps this out of MapStruct's automatic method selection, so it only runs where a mapping
+     * explicitly references it via {@code qualifiedByName}.
+     */
+    @Named("normalizeAddress")
+    default String normalizeAddress(String address) {
+        if (address == null) {
+            return null;
+        }
+        String collapsed = address.trim().replaceAll("\\s+", " ").toUpperCase();
+        if (collapsed.isEmpty()) {
+            return collapsed;
+        }
+        String[] tokens = collapsed.split(" ");
+        StringBuilder sb = new StringBuilder(collapsed.length());
+        for (int i = 0; i < tokens.length; i++) {
+            if (i > 0) {
+                sb.append(' ');
+            }
+            sb.append(STREET_ABBREVIATIONS.getOrDefault(tokens[i], tokens[i]));
+        }
+        return sb.toString();
+    }
