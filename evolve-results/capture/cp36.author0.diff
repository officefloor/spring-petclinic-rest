@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by
+ * {@link org.springframework.samples.petclinic.rest.function.owner.CheckOwnerHouseholdUnique} when the
+ * owner being created would be a second member of an existing household — it shares an existing owner's
+ * {@code householdId} (derived from {@code lastName} and {@code postcode}) — without declaring that it
+ * shares the household via {@code sharesHousehold}. Handled by
+ * {@link OwnerHouseholdDuplicateExceptionHandler}, which responds 409.
+ */
+public class OwnerHouseholdDuplicateException extends Exception {
+
+    private final String householdId;
+
+    public OwnerHouseholdDuplicateException(String householdId) {
+        super("Owner belongs to an existing household: " + householdId);
+        this.householdId = householdId;
+    }
+
+    public String getHouseholdId() {
+        return this.householdId;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerHouseholdDuplicateExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerHouseholdDuplicateExceptionHandler.java
new file mode 100644
index 000000000..eae4815de
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerHouseholdDuplicateExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 409 with a JSON body whose {@code errors} array names {@code householdId} when the owner
+ * being created would be an undeclared second member of an existing household.
+ */
+public class OwnerHouseholdDuplicateExceptionHandler {
+
+    public void handle(@Parameter OwnerHouseholdDuplicateException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        Map<String, Object> body = Map.of("errors", List.of("householdId"));
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(body));
+    }
+}
