  * {@link PossibleDuplicate} rule: true, with the matching owner id, when this owner shares an
  * existing owner's last name and postcode with a different telephone; otherwise false with no
  * id. Mutates the loaded owner in place so the responder's mapper carries the flag onto the DTO.
+ *
+ * <p>A declared household member — an owner whose {@code householdId} is shared by another
+ * owner, only possible when it was created with {@code sharesHousehold} — is never a suspected
+ * duplicate, so its flag is forced false regardless of the soft match.
  */
 public class FlagPossibleDuplicate {
 
     public void service(@Val Owner owner, OwnerRepository ownerRepository) {
+        if (isDeclaredHouseholdMember(owner, ownerRepository)) {
+            owner.setPossibleDuplicate(false);
+            owner.setPossibleDuplicateOf(null);
+            return;
+        }
         Integer match = PossibleDuplicate.matchOf(owner, ownerRepository);
         owner.setPossibleDuplicate(match != null);
         owner.setPossibleDuplicateOf(match);
     }
+
+    /**
+     * Whether another owner already carries this owner's (non-blank) householdId. Because the
+     * duplicate gate rejects an undeclared second owner in a household, a shared householdId
+     * means this owner is a declared member.
+     */
+    private static boolean isDeclaredHouseholdMember(Owner owner, OwnerRepository ownerRepository) {
+        String householdId = owner.getHouseholdId();
+        if (householdId == null || householdId.isBlank()) {
+            return false;
+        }
+        for (Owner existing : ownerRepository.findAll()) {
+            if (owner.getId() != null && owner.getId().equals(existing.getId())) {
+                continue;
+            }
+            if (householdId.equals(existing.getHouseholdId())) {
+                return true;
+            }
+        }
+        return false;
+    }
 }
