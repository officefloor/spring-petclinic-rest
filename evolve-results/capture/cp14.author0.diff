+    /**
+     * Compute the owner's membership number, formatted {@code '<customerCode>-M<YY>'} where
+     * {@code YY} is the last two digits of the registration date's year (e.g. {@code 'SMI-0007-M26'}).
+     * Returns {@code null} when either the customer code or registration date is missing.
+     */
+    default String formatMembershipNumber(Owner owner) {
+        if (owner == null || owner.getCustomerCode() == null || owner.getRegistrationDate() == null) {
+            return null;
+        }
+        return String.format("%s-M%02d", owner.getCustomerCode(), owner.getRegistrationDate().getYear() % 100);
+    }
