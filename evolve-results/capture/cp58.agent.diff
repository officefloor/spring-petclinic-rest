diff --git a/src/main/java/org/springframework/samples/petclinic/service/DisposableEmailDomain.java b/src/main/java/org/springframework/samples/petclinic/service/DisposableEmailDomain.java
index d99660aad..936e5e415 100644
--- a/src/main/java/org/springframework/samples/petclinic/service/DisposableEmailDomain.java
+++ b/src/main/java/org/springframework/samples/petclinic/service/DisposableEmailDomain.java
@@ -25,4 +25,22 @@ public final class DisposableEmailDomain {
         }
         return email;
     }
+
+    /**
+     * True when the email's domain is disposable-adjacent: a subdomain of a known disposable
+     * provider (e.g. {@code inbox.mailinator.com}). Exactly-blocked domains are rejected at
+     * creation, so only these near-matches reach a saved owner. A {@code null} or domain-less
+     * email is not adjacent.
+     */
+    public static boolean isDisposableAdjacent(String email) {
+        if (email == null) {
+            return false;
+        }
+        int at = email.lastIndexOf('@');
+        if (at < 0) {
+            return false;
+        }
+        String domain = email.substring(at + 1).toLowerCase(Locale.ROOT);
+        return BLOCKED.stream().anyMatch(b -> domain.endsWith("." + b));
+    }
 }
