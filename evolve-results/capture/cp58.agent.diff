+package org.springframework.samples.petclinic.rest.controller;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.stereotype.Component;
+
+/**
+ * Decides whether an owner's email domain is <em>disposable-adjacent</em>: it belongs to a known
+ * disposable-email provider's family (a sibling TLD or a subdomain) without being an exact match
+ * that the hard {@link DisposableEmailDomainValidator} would already have rejected. Unlike that
+ * validator this never blocks creation; it only surfaces a soft signal.
+ */
+@Component
+public class DisposableEmailDomainEvaluator {
+
+    private final DisposableEmailDomains disposableEmailDomains;
+
+    public DisposableEmailDomainEvaluator(DisposableEmailDomains disposableEmailDomains) {
+        this.disposableEmailDomains = disposableEmailDomains;
+    }
+
+    /**
+     * @param owner the owner whose email is checked
+     * @return {@code true} when the owner has an email whose domain is disposable-adjacent,
+     *         {@code false} otherwise (including when the owner or its email is absent)
+     */
+    public boolean isDisposableAdjacent(Owner owner) {
+        if (owner == null) {
+            return false;
+        }
+        String domain = disposableEmailDomains.domainOf(owner.getEmail());
+        return disposableEmailDomains.isDisposableAdjacent(domain);
+    }
+}
