+package org.springframework.samples.petclinic.util;
+
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Helpers for an owner's {@code riskFlag}, the single boolean that flags an owner for review when any
+ * of a set of soft risk signals held at the time it was created.
+ */
+public final class RiskFlags {
+
+    /**
+     * Second-level domain labels of known disposable/throwaway email providers. A domain whose
+     * second-level label matches one of these but whose full domain is not itself on the hard
+     * disposable blocklist (those creates are rejected outright) is treated as "disposable-adjacent",
+     * e.g. {@code mailinator.net} or {@code tempmail.io}. Compared against the lower-cased domain.
+     */
+    private static final Set<String> DISPOSABLE_DOMAIN_LABELS = Set.of(
+        "mailinator", "tempmail", "guerrillamail");
+
+    private RiskFlags() {
+    }
+
+    /**
+     * Computes an owner's {@code riskFlag}: {@code true} when any of the risk signals hold, otherwise
+     * {@code false}. The signals are: the owner is a possible duplicate ({@code possibleDuplicate} is
+     * true), the owner's email domain is disposable-adjacent (see {@link #isDisposableAdjacent(String)}),
+     * or the owner's city was over its soft capacity ({@code capacityWarning} is true).
+     *
+     * @param possibleDuplicate whether the owner was flagged a possible (soft) duplicate on creation
+     * @param capacityWarning   whether the owner's city was over its soft capacity on creation
+     * @param email             the owner's normalized email, may be {@code null}
+     * @return {@code true} when any risk signal holds
+     */
+    public static boolean riskFlag(Boolean possibleDuplicate, Boolean capacityWarning, String email) {
+        return Boolean.TRUE.equals(possibleDuplicate)
+            || Boolean.TRUE.equals(capacityWarning)
+            || isDisposableAdjacent(email);
+    }
+
+    /**
+     * Whether an email domain is disposable-adjacent: its second-level label (the label immediately
+     * before the top-level label) matches a known disposable provider's, e.g. {@code mailinator.net}
+     * matches {@code mailinator}. A {@code null}, blank or malformed email (no domain) is not adjacent.
+     *
+     * @param email the owner's email, may be {@code null}
+     * @return {@code true} when the email's domain is disposable-adjacent
+     */
+    public static boolean isDisposableAdjacent(String email) {
+        if (email == null || email.isBlank()) {
+            return false;
+        }
+        int at = email.lastIndexOf('@');
+        if (at < 0 || at == email.length() - 1) {
+            return false;
+        }
+        String domain = email.substring(at + 1).toLowerCase(Locale.ROOT);
+        String[] labels = domain.split("\\.");
+        if (labels.length < 2) {
+            return false;
+        }
+        return DISPOSABLE_DOMAIN_LABELS.contains(labels[labels.length - 2]);
+    }
+}
