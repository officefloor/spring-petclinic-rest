+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.Objects;
+import java.util.Set;
+
+import org.aspectj.lang.annotation.AfterReturning;
+import org.aspectj.lang.annotation.Aspect;
+import org.springframework.http.ResponseEntity;
+import org.springframework.samples.petclinic.rest.dto.OwnerDto;
+import org.springframework.samples.petclinic.service.ClinicService;
+import org.springframework.stereotype.Component;
+
+/**
+ * Populates the read-only {@code riskFlag} on an owner response: {@code true} when any of three
+ * signals hold, otherwise {@code false}. The signals are a possible duplicate (a live owner shares
+ * this one's last name and postcode but has a different telephone), a disposable-adjacent email
+ * (the domain is, or is a subdomain of, a known disposable-mail provider), or a city that is over
+ * its soft capacity (already holds {@value #SOFT_CAPACITY} or more owners). Derived on the way out,
+ * so it never affects storage or the request.
+ */
+@Aspect
+@Component
+public class OwnerRiskFlagAdvice {
+
+    private static final Set<String> DISPOSABLE_DOMAINS = Set.of(
+        "mailinator.com", "tempmail.com", "guerrillamail.com");
+
+    private static final int SOFT_CAPACITY = 40;
+
+    private final ClinicService clinicService;
+
+    public OwnerRiskFlagAdvice(ClinicService clinicService) {
+        this.clinicService = clinicService;
+    }
+
+    @AfterReturning(pointcut = "execution(* org.springframework.samples.petclinic.rest.controller.v1."
+        + "OwnerRestControllerV1.addOwner(..)) || execution(* org.springframework.samples.petclinic.rest."
+        + "controller.v1.OwnerRestControllerV1.getOwner(..))", returning = "response")
+    public void addRiskFlag(ResponseEntity<?> response) {
+        Object body = response == null ? null : response.getBody();
+        if (!(body instanceof OwnerDto owner)) {
+            return;
+        }
+        owner.setRiskFlag(possibleDuplicate(owner) || disposableAdjacent(owner.getEmail())
+            || overSoftCapacity(owner.getCity()));
+    }
+
+    /** True when another live owner shares this owner's last name and postcode but has a different telephone. */
+    private boolean possibleDuplicate(OwnerDto owner) {
+        return clinicService.findAllOwners().stream()
+            .filter(existing -> !existing.isDeleted() && !Objects.equals(existing.getId(), owner.getId()))
+            .anyMatch(existing -> equalsIgnoreCase(existing.getLastName(), owner.getLastName())
+                && Objects.equals(existing.getPostcode(), owner.getPostcode())
+                && !Objects.equals(existing.getTelephone(), owner.getTelephone()));
+    }
+
+    /** True when the email's domain is, or is a subdomain of, a known disposable-mail provider. */
+    private static boolean disposableAdjacent(String email) {
+        int at = email == null ? -1 : email.lastIndexOf('@');
+        if (at < 0) {
+            return false;
+        }
+        String domain = email.substring(at + 1).toLowerCase();
+        return DISPOSABLE_DOMAINS.stream().anyMatch(d -> domain.equals(d) || domain.endsWith("." + d));
+    }
+
+    /** True when the owner's city already holds at least {@value #SOFT_CAPACITY} owners. */
+    private boolean overSoftCapacity(String city) {
+        String key = normalize(city);
+        if (key == null) {
+            return false;
+        }
+        long owners = clinicService.findAllOwners().stream()
+            .filter(existing -> key.equals(normalize(existing.getCity())))
+            .count();
+        return owners >= SOFT_CAPACITY;
+    }
+
+    private static boolean equalsIgnoreCase(String a, String b) {
+        return a != null && a.equalsIgnoreCase(b);
+    }
+
+    private static String normalize(String value) {
+        return value == null ? null : value.strip().replaceAll("\\s+", " ").toLowerCase();
+    }
+}
