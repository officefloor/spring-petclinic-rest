+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.rest.validation;
+
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * Derives an owner's risk flag from its stored state. An owner warrants review when any of these
+ * hold: it is flagged as a possible duplicate, its email domain is
+ * {@link DisposableEmailDomains#isAdjacent(String) disposable-adjacent}, or its city was over its
+ * soft capacity when it was created (the capacity warning). Otherwise it is not at risk.
+ */
+public final class OwnerRiskResolver {
+
+    private OwnerRiskResolver() {
+    }
+
+    /**
+     * @param owner the owner to assess
+     * @return {@code true} when the owner is a possible duplicate, has a disposable-adjacent email
+     *         domain, or carries a city capacity warning; otherwise {@code false}
+     */
+    public static boolean isAtRisk(Owner owner) {
+        return Boolean.TRUE.equals(owner.getPossibleDuplicate())
+            || Boolean.TRUE.equals(owner.getCapacityWarning())
+            || DisposableEmailDomains.isAdjacent(owner.getEmail());
+    }
+}
