+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner is created with a supplied {@code registrationDate} that
+ * falls later than the current server date. Handled by the REST
+ * {@code ExceptionControllerAdvice}, which translates it into a
+ * {@code 400 Bad Request} response.
+ */
+public class FutureRegistrationDateException extends RuntimeException {
+
+    public FutureRegistrationDateException(String message) {
+        super(message);
+    }
+}
