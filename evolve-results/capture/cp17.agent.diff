+package org.springframework.samples.petclinic.model;
+
+import java.util.Map;
+
+/**
+ * The fixed city-to-region lookup used to derive an owner's locality.
+ *
+ * <p>Maps each known city to its canonical region; any city not listed resolves to
+ * {@link #UNKNOWN}. This is the single source of truth for the mapping, so callers
+ * never repeat the table.
+ */
+public final class CityRegionTable {
+
+    /** The region returned for any city that is not in the table. */
+    public static final String UNKNOWN = "UNKNOWN";
+
+    private static final Map<String, String> CITY_TO_REGION = Map.of(
+        "Sydney", "NSW",
+        "Melbourne", "VIC",
+        "Brisbane", "QLD");
+
+    private CityRegionTable() {
+    }
+
+    /**
+     * Resolve the canonical region for the given city.
+     *
+     * @param city the owner's city
+     * @return the region string for a known city, or {@link #UNKNOWN} otherwise
+     */
+    public static String regionFor(String city) {
+        return CITY_TO_REGION.getOrDefault(city, UNKNOWN);
+    }
+}
