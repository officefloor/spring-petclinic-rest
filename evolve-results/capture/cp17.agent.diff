diff --git a/src/main/java/org/springframework/samples/petclinic/mapper/Localities.java b/src/main/java/org/springframework/samples/petclinic/mapper/Localities.java
new file mode 100644
index 000000000..dbd5b5071
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/mapper/Localities.java
@@ -0,0 +1,21 @@
+package org.springframework.samples.petclinic.mapper;
+
+import java.util.Map;
+
+/**
+ * Derives an owner's locality (region) from its city using a fixed
+ * city-to-region table. Cities not in the table resolve to "UNKNOWN".
+ */
+final class Localities {
+
+    private static final Map<String, String> CITY_REGION = Map.of(
+        "Sydney", "NSW", "Melbourne", "VIC", "Brisbane", "QLD");
+
+    private Localities() {
+    }
+
+    /** Canonical region for {@code city}, or "UNKNOWN" when it is not in the table. */
+    static String regionOf(String city) {
+        return CITY_REGION.getOrDefault(city, "UNKNOWN");
+    }
+}
