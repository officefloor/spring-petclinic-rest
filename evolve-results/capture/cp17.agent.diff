diff --git a/src/main/java/org/springframework/samples/petclinic/mapper/Localities.java b/src/main/java/org/springframework/samples/petclinic/mapper/Localities.java
new file mode 100644
index 000000000..76cac99e0
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/mapper/Localities.java
@@ -0,0 +1,23 @@
+package org.springframework.samples.petclinic.mapper;
+
+import java.util.Map;
+
+/**
+ * Derives an owner's {@code locality} (region) from its city using a fixed
+ * city-to-region table. Any city not in the table maps to {@code UNKNOWN}.
+ */
+public final class Localities {
+
+    private static final Map<String, String> CITY_REGION = Map.of(
+        "Sydney", "NSW",
+        "Melbourne", "VIC",
+        "Brisbane", "QLD");
+
+    private Localities() {
+    }
+
+    /** The canonical region for the given city, or {@code UNKNOWN} when unlisted. */
+    public static String forCity(String city) {
+        return CITY_REGION.getOrDefault(city, "UNKNOWN");
+    }
+}
