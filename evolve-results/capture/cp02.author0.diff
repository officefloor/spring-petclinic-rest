+    /**
+     * Normalize a telephone number submitted on create by stripping every non-digit
+     * character. The result is accepted only when it contains exactly 10 digits.
+     *
+     * @param rawTelephone the telephone value as supplied in the request
+     * @return the 10-digit telephone, or {@code null} when it is not exactly 10 digits
+     *         after stripping (the caller rejects the request with 400 in that case)
+     */
+    private static String normalizeTelephone(String rawTelephone) {
+        if (rawTelephone == null) {
+            return null;
+        }
+        String digits = rawTelephone.replaceAll("\\D", "");
+        return digits.length() == 10 ? digits : null;
+    }
