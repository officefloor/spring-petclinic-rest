@@ -99,6 +99,15 @@ public class OwnerRestControllerV1 implements OwnersApi {
     @PreAuthorize("hasRole(@roles.OWNER_ADMIN)")
     @Override
     public ResponseEntity<OwnerDto> addOwner(OwnerFieldsDto ownerFieldsDto) {
+        // Normalize the telephone on create: strip every non-digit character and
+        // require exactly 10 digits, otherwise reject the request as a bad request.
+        String telephone = ownerFieldsDto.getTelephone();
+        String normalizedTelephone = telephone == null ? "" : telephone.replaceAll("\\D", "");
+        if (normalizedTelephone.length() != 10) {
+            return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
+        }
+        ownerFieldsDto.setTelephone(normalizedTelephone);
+
         HttpHeaders headers = new HttpHeaders();
         Owner owner = ownerMapper.toOwner(ownerFieldsDto);
         this.clinicService.saveOwner(owner);
