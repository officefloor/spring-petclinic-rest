+    /**
+     * Normalizes a telephone number by removing every non-digit character and requiring the result to
+     * contain exactly ten digits.
+     *
+     * @param telephone the raw telephone value supplied by the client
+     * @return the 10-digit telephone number, or {@code null} when the stripped value is not exactly 10 digits
+     */
+    private static String normalizeTelephone(String telephone) {
+        if (telephone == null) {
+            return null;
+        }
+        String digits = telephone.replaceAll("\\D", "");
+        return digits.length() == 10 ? digits : null;
+    }
