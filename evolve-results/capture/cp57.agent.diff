+package org.springframework.samples.petclinic.rest.advice;
+
+import org.aspectj.lang.ProceedingJoinPoint;
+import org.aspectj.lang.annotation.Around;
+import org.aspectj.lang.annotation.Aspect;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.stereotype.Component;
+
+/**
+ * Enqueues a welcome notification whenever a new owner is successfully created, by emitting a line on
+ * the dedicated {@code NOTIFY} logger carrying the owner id and its memberId (the assigned
+ * customerCode). Kept as its own small aspect so this rule stays a self-contained unit rather than
+ * growing the controller, service or another advice.
+ */
+@Aspect
+@Component
+public class OwnerWelcomeNotificationAdvice {
+
+    private static final Logger NOTIFY = LoggerFactory.getLogger("NOTIFY");
+
+    @Around("execution(* org.springframework.samples.petclinic.service.ClinicService.saveOwner(..)) && args(owner)")
+    public Object enqueueWelcome(ProceedingJoinPoint joinPoint, Owner owner) throws Throwable {
+        boolean created = owner.isNew();
+        Object result = joinPoint.proceed();
+        if (created) {
+            NOTIFY.info("owner={} memberId={}", owner.getId(), owner.getCustomerCode());
+        }
+        return result;
+    }
+}
