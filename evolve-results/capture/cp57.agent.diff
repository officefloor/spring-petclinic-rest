+package org.springframework.samples.petclinic.service;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.samples.petclinic.model.Owner;
+
+/**
+ * Enqueues the welcome notification for a newly created owner by emitting a line to the
+ * dedicated {@code NOTIFY} logger carrying the owner id and its memberId.
+ */
+public final class WelcomeNotification {
+
+    private static final Logger NOTIFY = LoggerFactory.getLogger("NOTIFY");
+
+    private WelcomeNotification() {
+    }
+
+    public static void enqueue(Owner owner) {
+        NOTIFY.info("welcome owner id={} memberId={}", owner.getId(), owner.getMemberId());
+    }
+}
