+        int code;
+        try {
+            code = Integer.parseInt(postcode.trim());
+        }
+        catch (NumberFormatException ex) {
+            return null;
+        }
+        if (code >= 2000 && code <= 2099) {
+            return "NSW";
+        }
+        if (code >= 3000 && code <= 3099) {
+            return "VIC";
+        }
+        if (code >= 4000 && code <= 4099) {
+            return "QLD";
+        }
+        return null;
+    }
