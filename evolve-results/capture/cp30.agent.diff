diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/Locality.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/Locality.java
index 0961adec4..93bd3c1e7 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/Locality.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/Locality.java
@@ -18,6 +18,27 @@ public final class Locality {
     }
 
     public static String of(Owner owner) {
+        String byPostcode = fromPostcode(owner.getPostcode());
+        if (byPostcode != null) {
+            return byPostcode;
+        }
         return CITY_REGION.getOrDefault(owner.getCity(), "UNKNOWN");
     }
+
+    private static String fromPostcode(String postcode) {
+        if (postcode == null || !postcode.matches("\\d{4}")) {
+            return null;
+        }
+        int code = Integer.parseInt(postcode);
+        if (code >= 2000 && code <= 2099) {
+            return "NSW";
+        }
+        if (code >= 3000 && code <= 3099) {
+            return "VIC";
+        }
+        if (code >= 4000 && code <= 4099) {
+            return "QLD";
+        }
+        return null;
+    }
 }
