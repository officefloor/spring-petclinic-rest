+package org.springframework.samples.petclinic.mapper;
+
+import java.util.Map;
+
+/**
+ * Resolves an owner's locality (region) preferring the postcode: a 4-digit postcode is mapped by
+ * range (NSW 2000-2099, VIC 3000-3099, QLD 4000-4099) first, and only when it is absent or in no
+ * known range does the fixed city-to-region table decide. Cities that share a name are thereby
+ * disambiguated by their postcode. Yields 'UNKNOWN' when neither source identifies a region.
+ */
+final class LocalityResolver {
+
+    /** Fixed city-to-region fallback table. */
+    private static final Map<String, String> CITY_REGION =
+        Map.of("Sydney", "NSW", "Melbourne", "VIC", "Brisbane", "QLD");
+
+    private LocalityResolver() {
+    }
+
+    static String resolve(String city, String postcode) {
+        String byPostcode = fromPostcode(postcode);
+        if (byPostcode != null) {
+            return byPostcode;
+        }
+        return CITY_REGION.getOrDefault(city, "UNKNOWN");
+    }
+
+    private static String fromPostcode(String postcode) {
+        if (postcode == null || !postcode.matches("[0-9]{4}")) {
+            return null;
+        }
+        return switch (Integer.parseInt(postcode) / 100) {
+            case 20 -> "NSW";
+            case 30 -> "VIC";
+            case 40 -> "QLD";
+            default -> null;
+        };
+    }
+}
