+package org.springframework.samples.petclinic.service;
+
+/**
+ * Thrown when an owner is created in a city that already contains the maximum number of owners.
+ * Signals a conflict with existing data rather than a bad request.
+ */
+public class CityCapacityExceededException extends RuntimeException {
+
+    public CityCapacityExceededException(String city, int limit) {
+        super("City '" + city + "' already contains the maximum of " + limit + " owners");
+    }
+}
