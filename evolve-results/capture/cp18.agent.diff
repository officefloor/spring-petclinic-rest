@@ -0,0 +1,13 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by the create-owner pipeline when the owner's city already contains 50 or more owners
+ * (compared case-insensitively with trimmed whitespace). Handled globally by
+ * {@link CityAtCapacityExceptionHandler}, which responds 409 Conflict.
+ */
+public class CityAtCapacityException extends Exception {
+
+    public CityAtCapacityException(String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java
new file mode 100644
index 000000000..fbcab97ca
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java
@@ -0,0 +1,16 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class CityAtCapacityExceptionHandler {
+
+    public void handle(@Parameter CityAtCapacityException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.CONFLICT, ex.getMessage());
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireCityCapacity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RequireCityCapacity.java
