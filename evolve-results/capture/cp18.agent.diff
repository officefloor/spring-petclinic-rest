+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner is created in a city that already contains 50 or more
+ * owners (compared case-insensitively with collapsed whitespace). Handled by
+ * the REST {@code ExceptionControllerAdvice}, which translates it into a
+ * {@code 409 Conflict} response.
+ */
+public class CityCapacityExceededException extends RuntimeException {
+
+    public CityCapacityExceededException(String message) {
+        super(message);
+    }
+}
