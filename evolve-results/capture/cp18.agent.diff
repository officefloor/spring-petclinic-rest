--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java
@@ -0,0 +1,18 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class CityAtCapacityExceptionHandler {
+
+    public void handle(@Parameter CityAtCapacityException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT)
+                .body(Map.of("errors", List.of("city"))));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/EnsureCityCapacity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/EnsureCityCapacity.java
