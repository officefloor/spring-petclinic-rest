+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an attempt is made to create an owner whose city (compared case-insensitively) already contains 50 or
+ * more owners. Reported as a {@code 409 Conflict} by the {@link ExceptionControllerAdvice}.
+ */
+public class OwnerCityFullException extends RuntimeException {
+
+    public OwnerCityFullException(String message) {
+        super(message);
+    }
+}
