@@ -0,0 +1,12 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when a create-owner request names a city that already contains 50 or more
+ * owners. Handled by {@link CrowdedCityExceptionHandler}, which responds 409.
+ */
+public class CrowdedCityException extends Exception {
+
+    public CrowdedCityException(String city) {
+        super("City is at capacity: " + city);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/CrowdedCityExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CrowdedCityExceptionHandler.java
new file mode 100644
index 000000000..915c77dd4
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CrowdedCityExceptionHandler.java
@@ -0,0 +1,14 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class CrowdedCityExceptionHandler {
+
+    public void handle(@Parameter CrowdedCityException ex,
+            ObjectResponse<ResponseEntity<String>> response) {
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(ex.getMessage()));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectCrowdedCity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectCrowdedCity.java
