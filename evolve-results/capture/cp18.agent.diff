+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Signals that a new owner could not be created because its city already contains the
+ * maximum permitted number of owners.
+ *
+ * <p>Handled as a 409 Conflict, reporting {@code city} as the offending field.
+ */
+public class OwnerCityCapacityExceededException extends RuntimeException {
+
+    public OwnerCityCapacityExceededException(String city, long maxOwners) {
+        super("City has reached the maximum of " + maxOwners + " owners: " + city);
+    }
+}
