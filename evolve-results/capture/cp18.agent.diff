+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when creating an owner whose city already contains the maximum number of owners
+ * (50 or more). Carries the offending field name so the exception handler can report it in the
+ * {@code errors} response body, and maps to a 409 Conflict response.
+ */
+public class CityAtCapacityException extends RuntimeException {
+
+    private final List<String> fields;
+
+    public CityAtCapacityException(String city) {
+        super("City '" + city + "' already contains the maximum number of owners");
+        this.fields = List.of("city");
+    }
+
+    public List<String> getFields() {
+        return this.fields;
+    }
+}
