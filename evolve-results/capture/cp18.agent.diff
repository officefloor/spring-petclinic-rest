+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown on create when the owner's city already contains 50 or more owners (compared
+ * case-insensitively with surrounding whitespace trimmed). Carries the offending field name so the
+ * {@link ExceptionControllerAdvice} can report it in the {@code errors} array of a 409 Conflict
+ * response, mirroring {@link DuplicateHouseholdException}.
+ */
+public class CityAtCapacityException extends RuntimeException {
+
+    public CityAtCapacityException(String message) {
+        super(message);
+    }
+}
