+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Raised when an owner is created in a city that already contains the maximum number of owners
+ * (50 or more). Maps to a 409 Conflict response.
+ */
+public class OwnerCityCapacityExceededException extends RuntimeException {
+
+    private final String city;
+
+    public OwnerCityCapacityExceededException(String city) {
+        super("The city " + city + " already contains the maximum number of owners");
+        this.city = city;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
