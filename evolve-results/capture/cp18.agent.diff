+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a request tries to create an owner whose city already contains the
+ * maximum number of owners (50 or more, compared case-insensitively).
+ * <p>
+ * Signals a conflict with existing data so the {@link ExceptionControllerAdvice}
+ * can surface it to the client as a {@code 409 Conflict} response.
+ */
+public class CityCapacityExceededException extends RuntimeException {
+
+    public CityCapacityExceededException(String city) {
+        super("The city '" + city + "' already contains the maximum number of owners");
+    }
+}
