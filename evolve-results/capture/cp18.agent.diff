@@ -0,0 +1,19 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when a create-owner request targets a city that already contains 50 or more owners.
+ * Handled by {@link CityAtCapacityExceptionHandler}, which responds 409 Conflict.
+ */
+public class CityAtCapacityException extends Exception {
+
+    private final String city;
+
+    public CityAtCapacityException(String city) {
+        super("The city has reached its owner capacity: " + city);
+        this.city = city;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java
new file mode 100644
index 00000000..0b39f363
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/CityAtCapacityExceptionHandler.java
@@ -0,0 +1,21 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+public class CityAtCapacityExceptionHandler {
+
+    public void handle(@Parameter CityAtCapacityException ex,
+            ObjectResponse<ResponseEntity<Errors>> response) {
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT)
+                .body(new Errors(List.of("city"))));
+    }
+
+    /** Response body: {@code {"errors": ["city"]}}. */
+    public record Errors(List<String> errors) {
+    }
+}
