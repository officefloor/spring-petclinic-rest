+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Raised when a new owner cannot be created because the owner's city has already reached the
+ * maximum number of owners it may hold, so the client can be told the request conflicts with the
+ * current state of that city.
+ */
+public class CityCapacityExceededException extends RuntimeException {
+
+    private final String city;
+
+    public CityCapacityExceededException(String city) {
+        super("City has reached its maximum number of owners: " + city);
+        this.city = city;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
