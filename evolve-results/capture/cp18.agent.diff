+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when a new owner cannot be created because the owner's city already contains 50 or more
+ * owners. {@link ExceptionControllerAdvice} reports it back to the client as a 409 Conflict
+ * response.
+ */
+public class CityAtCapacityException extends RuntimeException {
+
+    public CityAtCapacityException(String message) {
+        super(message);
+    }
+
+}
