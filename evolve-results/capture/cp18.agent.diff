+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Raised when creating an owner whose city already contains the maximum number of owners
+ * (50, compared case-insensitively). Carries the offending city so the exception handler
+ * can report the conflict to the client as a 409 Conflict.
+ */
+public class CityAtCapacityException extends RuntimeException {
+
+    private final String city;
+
+    public CityAtCapacityException(String city) {
+        super("The city '" + city + "' already contains the maximum number of owners");
+        this.city = city;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
