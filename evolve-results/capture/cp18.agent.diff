+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created whose city already contains 50 or more owners (the city is at
+ * capacity). Handled as a 409 Conflict by {@link ExceptionControllerAdvice}.
+ */
+public class CityAtCapacityException extends RuntimeException {
+
+    private final transient Object rejectedValue;
+
+    public CityAtCapacityException(String city) {
+        super("city already contains the maximum of 50 owners");
+        this.rejectedValue = city;
+    }
+
+    public Object getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
