+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner cannot be created because their city already contains 50 or more owners.
+ * Carries the offending city so it can be reported to the client.
+ */
+public class CityAtCapacityException extends RuntimeException {
+
+    private final String city;
+
+    public CityAtCapacityException(String city) {
+        super("The city already contains the maximum number of owners: " + city);
+        this.city = city;
+    }
+
+    public String getCity() {
+        return this.city;
+    }
+}
