+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown by REST controllers when an owner cannot be created because its city already contains the
+ * maximum number of owners (50). The exception handler reports it as a {@code 409 Conflict}.
+ */
+public class CityCapacityException extends RuntimeException {
+
+    public CityCapacityException(String city) {
+        super("The city '" + city + "' has reached its maximum capacity of owners");
+    }
+}
