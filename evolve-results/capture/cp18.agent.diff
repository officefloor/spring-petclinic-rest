@@ -0,0 +1,27 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Rejects a create request when the owner's city is already at capacity.
+ *
+ * <p>Runs after {@link CheckOwnerHouseholdUnique} and before {@link BuildOwner}. A city is at
+ * capacity once it already contains 50 or more owners; the 51st owner in that city is refused.
+ * The city is matched exactly, consistent with {@link AssignOwnerCustomerCode}'s per-city
+ * sequence. A match throws {@link OwnerCityAtCapacityException}, handled as a 409 Conflict.
+ */
+public class CheckOwnerCityCapacity {
+
+    /** Maximum number of owners permitted per city; the next owner is rejected. */
+    private static final int CITY_CAPACITY = 50;
+
+    public void service(@Val OwnerFieldsDto request, OwnerRepository ownerRepository)
+            throws OwnerCityAtCapacityException {
+        String city = request.getCity();
+        if (OwnerCity.countOwnersInCity(ownerRepository, city) >= CITY_CAPACITY) {
+            throw new OwnerCityAtCapacityException(city);
+        }
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCity.java
new file mode 100644
index 000000000..04395fd1b
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCity.java
@@ -0,0 +1,26 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+
+/**
+ * Single source of truth for the "owners in a city" primitive, used wherever an owner is created.
+ *
+ * <p>Both the city-capacity check ({@link CheckOwnerCityCapacity}) and the per-city customer-code
+ * sequence ({@link AssignOwnerCustomerCode}) depend on the same count, and are meant to stay
+ * consistent, so the definition of what counts as "the same city" lives here rather than being
+ * inlined in each. The city is matched exactly today; aligning it with the address/household
+ * normalization would be a change in one place.
+ */
+final class OwnerCity {
+
+    private OwnerCity() {
+    }
+
+    /** The number of existing owners whose city matches {@code city}. */
+    static long countOwnersInCity(OwnerRepository ownerRepository, String city) {
+        return ownerRepository.findAll().stream()
+                .filter(existing -> city.equals(existing.getCity()))
+                .count();
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCityAtCapacityException.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/OwnerCityAtCapacityException.java
