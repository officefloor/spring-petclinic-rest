+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Thrown when creating an owner whose city already holds the maximum number of owners.
+ * Handled as {@code 409 Conflict}.
+ */
+public class CityCapacityExceededException extends RuntimeException {
+
+    public CityCapacityExceededException(String city, int limit) {
+        super("city has reached the maximum number of owners (city: " + city + ", limit: " + limit + ")");
+    }
+}
