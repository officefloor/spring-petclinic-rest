{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011jE9fND1q2aypv3G2kB5vQ","type":"tool_result","content":"1\tpackage org.springframework.samples.petclinic.mapper;\n2\t\n3\timport org.jspecify.annotations.NonNull;\n4\timport org.mapstruct.Mapper;\n5\timport org.mapstruct.Mapping;\n6\timport org.springframework.data.domain.Page;\n7\timport org.springframework.samples.petclinic.model.Owner;\n8\timport org.springframework.samples.petclinic.rest.dto.OwnerDto;\n9\timport org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;\n10\timport org.springframework.samples.petclinic.rest.dto.OwnerPageDto;\n11\t\n12\timport java.util.Collection;\n13\timport java.util.List;\n14\t\n15\t/**\n16\t * Maps Owner & OwnerDto using Mapstruct\n17\t */\n18\t@Mapper(uses = PetMapper.class)\n19\tpublic interface OwnerMapper {\n20\t\n21\t    @Mapping(target = \"displayName\",\n22\t        expression = \"java(owner.getLastName() + \\\", \\\" + owner.getFirstName())\")\n23\t    OwnerDto toOwnerDto(Owner owner);\n24\t\n25\t    Owner toOwner(OwnerDto ownerDto);\n26\t\n27\t    @Mapping(target = \"id\", ignore = true)\n28\t    @Mapping(target = \"pets\", ignore = true)\n29\t    Owner toOwner(OwnerFieldsDto ownerDto);\n30\t\n31\t    List<OwnerDto> toOwnerDtoCollection(Collection<Owner> ownerCollection);\n32\t\n33\t    Collection<Owner> toOwners(Collection<OwnerDto> ownerDtos);\n34\t\n35\t    default OwnerPageDto toOwnerPageDto(@NonNull Page<Owner> ownerPage) {\n36\t        OwnerPageDto ownerPageDto = new OwnerPageDto();\n37\t        ownerPageDto.setContent(toOwnerDtoCollection(ownerPage.getContent()));\n38\t        ownerPageDto.setPage(ownerPage.getNumber());\n39\t        ownerPageDto.setSize(ownerPage.getSize());\n40\t        ownerPageDto.setTotalElements(ownerPage.getTotalElements());\n41\t        ownerPageDto.setTotalPages(ownerPage.getTotalPages());\n42\t        return ownerPageDto;\n43\t    }\n44\t}\n45\t"}]},"parent_tool_use_id":null,"session_id":"105a3ece-72e8-425a-ab01-19ff6c0c2b86","uuid":"37351b5b-f13f-4e0d-9c32-3d17bb432428","timestamp":"2026-10-04T07:20:18.373Z","tool_use_result":{"type":"text","file":{"filePath":"/home/daniel/sandbox/src/main/java/org/springframework/samples/petclinic/mapper/OwnerMapper.java","content":"package org.springframework.samples.petclinic.mapper;\n\nimport org.jspecify.annotations.NonNull;\nimport org.mapstruct.Mapper;\nimport org.mapstruct.Mapping;\nimport org.springframework.data.domain.Page;\nimport org.springframework.samples.petclinic.model.Owner;\nimport org.springframework.samples.petclinic.rest.dto.OwnerDto;\nimport org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;\nimport org.springframework.samples.petclinic.rest.dto.OwnerPageDto;\n\nimport java.util.Collection;\nimport java.util.List;\n\n/**\n * Maps Owner & OwnerDto using Mapstruct\n */\n@Mapper(uses = PetMapper.class)\npublic interface OwnerMapper {\n\n    @Mapping(target = \"displayName\",\n        expression = \"java(owner.getLastName() + \\\", \\\" + owner.getFirstName())\")\n    OwnerDto toOwnerDto(Owner owner);\n\n    Owner toOwner(OwnerDto ownerDto);\n\n    @Mapping(target = \"id\", ignore = true)\n    @Mapping(target = \"pets\", ignore = true)\n    Owner toOwner(OwnerFieldsDto ownerDto);\n\n    List<OwnerDto> toOwnerDtoCollection(Collection<Owner> ownerCollection);\n\n    Collection<Owner> toOwners(Collection<OwnerDto> ownerDtos);\n\n    default OwnerPageDto toOwnerPageDto(@NonNull Page<Owner> ownerPage) {\n        OwnerPageDto ownerPageDto = new OwnerPageDto();\n        ownerPageDto.setContent(toOwnerDtoCollection(ownerPage.getContent()));\n        ownerPageDto.setPage(ownerPage.getNumber());\n        ownerPageDto.setSize(ownerPage.getSize());\n        ownerPageDto.setTotalElements(ownerPage.getTotalElements());\n        ownerPageDto.setTotalPages(ownerPage.getTotalPages());\n        return ownerPageDto;\n    }\n}\n","numLines":45,"startLine":1,"totalLines":45}}}
