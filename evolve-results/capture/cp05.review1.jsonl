{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011R692L3ZT4tRtRTdS5uMKw","type":"tool_result","content":"1\tpackage org.springframework.samples.petclinic.mapper;\n2\t\n3\timport org.jspecify.annotations.NonNull;\n4\timport org.mapstruct.Mapper;\n5\timport org.mapstruct.Mapping;\n6\timport org.springframework.data.domain.Page;\n7\timport org.springframework.samples.petclinic.model.Owner;\n8\timport org.springframework.samples.petclinic.rest.dto.OwnerDto;\n9\timport org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;\n10\timport org.springframework.samples.petclinic.rest.dto.OwnerPageDto;\n11\t\n12\timport java.util.Collection;\n13\timport java.util.List;\n14\t\n15\t/**\n16\t * Maps Owner & OwnerDto using Mapstruct\n17\t */\n18\t@Mapper(uses = PetMapper.class)\n19\tpublic interface OwnerMapper {\n20\t\n21\t    @Mapping(target = \"displayName\", expression = \"java(displayName(owner))\")\n22\t    OwnerDto toOwnerDto(Owner owner);\n23\t\n24\t    Owner toOwner(OwnerDto ownerDto);\n25\t\n26\t    /**\n27\t     * Formats an owner's stored names as {@code 'LastName, FirstName'}.\n28\t     */\n29\t    default String displayName(Owner owner) {\n30\t        if (owner == null) {\n31\t            return null;\n32\t        }\n33\t        String lastName = owner.getLastName() == null ? \"\" : owner.getLastName();\n34\t        String firstName = owner.getFirstName() == null ? \"\" : owner.getFirstName();\n35\t        return lastName + \", \" + firstName;\n36\t    }\n37\t\n38\t    @Mapping(target = \"id\", ignore = true)\n39\t    @Mapping(target = \"pets\", ignore = true)\n40\t    Owner toOwner(OwnerFieldsDto ownerDto);\n41\t\n42\t    List<OwnerDto> toOwnerDtoCollection(Collection<Owner> ownerCollection);\n43\t\n44\t    Collection<Owner> toOwners(Collection<OwnerDto> ownerDtos);\n45\t\n46\t    default OwnerPageDto toOwnerPageDto(@NonNull Page<Owner> ownerPage) {\n47\t        OwnerPageDto ownerPageDto = new OwnerPageDto();\n48\t        ownerPageDto.setContent(toOwnerDtoCollection(ownerPage.getContent()));\n49\t        ownerPageDto.setPage(ownerPage.getNumber());\n50\t        ownerPageDto.setSize(ownerPage.getSize());\n51\t        ownerPageDto.setTotalElements(ownerPage.getTotalElements());\n52\t        ownerPageDto.setTotalPages(ownerPage.getTotalPages());\n53\t        return ownerPageDto;\n54\t    }\n55\t}\n56\t"}]},"parent_tool_use_id":null,"session_id":"080941eb-6369-48ca-a736-467bb145f7f2","uuid":"6413881f-8f6f-4cec-9925-4eceee9e7fe6","timestamp":"2026-09-29T02:19:13.036Z","tool_use_result":{"type":"text","file":{"filePath":"/home/daniel/sandbox/src/main/java/org/springframework/samples/petclinic/mapper/OwnerMapper.java","content":"package org.springframework.samples.petclinic.mapper;\n\nimport org.jspecify.annotations.NonNull;\nimport org.mapstruct.Mapper;\nimport org.mapstruct.Mapping;\nimport org.springframework.data.domain.Page;\nimport org.springframework.samples.petclinic.model.Owner;\nimport org.springframework.samples.petclinic.rest.dto.OwnerDto;\nimport org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;\nimport org.springframework.samples.petclinic.rest.dto.OwnerPageDto;\n\nimport java.util.Collection;\nimport java.util.List;\n\n/**\n * Maps Owner & OwnerDto using Mapstruct\n */\n@Mapper(uses = PetMapper.class)\npublic interface OwnerMapper {\n\n    @Mapping(target = \"displayName\", expression = \"java(displayName(owner))\")\n    OwnerDto toOwnerDto(Owner owner);\n\n    Owner toOwner(OwnerDto ownerDto);\n\n    /**\n     * Formats an owner's stored names as {@code 'LastName, FirstName'}.\n     */\n    default String displayName(Owner owner) {\n        if (owner == null) {\n            return null;\n        }\n        String lastName = owner.getLastName() == null ? \"\" : owner.getLastName();\n        String firstName = owner.getFirstName() == null ? \"\" : owner.getFirstName();\n        return lastName + \", \" + firstName;\n    }\n\n    @Mapping(target = \"id\", ignore = true)\n    @Mapping(target = \"pets\", ignore = true)\n    Owner toOwner(OwnerFieldsDto ownerDto);\n\n    List<OwnerDto> toOwnerDtoCollection(Collection<Owner> ownerCollection);\n\n    Collection<Owner> toOwners(Collection<OwnerDto> ownerDtos);\n\n    default OwnerPageDto toOwnerPageDto(@NonNull Page<Owner> ownerPage) {\n        OwnerPageDto ownerPageDto = new OwnerPageDto();\n        ownerPageDto.setContent(toOwnerDtoCollection(ownerPage.getContent()));\n        ownerPageDto.setPage(ownerPage.getNumber());\n        ownerPageDto.setSize(ownerPage.getSize());\n        ownerPageDto.setTotalElements(ownerPage.getTotalElements());\n        ownerPageDto.setTotalPages(ownerPage.getTotalPages());\n        return ownerPageDto;\n    }\n}\n","numLines":56,"startLine":1,"totalLines":56}}}
