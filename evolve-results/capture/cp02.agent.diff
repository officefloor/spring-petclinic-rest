@@ -0,0 +1,21 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@code NormalizeOwnerTelephone} when a create-owner request carries a telephone that,
+ * after every non-digit character is stripped, is not exactly 10 digits. Carries the offending
+ * (normalized) value so {@link InvalidTelephoneExceptionHandler} can report a 400.
+ */
+public class InvalidTelephoneException extends Exception {
+
+    private final String normalized;
+
+    public InvalidTelephoneException(String normalized) {
+        super("Telephone must be exactly 10 digits after removing non-digit characters, but was: '"
+                + normalized + "'");
+        this.normalized = normalized;
+    }
+
+    public String getNormalized() {
+        return this.normalized;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidTelephoneExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidTelephoneExceptionHandler.java
new file mode 100644
index 000000000..39f547b17
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidTelephoneExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 400 when a create-owner telephone is not exactly 10 digits after non-digit characters are
+ * stripped, mirroring {@link MissingOwnerFieldsExceptionHandler}'s {@code errors} array shape.
+ */
+public class InvalidTelephoneExceptionHandler {
+
+    public void handle(@Parameter InvalidTelephoneException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        response.send(ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                .body(Map.of("errors", List.of("telephone"))));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerTelephone.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerTelephone.java
