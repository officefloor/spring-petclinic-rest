index 00000000..eacf348f
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/InvalidTelephoneExceptionHandler.java
@@ -0,0 +1,16 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.ResponseEntity;
+
+public class InvalidTelephoneExceptionHandler {
+
+    public void handle(@Parameter InvalidTelephoneException ex,
+            ObjectResponse<ResponseEntity<Map<String, List<String>>>> response) {
+        response.send(ResponseEntity.badRequest().body(Map.of("errors", List.of("telephone"))));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerTelephone.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerTelephone.java
