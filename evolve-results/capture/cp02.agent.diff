+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner's submitted telephone does not contain exactly 10 digits once every
+ * non-digit character has been stripped. The REST layer reports this as a 400 Bad Request.
+ *
+ * @see TelephoneNormalizer
+ */
+public class InvalidTelephoneException extends RuntimeException {
+
+    public InvalidTelephoneException(String message) {
+        super(message);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneNormalizer.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneNormalizer.java
