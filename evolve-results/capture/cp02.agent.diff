index 000000000..cbe408828
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/InvalidTelephoneException.java
@@ -0,0 +1,18 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner's telephone number is not a valid telephone number.
+ */
+public class InvalidTelephoneException extends RuntimeException {
+
+    private final String rejectedValue;
+
+    public InvalidTelephoneException(String rejectedValue) {
+        super("Telephone number must contain exactly " + OwnerTelephone.REQUIRED_DIGITS + " digits");
+        this.rejectedValue = rejectedValue;
+    }
+
+    public String getRejectedValue() {
+        return rejectedValue;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/OwnerTelephone.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/OwnerTelephone.java
new file mode 100644
index 000000000..7028fa55f
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/OwnerTelephone.java
@@ -0,0 +1,37 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Normalizes and validates owner telephone numbers.
+ */
+public final class OwnerTelephone {
+
+    public static final int REQUIRED_DIGITS = 10;
+
+    private OwnerTelephone() {
+    }
+
+    /**
+     * Strips every non-digit character and requires exactly {@value #REQUIRED_DIGITS} digits to remain.
+     *
+     * @param telephone the telephone number as supplied in the request
+     * @return the normalized {@value #REQUIRED_DIGITS}-digit telephone number
+     * @throws InvalidTelephoneException if the number does not contain exactly {@value #REQUIRED_DIGITS} digits
+     */
+    public static String normalize(String telephone) {
+        String digits = telephone.replaceAll("\\D", "");
+        if (digits.length() != REQUIRED_DIGITS) {
+            throw new InvalidTelephoneException(telephone);
+        }
+        return digits;
+    }
+
+    /**
+     * @param telephone the telephone number as supplied in the request
+     * @throws InvalidTelephoneException if the number contains anything other than digits
+     */
+    public static void requireDigitsOnly(String telephone) {
+        if (telephone != null && !telephone.chars().allMatch(Character::isDigit)) {
+            throw new InvalidTelephoneException(telephone);
+        }
+    }
+}
