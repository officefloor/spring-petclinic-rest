@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.Constraint;
+import jakarta.validation.Payload;
+import java.lang.annotation.*;
+
+/**
+ * Validates that a telephone number contains exactly 10 digits once every non-digit
+ * character has been stripped.
+ */
+@Target({ ElementType.FIELD })
+@Retention(RetentionPolicy.RUNTIME)
+@Constraint(validatedBy = TelephoneValidator.class)
+@Documented
+public @interface Telephone {
+
+    String message() default "Telephone must contain exactly 10 digits";
+
+    Class<?>[] groups() default {};
+
+    Class<? extends Payload>[] payload() default {};
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneNormalizer.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneNormalizer.java
new file mode 100644
index 000000000..c73bc664c
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneNormalizer.java
@@ -0,0 +1,20 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Normalizes a telephone number to its bare digits by removing every non-digit character.
+ */
+public final class TelephoneNormalizer {
+
+    private TelephoneNormalizer() {
+    }
+
+    /**
+     * Strip every non-digit character from the given telephone.
+     *
+     * @param telephone the raw telephone, possibly {@code null} or containing formatting characters
+     * @return the digits contained in {@code telephone}; an empty string when {@code telephone} is {@code null}
+     */
+    public static String normalize(String telephone) {
+        return telephone == null ? "" : telephone.replaceAll("\\D", "");
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneValidator.java b/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneValidator.java
new file mode 100644
index 000000000..b124a1692
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/validation/TelephoneValidator.java
@@ -0,0 +1,12 @@
+package org.springframework.samples.petclinic.rest.validation;
+
+import jakarta.validation.ConstraintValidator;
+import jakarta.validation.ConstraintValidatorContext;
+
+public class TelephoneValidator implements ConstraintValidator<Telephone, String> {
+
+    @Override
+    public boolean isValid(String telephone, ConstraintValidatorContext context) {
+        return TelephoneNormalizer.normalize(telephone).length() == 10;
+    }
+}
