- * compares correctly), the email trimmed and lower-cased (empty when absent), and the
- * {@code householdId} as stored (empty when absent). Soft duplicate detection is keyed on the
- * household (see {@link FlagPossibleDuplicate}); this key is exposed by the owner mapper.
+ * <p>The inputs are normalized the same way for every owner so stored owners and the owner being
+ * created compare consistently: the telephone to its E.164 form (see {@link OwnerTelephones}, so a
+ * stored value that predates the pipeline still compares correctly), the email trimmed and
+ * lower-cased (empty when absent), and the last name reduced to its American {@link #soundex
+ * Soundex} code. Hard duplicate detection (409) compares this key (see
+ * {@link RejectDuplicateIdentity}); the soft signal keys on the weaker
+ * {@code soundex(lastName)} + {@code postcode} pair (see {@link FlagPossibleDuplicate}). The key is
+ * exposed by the owner mapper.
+ *
+ * <p>Because the telephone is part of the key, two owners sharing a last name and postcode but
+ * carrying different telephones produce <em>different</em> identity keys — they are a soft match,
+ * not a hard duplicate.
  */
 public final class OwnerIdentity {
 
     private OwnerIdentity() {
     }
 
-    /** The owner's duplicate-detection identity key. */
+    /** The owner's duplicate-detection identity key: SHA-256 hex over the normalized inputs. */
     public static String identityKey(Owner owner) {
+        String canonical = normalizedTelephone(owner) + "|" + lowerEmail(owner) + "|" + soundex(owner.getLastName());
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256")
+                    .digest(canonical.getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder(digest.length * 2);
+            for (byte b : digest) {
+                sb.append(String.format("%02x", b));
+            }
+            return sb.toString();
+        }
+        catch (NoSuchAlgorithmException ex) {
+            throw new IllegalStateException("SHA-256 not available", ex);
+        }
+    }
+
+    /**
+     * The owner's telephone in its normalized E.164 form (see {@link OwnerTelephones#toE164}),
+     * falling back to the stored raw value (or empty) when it cannot be normalized.
+     */
+    static String normalizedTelephone(Owner owner) {
         String telephone = OwnerTelephones.toE164(owner.getTelephone());
         if (telephone == null) {
             telephone = owner.getTelephone() == null ? "" : owner.getTelephone();
         }
+        return telephone;
+    }
+
+    /** The owner's email trimmed and lower-cased, or empty when absent. */
+    static String lowerEmail(Owner owner) {
         String email = owner.getEmail();
-        email = (email == null || email.isBlank()) ? "" : email.trim().toLowerCase(Locale.ROOT);
-        String household = owner.getHouseholdId();
-        household = household == null ? "" : household;
-        return telephone + "|" + email + "|" + household;
+        return (email == null || email.isBlank()) ? "" : email.trim().toLowerCase(Locale.ROOT);
+    }
+
+    /**
+     * The American Soundex code of {@code value}: the retained first letter followed by three
+     * digits (zero-padded), with vowels and {@code h}/{@code w} not coded and adjacent letters
+     * sharing a code collapsed. Returns empty for a null or letterless value.
+     */
+    static String soundex(String value) {
+        if (value == null) {
+            return "";
+        }
+        StringBuilder letters = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            char c = Character.toUpperCase(value.charAt(i));
+            if (c >= 'A' && c <= 'Z') {
+                letters.append(c);
+            }
+        }
+        if (letters.length() == 0) {
+            return "";
+        }
+        StringBuilder code = new StringBuilder();
+        code.append(letters.charAt(0));
+        char prev = charCode(letters.charAt(0));
+        for (int i = 1; i < letters.length() && code.length() < 4; i++) {
+            char c = letters.charAt(i);
+            if (c == 'H' || c == 'W') {
+                // Transparent: letters separated by H or W are treated as adjacent.
+                continue;
+            }
+            char cc = charCode(c);
+            if (cc != '0' && cc != prev) {
+                code.append(cc);
+            }
+            prev = cc;
+        }
+        while (code.length() < 4) {
+            code.append('0');
+        }
+        return code.toString();
+    }
+
+    /** American Soundex digit for an upper-case letter; {@code '0'} for vowels and h/w. */
+    private static char charCode(char c) {
+        switch (c) {
+            case 'B': case 'F': case 'P': case 'V':
+                return '1';
+            case 'C': case 'G': case 'J': case 'K': case 'Q': case 'S': case 'X': case 'Z':
+                return '2';
+            case 'D': case 'T':
+                return '3';
+            case 'L':
+                return '4';
+            case 'M': case 'N':
+                return '5';
+            case 'R':
+                return '6';
+            default:
+                return '0';
+        }
     }
 }
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectDuplicateIdentity.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectDuplicateIdentity.java
