+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Raised when a new owner is submitted with a normalized (lower-cased) email that is already used by
+ * an existing owner, so the client can be told the value conflicts with another record.
+ */
+public class DuplicateEmailException extends RuntimeException {
+
+    private final String email;
+
+    public DuplicateEmailException(String email) {
+        super("Email is already used by another owner: " + email);
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
