@@ -0,0 +1,33 @@
+package org.springframework.samples.petclinic.rest.function.owner;
+
+import net.officefloor.plugin.variable.Val;
+import org.springframework.samples.petclinic.model.Owner;
+import org.springframework.samples.petclinic.repository.OwnerRepository;
+import org.springframework.samples.petclinic.rest.dto.OwnerFieldsDto;
+import org.springframework.samples.petclinic.rest.escalation.DuplicateEmailException;
+
+/**
+ * Rejects creating an owner whose lower-cased email is already used by any other owner.
+ * Runs after {@link NormalizeOwnerEmail} (so the request already holds the lower-cased value) and
+ * before {@link BuildOwner}. Both sides are reduced to canonical form through the shared
+ * {@link NormalizeOwnerEmail#normalize(String)}, so the "same email" definition is single-sourced
+ * and matches regardless of how existing values were stored. Email is optional: a request with no
+ * email is never a collision, and an existing owner with no email never matches. A collision is
+ * rejected 409 via {@link DuplicateEmailException}.
+ */
+public class CheckOwnerEmailUnique {
+
+    public void service(@Val OwnerFieldsDto request, OwnerRepository ownerRepository)
+            throws DuplicateEmailException {
+        String email = request.getEmail();
+        if (email == null) {
+            return;
+        }
+        for (Owner existing : ownerRepository.findAll()) {
+            if (email.equals(NormalizeOwnerEmail.normalize(existing.getEmail()))) {
+                throw new DuplicateEmailException(
+                        "Email " + email + " is already used by another owner");
+            }
+        }
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java
index 184772094..8083b292b 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/NormalizeOwnerEmail.java
@@ -17,7 +17,17 @@ public class NormalizeOwnerEmail {
     public void service(@Val OwnerFieldsDto request) {
         String email = request.getEmail();
         if (email != null) {
-            request.setEmail(email.toLowerCase(Locale.ROOT));
+            request.setEmail(normalize(email));
         }
     }
+
+    /**
+     * The single source of truth for an email's canonical form: lower-cased. Null-safe so it can
+     * canonicalize an existing owner's (possibly absent) stored value. Shared with
+     * {@link CheckOwnerEmailUnique} so the "same email" definition can never drift from how emails
+     * are stored and returned.
+     */
+    static String normalize(String email) {
+        return email == null ? null : email.toLowerCase(Locale.ROOT);
+    }
 }
