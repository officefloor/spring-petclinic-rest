+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Raised when an owner submitted to the create endpoint has a normalized (lower-cased) email that is
+ * already used by another existing owner. The {@code ExceptionControllerAdvice} renders this as a 409
+ * Conflict response.
+ */
+public class DuplicateOwnerEmailException extends RuntimeException {
+
+    private final String email;
+
+    public DuplicateOwnerEmailException(String email) {
+        super("Email already in use: " + email);
+        this.email = email;
+    }
+
+    /**
+     * @return the normalized (lower-cased) email that collided with an existing owner
+     */
+    public String getEmail() {
+        return this.email;
+    }
+}
