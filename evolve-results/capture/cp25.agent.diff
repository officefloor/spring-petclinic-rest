+package org.springframework.samples.petclinic.rest.validation;
+
+/**
+ * Thrown when an owner is created with a lower-cased e-mail address that is
+ * already used by another owner. Handled by the REST
+ * {@code ExceptionControllerAdvice}, which translates it into a
+ * {@code 409 Conflict} response.
+ */
+public class DuplicateEmailException extends RuntimeException {
+
+    public DuplicateEmailException(String message) {
+        super(message);
+    }
+}
