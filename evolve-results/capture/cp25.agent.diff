+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown when an owner is created with a lower-cased email that is already used by another owner.
+ * Handled as a 409 Conflict by {@link ExceptionControllerAdvice}.
+ */
+public class DuplicateEmailException extends RuntimeException {
+
+    private final transient Object rejectedValue;
+
+    public DuplicateEmailException(Object rejectedValue) {
+        super("is already used by another owner");
+        this.rejectedValue = rejectedValue;
+    }
+
+    public Object getRejectedValue() {
+        return this.rejectedValue;
+    }
+}
