@@ -0,0 +1,20 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown by {@link org.springframework.samples.petclinic.rest.function.owner.CheckOwnerEmailUnique}
+ * when the lower-cased owner email being created already belongs to another owner. Handled by
+ * {@link OwnerEmailDuplicateExceptionHandler}, which responds 409.
+ */
+public class OwnerEmailDuplicateException extends Exception {
+
+    private final String email;
+
+    public OwnerEmailDuplicateException(String email) {
+        super("Email already in use by another owner: " + email);
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerEmailDuplicateExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerEmailDuplicateExceptionHandler.java
new file mode 100644
index 000000000..28ab14627
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/OwnerEmailDuplicateExceptionHandler.java
@@ -0,0 +1,22 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import java.util.List;
+import java.util.Map;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+/**
+ * Responds 409 with a JSON body whose {@code errors} array names {@code email} when the lower-cased
+ * email being created is already used by another owner.
+ */
+public class OwnerEmailDuplicateExceptionHandler {
+
+    public void handle(@Parameter OwnerEmailDuplicateException ex,
+            ObjectResponse<ResponseEntity<Map<String, Object>>> response) {
+        Map<String, Object> body = Map.of("errors", List.of("email"));
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(body));
+    }
+}
