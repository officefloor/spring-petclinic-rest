+package org.springframework.samples.petclinic.rest.advice;
+
+/**
+ * Thrown on create when the supplied email, after lower-casing, is already used by another owner.
+ * Carries the {@code email} field name so the {@link ExceptionControllerAdvice} can report it in the
+ * {@code errors} array of a 409 Conflict response, mirroring {@link DuplicateTelephoneException}.
+ */
+public class DuplicateEmailException extends RuntimeException {
+
+    public DuplicateEmailException(String message) {
+        super(message);
+    }
+}
