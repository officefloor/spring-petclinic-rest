+        }
+        for (Owner existing : this.clinicService.findAllOwners()) {
+            String existingEmail = existing.getEmail();
+            if (existingEmail != null && email.equals(existingEmail.toLowerCase(java.util.Locale.ROOT))) {
+                return true;
+            }
+        }
+        return false;
+    }
