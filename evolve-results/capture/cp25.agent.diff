+package org.springframework.samples.petclinic.rest.advice;
+
+import java.util.List;
+
+/**
+ * Thrown when a request to create an owner carries an email whose lower-cased form is already used by
+ * another owner. Carries the offending (lower-cased) email so the {@link ExceptionControllerAdvice}
+ * can report it back to the client in a {@code 409 Conflict} response.
+ */
+public class DuplicateOwnerEmailException extends DuplicateOwnerException {
+
+    private static final String DETAIL = "An owner with the given email already exists";
+
+    private final String email;
+
+    public DuplicateOwnerEmailException(String email) {
+        super("Email already in use by another owner: " + email, DETAIL, List.of("email"));
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
