+package org.springframework.samples.petclinic.rest.controller;
+
+/**
+ * Raised when creating an owner whose lower-cased email is already used by another
+ * owner. Carries the offending lower-cased email so the exception handler can report
+ * it to the client as a 409 Conflict.
+ */
+public class DuplicateEmailException extends RuntimeException {
+
+    private final String email;
+
+    public DuplicateEmailException(String email) {
+        super("An owner with email '" + email + "' already exists");
+        this.email = email;
+    }
+
+    public String getEmail() {
+        return this.email;
+    }
+}
