@@ -0,0 +1,12 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+/**
+ * Thrown when a create-owner request's lower-cased email is already used by another owner.
+ * Handled by {@link DuplicateOwnerEmailExceptionHandler}, which responds 409 Conflict.
+ */
+public class DuplicateOwnerEmailException extends Exception {
+
+    public DuplicateOwnerEmailException(String email) {
+        super("Email already in use: " + email);
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateOwnerEmailExceptionHandler.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateOwnerEmailExceptionHandler.java
new file mode 100644
index 000000000..3d559ab2b
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/DuplicateOwnerEmailExceptionHandler.java
@@ -0,0 +1,16 @@
+package org.springframework.samples.petclinic.rest.escalation;
+
+import net.officefloor.plugin.section.clazz.Parameter;
+import net.officefloor.web.ObjectResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+
+public class DuplicateOwnerEmailExceptionHandler {
+
+    public void handle(@Parameter DuplicateOwnerEmailException ex,
+            ObjectResponse<ResponseEntity<ProblemDetail>> response) {
+        ProblemDetail detail = ProblemDetails.build(ex, HttpStatus.CONFLICT, ex.getMessage());
+        response.send(ResponseEntity.status(HttpStatus.CONFLICT).body(detail));
+    }
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectDuplicateOwnerEmail.java b/src/main/java/org/springframework/samples/petclinic/rest/function/owner/RejectDuplicateOwnerEmail.java
