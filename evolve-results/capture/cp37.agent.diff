+     */
+    public static String toDisplay(String e164) {
+        if (e164 == null) {
+            return null;
+        }
+        String digits = e164.startsWith("+") ? e164.substring(1) : e164;
+        String countryCode = null;
+        String national = digits;
+        for (String code : NATIONAL_LENGTHS.keySet()) {
