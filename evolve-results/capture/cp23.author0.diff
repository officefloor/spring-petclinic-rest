+     */
+    private int countHouseholdMembers(Owner owner) {
+        String lastName = IdentityNormalizer.normalize(owner.getLastName());
+        String address = AddressNormalizer.canonical(owner.getAddress());
+        long existing = ownerRepository.findAll().stream()
+            .filter(member -> lastName.equals(IdentityNormalizer.normalize(member.getLastName()))
+                && address.equals(AddressNormalizer.canonical(member.getAddress())))
+            .count();
+        return (int) (existing + 1L);
+    }
