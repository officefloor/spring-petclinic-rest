+    static String toE164(String raw) {
+        if (raw == null) {
+            return null;
+        }
+        // Strip spaces, dashes and brackets (leave a leading '+' and the digits).
+        String cleaned = raw.replaceAll("[\\s\\-()]", "").trim();
