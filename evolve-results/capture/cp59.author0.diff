@@ -1,25 +0,0 @@
-package org.springframework.samples.petclinic.rest.escalation;
-
-import java.util.List;
-
-/**
- * Error response body for a rejected owner create: {@code {"errors": ["city", ...]}}.
- *
- * <p>This is a deliberate, spec-mandated divergence from the project's usual
- * {@link org.springframework.http.ProblemDetail} error contract: the create endpoint's
- * specification requires a top-level {@code errors} array naming each missing or blank
- * required field, which {@code ProblemDetail} (and its {@code schemaValidationErrors})
- * does not express.
- */
-public class OwnerFieldErrors {
-
-    private final List<String> errors;
-
-    public OwnerFieldErrors(List<String> errors) {
-        this.errors = errors;
-    }
-
-    public List<String> getErrors() {
-        return this.errors;
-    }
-}
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/escalation/ProblemDetails.java b/src/main/java/org/springframework/samples/petclinic/rest/escalation/ProblemDetails.java
index a66ef0c46..c72fb31f5 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/escalation/ProblemDetails.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/escalation/ProblemDetails.java
@@ -26,4 +26,16 @@ final class ProblemDetails {
         problemDetail.setProperty("schemaValidationErrors", List.<ValidationMessageDto>of());
         return problemDetail;
     }
+
+    /**
+     * Builds a {@link #build(Exception, HttpStatus, String) standard} problem body and adds an
+     * {@code errors} member naming the rejected owner field(s). Used by the create endpoint's
+     * field-level 400 handlers, which previously responded with a bare {@code {"errors": [...]}}
+     * body but must now emit RFC 7807 {@code application/problem+json} like every other rejection.
+     */
+    static ProblemDetail build(Exception ex, HttpStatus status, String detail, List<String> fields) {
+        ProblemDetail problemDetail = build(ex, status, detail);
+        problemDetail.setProperty("errors", List.copyOf(fields));
+        return problemDetail;
+    }
 }
